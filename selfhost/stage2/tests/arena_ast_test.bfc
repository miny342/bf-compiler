cell[] ast_test_source = "cell first(cell x){return second(x+1);}cell second(cell y){if(y>2)return y;else return 2;}void main(){cell value=first(1);while(value!=0){value-=1;}}";

cell name_first_byte(NodeId name) {
    NodeId start = node_a(name);
    return arena_cell_read(start);
}

void test_wide_arithmetic() {
    WideValue left;
    left.low = 0xff;
    left.mid = 1;
    WideValue sum = wide_add(left, wide_from_cell(2));
    expect_test(sum.low == 1 && sum.mid == 2 && sum.high == 0, '>');
    WideValue difference = wide_subtract(sum, left);
    expect_test(difference.low == 2 && difference.mid == 0
        && difference.high == 0, '?');
    WideValue page = wide_multiply_length(wide_from_cell(1), 0, 1);
    WideValue bank = wide_multiply_length(page, 0xff, 0);
    expect_test(page.low == 0 && page.mid == 1 && page.high == 0
        && bank.low == 0 && bank.mid == 0xff && bank.high == 0, '/');
    WideValue largest;
    largest.low = 0xff;
    largest.mid = 0xff;
    largest = wide_multiply_length(largest, 0, 1);
    expect_test(largest.low == 0 && largest.mid == 0xff
        && largest.high == 0xff, '/');
}

void test_compact_node_sizes() {
    expect_test(node_cell_count(NODE_EMPTY_STATEMENT) == 4
        && node_cell_count(NODE_INPUT_EXPRESSION) == 4, '3');
    expect_test(node_cell_count(NODE_BLOCK) == 7
        && node_cell_count(NODE_CALL_STATEMENT) == 7, '4');
    expect_test(node_cell_count(NODE_LITERAL_EXPRESSION) == 5
        && node_cell_count(NODE_LEN_EXPRESSION) == 9, '5');
    expect_test(node_cell_count(NODE_BINARY_EXPRESSION) == 12
        && node_cell_count(NODE_INSTRUCTION) == 18, '6');
    expect_test(node_cell_count(NODE_NAME_EXPRESSION) == 20
        && node_cell_count(NODE_GLOBAL) == 20, '7');
    expect_test(node_cell_count(NODE_FUNCTION) == 18
        && node_cell_count(NODE_CONTINUATION) == 20, '8');

    reset_ast_arena();
    NodeId first = allocate_node(NODE_EMPTY_STATEMENT);
    NodeId second = allocate_node(NODE_LITERAL_EXPRESSION);
    NodeId third = allocate_node(NODE_EMPTY_STATEMENT);
    expect_test(first.bank == 0 && first.page == 0 && first.slot == 55
        && second.bank == 0 && second.page == 0 && second.slot == 59
        && third.bank == 0 && third.page == 0 && third.slot == 64, '9');

    reset_ast_arena();
    NodeId left = allocate_node(NODE_LITERAL_EXPRESSION);
    set_literal_value(left, 1);
    NodeId right = allocate_node(NODE_LITERAL_EXPRESSION);
    set_literal_value(right, 2);
    NodeId folded = make_binary(AST_BINARY_ADD, left, right);
    expect_test(node_kind(folded) == NODE_LITERAL_EXPRESSION
        && literal_value(folded) == 3, ':');
    folded = make_unary(AST_UNARY_NEGATE, folded);
    expect_test(node_kind(folded) == NODE_LITERAL_EXPRESSION
        && literal_value(folded) == 253, ';');

    NodeId dynamic = allocate_node(NODE_NAME_EXPRESSION);
    right = allocate_node(NODE_LITERAL_EXPRESSION);
    set_literal_value(right, 7);
    NodeId binary = make_binary(AST_BINARY_ADD, dynamic, right);
    expect_test(node_equals(node_a(binary), dynamic)
        && binary_has_immediate(binary) && binary_immediate(binary) == 7, '<');
}

void test_arena_page_boundary() {
    reset_ast_arena();
    cell index;
    NodeId node;
    while (index < 0xff) {
        node = allocate_node(NODE_EMPTY_STATEMENT);
        index += 1;
    }
    expect_test(node.page > 0, 'h');
    NodeId field = arena_advance(node, FIELD_NEXT_SLOT);
    expect_test(field.page >= node.page, 'i');

    NodeId boundary;
    boundary.page = ARENA_LAST_PAGE;
    boundary.slot = 0xff;
    NodeId next_bank = arena_advance(boundary, 1);
    arena_cell_write(next_bank, 'B');
    expect_test(next_bank.bank == 1 && next_bank.page == 0
        && next_bank.slot == 0 && arena_cell_read(next_bank) == 'B', '=');
    boundary.slot = 1;
    next_bank = arena_advance(boundary, 0xff);
    expect_test(next_bank.bank == 1 && next_bank.page == 0
        && next_bank.slot == 0, '=');
    boundary.bank = ARENA_LAST_BANK;
    boundary.slot = 0;
    next_bank = arena_advance(boundary, 0xff);
    expect_test(next_bank.bank == ARENA_LAST_BANK
        && next_bank.page == ARENA_LAST_PAGE && next_bank.slot == 0xff, '=');
    expect_test(node_equals(arena_advance(next_bank, 0), next_bank), '=');
}

void test_continuation_dispatch_ids() {
    reset_ast_arena();
    first_continuation = null_node();
    last_continuation = null_node();
    NodeId first = new_continuation();
    NodeId second = new_continuation();
    NodeId first_id = continuation_dispatch_id(first);
    NodeId second_id = continuation_dispatch_id(second);
    NodeId boundary;
    boundary.slot = 0xff;
    boundary = next_continuation_dispatch_id(boundary);
    expect_test(first_id.page == 0 && first_id.slot == 1, '0');
    expect_test(second_id.page == 0 && second_id.slot == 2, '1');
    expect_test(boundary.page == 1 && boundary.slot == 0, '2');
}

void test_ast_parser() {
    reset_test_input(5);
    parse_ast_program();

    NodeId first = first_function;
    NodeId second = node_next(first);
    NodeId main_function = node_next(second);
    expect_test(node_kind(first) == NODE_FUNCTION
        && node_tag(first) == AST_TYPE_CELL, 'j');
    expect_test(name_first_byte(node_name(first)) == 'f', 'k');
    expect_test(node_kind(node_a(first)) == NODE_PARAMETER, 'l');
    expect_test(node_kind(node_b(first)) == NODE_BLOCK, 'm');
    expect_test(name_first_byte(node_name(second)) == 's', 'n');
    expect_test(node_tag(main_function)
        == AST_TYPE_VOID && node_is_null(node_next(main_function)), 'o');

    NodeId first_return = node_a(node_b(first));
    NodeId call = node_a(first_return);
    expect_test(node_kind(first_return) == NODE_RETURN_STATEMENT, 'p');
    expect_test(node_kind(call) == NODE_CALL_EXPRESSION
        && name_first_byte(node_name(call)) == 's', 'q');
    NodeId argument = node_a(call);
    expect_test(node_kind(argument) == NODE_BINARY_EXPRESSION
        && node_tag(argument) == AST_BINARY_ADD
        && binary_has_immediate(argument)
        && binary_immediate(argument) == 1, 'r');

    analyze_ast_program();
    expect_test(node_equals(node_b(call), second), 's');
    expect_test(node_value(node_a(first)) == 1
        && node_is_null(node_next(node_a(first))), 't');
    expect_test(node_value(node_c(first)) == 1
        && node_value(node_c(main_function)) == 1, 'u');

    lower_ast_program();
    NodeId first_entry = node_a(node_c(first));
    expect_test(node_kind(first_entry) == NODE_CONTINUATION
        && node_tag(first_entry) == TERM_CALL, 'v');
    expect_test(node_equals(node_name(first_entry), second), 'w');
    NodeId resume = node_b(first_entry);
    expect_test(node_kind(resume) == NODE_CONTINUATION
        && node_tag(resume) == TERM_RETURN, 'x');
    expect_test(node_tag(node_a(resume)) == IR_COPY_ABI_VALUE, 'y');
    expect_test(node_value(node_c(first)) > 1, 'z');

    reset_capture();
    cell position = 0;
    position = emit_continuation_program(position);
    expect_test(capture_is_brainfuck() && test_capture_overflow, 'A');
}
