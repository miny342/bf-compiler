// productionのmain.bfcと差し替えるtest entry。

void read_character() {
    current_char = 0;
    if (test_input_kind == 1) {
        if (test_input_position < len(lexer_test_source)) {
            current_char = lexer_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 2) {
        if (test_input_position < len(parser_test_source)) {
            current_char = parser_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 3) {
        if (test_input_position < len(lexer_stage3_source)) {
            current_char = lexer_stage3_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 4) {
        if (test_input_position < len(lexer_stage4_source)) {
            current_char = lexer_stage4_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 5) {
        if (test_input_position < len(ast_test_source)) {
            current_char = ast_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 6) {
        if (test_input_position < len(lexer_stage6_source)) {
            current_char = lexer_stage6_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 7) {
        if (test_input_position < len(stage6_array_test_source)) {
            current_char = stage6_array_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 8) {
        if (test_input_position < len(stage7_global_test_source)) {
            current_char = stage7_global_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 9) {
        if (test_input_position < len(stage8_aggregate_test_source)) {
            current_char = stage8_aggregate_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 10) {
        if (test_input_position < len(stage9_type_test_source)) {
            current_char = stage9_type_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 11) {
        if (test_input_position < len(stage10_compile_time_test_source)) {
            current_char = stage10_compile_time_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 12) {
        if (test_input_position < len(stage11_dynamic_projection_test_source)) {
            current_char = stage11_dynamic_projection_test_source[test_input_position];
            test_input_position += 1;
        }
    } else if (test_input_kind == 13) {
        if (test_input_position < len(stage12_macro_test_source)) {
            current_char = stage12_macro_test_source[test_input_position];
            test_input_position += 1;
        }
    }
}

macro compiler_output(value) {
    capture_compiler_output(value);
}

void capture_compiler_output(cell emitted) {
    cell valid = emitted == '>' || emitted == '<'
        || emitted == '+' || emitted == '-'
        || emitted == '.' || emitted == ','
        || emitted == '[' || emitted == ']';
    if (!valid) {
        test_output_valid = 0;
    }
    if (emitted == '[') {
        test_bracket_depth += 1;
    } else if (emitted == ']') {
        if (test_bracket_depth == 0) {
            test_bracket_invalid = 1;
        } else {
            test_bracket_depth -= 1;
        }
    }
    if (test_capture_length < 255) {
        test_capture[test_capture_length] = emitted;
        test_capture_length += 1;
    } else {
        test_capture_overflow = 1;
    }
}

void main() {
    test_common();
    test_lexer();
    test_lexer_stage3();
    test_lexer_stage4();
    test_lexer_stage6();
    test_symbols();
    test_codegen();
    test_parser();
    test_arena_page_boundary();
    test_continuation_dispatch_ids();
    test_ast_parser();
    test_stage6_arrays();
    test_stage7_globals();
    test_stage8_aggregates();
    test_stage9_types();
    test_stage10_compile_time();
    test_stage11_dynamic_projection();
    test_stage12_macros();

    if (test_failures == 0) {
        output('o');
        output('k');
        output('\n');
    } else {
        output('n');
        output('g');
        output('\n');
    }
}
