cell[] lexer_test_source =
    " \t/* skip */ cell name=0x2A; output('\\x21'); // tail\n";
cell[] lexer_stage3_source = "if(!value!=0)while(value){}else";
cell[] lexer_stage4_source = "a==b<=c>=d<e>f&&g||h";
cell[] lexer_stage6_source = "cell[256] first; cell[0x100] second;";

void test_lexer() {
    reset_test_input(1);
    read_character();
    next_token();

    expect_test(token_kind == TokenKind::Identifier && token_is_cell(), 'f');
    next_token();
    expect_test(token_kind == TokenKind::Identifier
        && token_length == 4
        && token_text[0] == 'n' && token_text[3] == 'e', 'g');
    next_token();
    expect_test(token_kind == TokenKind::Assign, 'h');
    next_token();
    expect_test(token_kind == TokenKind::Number && token_value == 0x2A, 'i');
    next_token();
    expect_test(token_kind == TokenKind::Semicolon, 'j');
    next_token();
    expect_test(token_kind == TokenKind::Identifier && token_is_output(), 'k');
    next_token();
    expect_test(token_kind == TokenKind::LeftParen, 'l');
    next_token();
    expect_test(token_kind == TokenKind::Number && token_value == 0x21, 'm');
    next_token();
    expect_test(token_kind == TokenKind::RightParen, 'n');
    next_token();
    expect_test(token_kind == TokenKind::Semicolon, 'o');
    next_token();
    expect_test(token_kind == TokenKind::Eof, 'p');
}

void test_lexer_stage3() {
    reset_test_input(3);
    read_character();
    next_token();
    expect_test(token_kind == TokenKind::Identifier && token_is_if(), '0');
    next_token();
    expect_test(token_kind == TokenKind::LeftParen, '1');
    next_token();
    expect_test(token_kind == TokenKind::Bang, '2');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, '3');
    next_token();
    expect_test(token_kind == TokenKind::BangEqual, '4');
    next_token();
    expect_test(token_kind == TokenKind::Number && token_value == 0, '5');
    next_token();
    expect_test(token_kind == TokenKind::RightParen, '6');
    next_token();
    expect_test(token_kind == TokenKind::Identifier && token_is_while(), '7');
    next_token();
    expect_test(token_kind == TokenKind::LeftParen, '8');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, '9');
    next_token();
    expect_test(token_kind == TokenKind::RightParen, '!');
    next_token();
    expect_test(token_kind == TokenKind::LeftBrace, '@');
    next_token();
    expect_test(token_kind == TokenKind::RightBrace, '#');
    next_token();
    expect_test(token_kind == TokenKind::Identifier && token_is_else(), '$');
    next_token();
    expect_test(token_kind == TokenKind::Eof, '%');
}

void test_lexer_stage4() {
    reset_test_input(4);
    read_character();
    next_token();
    expect_test(token_kind == TokenKind::Identifier, 'Q');
    next_token();
    expect_test(token_kind == TokenKind::EqualEqual, 'R');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, 'S');
    next_token();
    expect_test(token_kind == TokenKind::LessEqual, 'T');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, 'U');
    next_token();
    expect_test(token_kind == TokenKind::GreaterEqual, 'V');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, 'W');
    next_token();
    expect_test(token_kind == TokenKind::Less, 'X');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, 'Y');
    next_token();
    expect_test(token_kind == TokenKind::Greater, 'Z');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, '[');
    next_token();
    expect_test(token_kind == TokenKind::AmpAmp, ']');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, '^');
    next_token();
    expect_test(token_kind == TokenKind::PipePipe, '_');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, '`');
    next_token();
    expect_test(token_kind == TokenKind::Eof, '{');
}

void test_lexer_stage6() {
    reset_test_input(6);
    read_character();
    next_token();
    expect_test(token_kind == TokenKind::Identifier && token_is_cell(), 'a');
    next_token();
    expect_test(token_kind == TokenKind::LeftBracket, 'b');
    next_token();
    expect_test(token_kind == TokenKind::Number
        && token_number_is_256 && token_value == 0, 'c');
    next_token();
    expect_test(token_kind == TokenKind::RightBracket, 'd');
    next_token();
    expect_test(token_kind == TokenKind::Identifier, 'e');
    next_token();
    expect_test(token_kind == TokenKind::Semicolon, 'q');
    next_token();
    expect_test(token_kind == TokenKind::Identifier && token_is_cell(), 'r');
    next_token();
    expect_test(token_kind == TokenKind::LeftBracket, 's');
    next_token();
    expect_test(token_kind == TokenKind::Number
        && token_number_is_256 && token_value == 0, 't');
    next_token();
    expect_test(token_kind == TokenKind::RightBracket, 'u');
}
