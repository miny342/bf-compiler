// BFC内部テスト用の最小harness。失敗時だけcase codeを出力する。

cell test_failures;
cell test_input_kind;
cell test_input_position;
cell[256] test_capture;
cell test_capture_length;
cell test_capture_overflow;
cell test_output_valid;
cell test_bracket_depth;
cell test_bracket_invalid;

void expect_test(cell condition, cell code) {
    if (!condition) {
        output('F');
        output(code);
        output('\n');
        test_failures += 1;
    }
}

void reset_test_input(cell kind) {
    test_input_kind = kind;
    test_input_position = 0;
}

void reset_capture() {
    test_capture_length = 0;
    test_capture_overflow = 0;
    test_output_valid = 1;
    test_bracket_depth = 0;
    test_bracket_invalid = 0;
    target_position = 0;
}

cell capture_is_brainfuck() {
    return test_output_valid
        && !test_bracket_invalid
        && test_bracket_depth == 0;
}
