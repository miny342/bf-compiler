cell[] stage8_aggregate_test_source = "cell[3] saved;cell[3] change(cell[3] value){value[0]+=1;saved=value;return value;}void main(){cell[3] source;cell[3] result=change(source);saved=result;}";

void test_stage8_aggregates() {
    reset_test_input(9);
    parse_ast_program();

    NodeId change = first_function;
    NodeId parameter = node_a(change);
    expect_test(node_tag(change) == AST_TYPE_ARRAY
        && arena_read(change, FIELD_C_PAGE) == 3, 'V');
    expect_test(node_tag(parameter) == AST_DECLARATION_ARRAY
        && node_value(parameter) == 3, 'W');

    analyze_ast_program();
    expect_test(arena_read(node_c(change), FIELD_B_PAGE) == 3
        && arena_read(parameter, FIELD_C_PAGE) == 0
        && node_value(node_c(change)) == 3, 'X');

    NodeId main = node_next(change);
    NodeId source = node_a(node_b(main));
    NodeId result = node_next(source);
    NodeId call = node_a(result);
    expect_test(node_kind(call) == NODE_CALL_EXPRESSION
        && arena_read(call, FIELD_C_PAGE) == 3, 'Y');

    lower_ast_program();
    expect_test(node_tag(node_a(node_c(change))) == TERM_RETURN_ARRAY, 'Z');
    NodeId probe = first_continuation;
    NodeId array_call_argument;
    while (!node_is_null(probe)) {
        if (node_tag(probe) == TERM_CALL && !node_is_null(node_c(probe))) {
            array_call_argument = node_c(probe);
        }
        probe = node_next(probe);
    }
    expect_test(!node_is_null(array_call_argument)
        && node_tag(array_call_argument) == AST_DECLARATION_ARRAY
        && arena_read(array_call_argument, FIELD_A_PAGE) == 3, 'U');
}
