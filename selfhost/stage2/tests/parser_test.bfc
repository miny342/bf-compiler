cell[] parser_test_source = "void main(){cell value=input();if(!value||value>=0x80){output(0x41);}else value+=1;while(value!=0&&value<=0xff){value-=1;}output(value==0);}";

void test_parser() {
    reset_test_input(2);
    reset_capture();
    symbol_count = 0;
    scope_depth = 0;

    cell position = 0;
    position = compile_program_stage4(position);

    expect_test(token_kind == TokenKind::Eof, 'A');
    expect_test(symbol_count == 0 && scope_depth == 0, 'B');
    expect_test(test_capture_length != 0, 'C');
    expect_test(test_capture[0] == '[' && test_capture[1] == '-'
        && test_capture[2] == ']', 'D');
    expect_test(capture_is_brainfuck(), 'E');
    expect_test(test_capture_overflow, 'G');
}
