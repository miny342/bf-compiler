cell[2] shared;

cell[2] choose(cell[2] first, cell[2] second) {
    second[0] = 7;
    return first;
}

cell[2] replace_shared() {
    shared[0] = 9;
    return shared;
}

void main() {
    shared[0] = 1;
    cell[2] snapshot = choose(shared, replace_shared());
    output(snapshot[0]);
    output(shared[0]);
}
