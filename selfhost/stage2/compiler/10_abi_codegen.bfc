// Uniform scalar frameを使う第5段階Continuation ABI backend。
// 全functionを同じframe幅にすることで、直接・相互再帰を同じcall/return
// sequenceで扱う。PCとreturn PCはNodeIdのpage/slotをそのまま使う。

const cell FRAME_ACTIVE = 0;
const cell FRAME_PC_LOW = 1;
const cell FRAME_PC_HIGH = 2;
const cell FRAME_NEXT_PC_LOW = 3;
const cell FRAME_NEXT_PC_HIGH = 4;
const cell FRAME_RETURN_PC_LOW = 5;
const cell FRAME_RETURN_PC_HIGH = 6;
const cell FRAME_VALUE = 7;
const cell FRAME_CONDITION = 8;
const cell FRAME_RESTORE = 9;
const cell FRAME_BRANCH = 10;
const cell FRAME_SCRATCH_0 = 11;
const cell FRAME_SCRATCH_1 = 12;
const cell FRAME_SCRATCH_2 = 13;
const cell FRAME_SCRATCH_3 = 14;
const cell FRAME_DATA_BASE = 16;

cell stage5_frame_cells;

cell physical_frame_slot(cell slot) {
    return FRAME_DATA_BASE + slot;
}

void emit_repeat_character(cell character, cell count) {
    while (count != 0) {
        compiler_output!(character);
        count -= 1;
    }
}

void emit_add_constant(cell destination, cell value) {
    emit_move_to(destination);
    if (value <= 128) {
        emit_repeat_character('+', value);
    } else {
        while (value != 0) {
            compiler_output!('-');
            value += 1;
        }
    }
}

void emit_frame_copy(cell source, cell destination) {
    emit_clear(destination);
    emit_clear(FRAME_RESTORE);
    emit_move_to(source);
    compiler_output!('[');
    compiler_output!('-');
    emit_move_to(destination);
    compiler_output!('+');
    emit_move_to(FRAME_RESTORE);
    compiler_output!('+');
    emit_move_to(source);
    compiler_output!(']');
    emit_transfer(FRAME_RESTORE, source, 0);
}

void emit_frame_booleanize(cell destination) {
    emit_clear(FRAME_SCRATCH_0);
    emit_loop_open(destination);
    emit_clear(destination);
    emit_move_to(FRAME_SCRATCH_0);
    compiler_output!('+');
    emit_loop_close(destination);
    emit_transfer(FRAME_SCRATCH_0, destination, 0);
}

void emit_frame_not(cell destination) {
    emit_constant(FRAME_SCRATCH_0, 1);
    emit_loop_open(destination);
    emit_clear(destination);
    emit_clear(FRAME_SCRATCH_0);
    emit_loop_close(destination);
    emit_transfer(FRAME_SCRATCH_0, destination, 0);
}

void emit_frame_negate(cell destination) {
    emit_clear(FRAME_SCRATCH_0);
    emit_transfer(destination, FRAME_SCRATCH_0, 1);
    emit_transfer(FRAME_SCRATCH_0, destination, 0);
}

void emit_frame_swap(cell left, cell right) {
    emit_clear(FRAME_SCRATCH_3);
    emit_transfer(left, FRAME_SCRATCH_3, 0);
    emit_transfer(right, left, 0);
    emit_transfer(FRAME_SCRATCH_3, right, 0);
}

void emit_frame_less(cell left, cell right) {
    emit_clear(FRAME_SCRATCH_1);
    emit_loop_open(right);
    emit_move_to(right);
    compiler_output!('-');
    emit_frame_copy(left, FRAME_CONDITION);
    emit_frame_booleanize(FRAME_CONDITION);
    emit_constant(FRAME_SCRATCH_0, 1);

    emit_loop_open(FRAME_CONDITION);
    emit_clear(FRAME_CONDITION);
    emit_clear(FRAME_SCRATCH_0);
    emit_move_to(left);
    compiler_output!('-');
    emit_loop_close(FRAME_CONDITION);

    emit_loop_open(FRAME_SCRATCH_0);
    emit_clear(FRAME_SCRATCH_0);
    emit_constant(FRAME_SCRATCH_1, 1);
    emit_clear(right);
    emit_loop_close(FRAME_SCRATCH_0);
    emit_loop_close(right);

    emit_clear(left);
    emit_transfer(FRAME_SCRATCH_1, left, 0);
}

void emit_next_context(cell frame_cells) {
    emit_move_to(0);
    emit_repeat_character('>', frame_cells);
    target_position = 0;
}

void emit_previous_context(cell frame_cells) {
    emit_move_to(0);
    emit_repeat_character('<', frame_cells);
    target_position = 0;
}

void emit_copy_to_next_context(
    cell source,
    cell destination,
    cell frame_cells
) {
    emit_clear(FRAME_RESTORE);
    emit_move_to(source);
    compiler_output!('[');
    compiler_output!('-');
    emit_move_to(0);
    emit_repeat_character('>', frame_cells);
    target_position = 0;
    emit_move_to(destination);
    compiler_output!('+');
    emit_move_to(0);
    emit_repeat_character('<', frame_cells);
    target_position = 0;
    emit_move_to(FRAME_RESTORE);
    compiler_output!('+');
    emit_move_to(source);
    compiler_output!(']');
    emit_transfer(FRAME_RESTORE, source, 0);
    emit_move_to(0);
}

void emit_transfer_to_previous_context(
    cell source,
    cell destination,
    cell frame_cells
) {
    emit_move_to(source);
    compiler_output!('[');
    compiler_output!('-');
    emit_move_to(0);
    emit_repeat_character('<', frame_cells);
    target_position = 0;
    emit_move_to(destination);
    compiler_output!('+');
    emit_move_to(0);
    emit_repeat_character('>', frame_cells);
    target_position = 0;
    emit_move_to(source);
    compiler_output!(']');
    emit_move_to(0);
}

void emit_clear_previous_context(cell destination, cell frame_cells) {
    emit_previous_context(frame_cells);
    emit_clear(destination);
    emit_next_context(frame_cells);
}

void emit_ir_instruction(NodeId instruction) {
    cell kind = node_tag(instruction);
    cell destination = physical_frame_slot(node_value(instruction));
    cell source = physical_frame_slot(instruction_source(instruction));
    if (kind == IR_SET) {
        emit_constant(destination, instruction_source(instruction));
    } else if (kind == IR_COPY) {
        emit_frame_copy(source, destination);
    } else if (kind == IR_COPY_ABI_VALUE) {
        emit_frame_copy(FRAME_VALUE, destination);
    } else if (kind == IR_INPUT) {
        emit_input(destination);
    } else if (kind == IR_OUTPUT) {
        emit_move_to(source);
        compiler_output!('.');
    } else if (kind == IR_ADD) {
        emit_transfer(source, destination, 0);
    } else if (kind == IR_SUBTRACT) {
        emit_transfer(source, destination, 1);
    } else if (kind == IR_NEGATE) {
        emit_frame_negate(destination);
    } else if (kind == IR_NOT) {
        emit_frame_not(destination);
    } else if (kind == IR_BOOLEANIZE) {
        emit_frame_booleanize(destination);
    } else if (kind == IR_EQUAL || kind == IR_NOT_EQUAL) {
        emit_transfer(source, destination, 1);
        if (kind == IR_EQUAL) {
            emit_frame_not(destination);
        } else {
            emit_frame_booleanize(destination);
        }
    } else if (kind == IR_LESS || kind == IR_GREATER_EQUAL) {
        emit_frame_less(destination, source);
        if (kind == IR_GREATER_EQUAL) {
            emit_frame_not(destination);
        }
    } else if (kind == IR_GREATER || kind == IR_LESS_EQUAL) {
        emit_frame_swap(destination, source);
        emit_frame_less(destination, source);
        if (kind == IR_LESS_EQUAL) {
            emit_frame_not(destination);
        }
    } else {
        fail();
    }
    emit_move_to(0);
}

void emit_call_terminator(NodeId continuation) {
    NodeId callee = node_name(continuation);
    NodeId resume = node_b(continuation);
    NodeId entry = node_a(node_c(callee));
    NodeId entry_id = continuation_dispatch_id(entry);
    NodeId resume_id = continuation_dispatch_id(resume);

    cell frame_cells = stage5_frame_cells;
    emit_next_context(frame_cells);
    cell position;
    while (position < frame_cells) {
        emit_clear(position);
        position += 1;
    }
    emit_constant(FRAME_ACTIVE, 1);
    emit_constant(FRAME_NEXT_PC_LOW, entry_id.slot);
    emit_constant(FRAME_NEXT_PC_HIGH, entry_id.page);
    emit_constant(FRAME_RETURN_PC_LOW, resume_id.slot);
    emit_constant(FRAME_RETURN_PC_HIGH, resume_id.page);
    emit_previous_context(frame_cells);

    NodeId argument = node_c(continuation);
    while (!node_is_null(argument)) {
        emit_copy_to_next_context(
            physical_frame_slot(node_value(argument)),
            physical_frame_slot(node_tag(argument)),
            frame_cells
        );
        argument = node_next(argument);
    }
    emit_next_context(frame_cells);
}

void emit_return_terminator(NodeId continuation) {
    cell frame_cells = stage5_frame_cells;
    cell slot = node_value(continuation);
    if (slot == VOID_RETURN_SLOT) {
        emit_clear_previous_context(FRAME_VALUE, frame_cells);
    } else {
        emit_frame_copy(physical_frame_slot(slot), FRAME_VALUE);
        emit_clear_previous_context(FRAME_VALUE, frame_cells);
        emit_transfer_to_previous_context(
            FRAME_VALUE,
            FRAME_VALUE,
            frame_cells
        );
    }
    emit_transfer_to_previous_context(
        FRAME_RETURN_PC_LOW,
        FRAME_NEXT_PC_LOW,
        frame_cells
    );
    emit_transfer_to_previous_context(
        FRAME_RETURN_PC_HIGH,
        FRAME_NEXT_PC_HIGH,
        frame_cells
    );

    cell position;
    while (position < frame_cells) {
        emit_clear(position);
        position += 1;
    }
    emit_previous_context(frame_cells);
}

void emit_continuation_terminator(NodeId continuation) {
    cell kind = node_tag(continuation);
    if (kind == TERM_GOTO) {
        NodeId target = node_name(continuation);
        NodeId target_id = continuation_dispatch_id(target);
        emit_constant(FRAME_NEXT_PC_LOW, target_id.slot);
        emit_constant(FRAME_NEXT_PC_HIGH, target_id.page);
    } else if (kind == TERM_BRANCH) {
        NodeId then_target = node_name(continuation);
        NodeId else_target = node_b(continuation);
        NodeId then_id = continuation_dispatch_id(then_target);
        NodeId else_id = continuation_dispatch_id(else_target);
        emit_constant(FRAME_NEXT_PC_LOW, else_id.slot);
        emit_constant(FRAME_NEXT_PC_HIGH, else_id.page);
        cell condition = physical_frame_slot(node_value(continuation));
        emit_loop_open(condition);
        emit_clear(condition);
        emit_constant(FRAME_NEXT_PC_LOW, then_id.slot);
        emit_constant(FRAME_NEXT_PC_HIGH, then_id.page);
        emit_loop_close(condition);
    } else if (kind == TERM_CALL) {
        emit_call_terminator(continuation);
    } else if (kind == TERM_RETURN) {
        emit_return_terminator(continuation);
    } else if (kind == TERM_HALT) {
        emit_clear(FRAME_ACTIVE);
    } else {
        fail();
    }
}

void emit_dispatch_body(NodeId continuation) {
    NodeId instruction = node_a(continuation);
    while (!node_is_null(instruction)) {
        emit_ir_instruction(instruction);
        instruction = node_next(instruction);
    }
    emit_continuation_terminator(continuation);
}

// PcLowを最小IDで正規化し、入れ子loopを一段進むたびに破壊的に
// decrementする。Branchは一致したcaseだけが一度消費する。
void emit_countdown_case(NodeId continuation) {
    emit_loop_open(FRAME_BRANCH);
    emit_move_to(FRAME_BRANCH);
    compiler_output!('-');
    emit_move_to(0);
    emit_dispatch_body(continuation);
    emit_loop_close(FRAME_BRANCH);
    emit_move_to(0);
}

void emit_low_countdown_level(NodeId continuation, cell remaining) {
    emit_loop_open(FRAME_PC_LOW);
    if (remaining == 0) {
        emit_clear(FRAME_PC_LOW);
        emit_clear(FRAME_BRANCH);
    } else {
        emit_move_to(FRAME_PC_LOW);
        compiler_output!('-');
        emit_move_to(0);
        NodeId next = node_next(continuation);
        emit_low_countdown_level(next, remaining - 1);
    }
    emit_loop_close(FRAME_PC_LOW);
    emit_move_to(0);
    emit_countdown_case(continuation);
}

void emit_dispatch_page(NodeId first, NodeId after) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId last = first;
    NodeId probe = node_next(first);
    while (!node_equals(probe, after)) {
        last = probe;
        probe = node_next(probe);
    }
    NodeId last_id = continuation_dispatch_id(last);
    emit_add_constant(FRAME_PC_LOW, 0 - first_id.slot);
    emit_constant(FRAME_BRANCH, 1);
    emit_low_countdown_level(first, last_id.slot - first_id.slot);
}

NodeId next_dispatch_page(NodeId first) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId result = node_next(first);
    while (!node_is_null(result)) {
        NodeId result_id = continuation_dispatch_id(result);
        if (result_id.page != first_id.page) {
            return result;
        }
        result = node_next(result);
    }
    return result;
}

void emit_page_countdown_case(NodeId first, NodeId after) {
    emit_loop_open(FRAME_BRANCH);
    emit_move_to(FRAME_BRANCH);
    compiler_output!('-');
    emit_move_to(0);
    emit_dispatch_page(first, after);
    emit_loop_close(FRAME_BRANCH);
    emit_move_to(0);
}

void emit_page_countdown_level(NodeId first, cell remaining) {
    NodeId after = next_dispatch_page(first);
    emit_loop_open(FRAME_PC_HIGH);
    if (remaining == 0) {
        emit_clear(FRAME_PC_HIGH);
        emit_clear(FRAME_BRANCH);
    } else {
        emit_move_to(FRAME_PC_HIGH);
        compiler_output!('-');
        emit_move_to(0);
        emit_page_countdown_level(after, remaining - 1);
    }
    emit_loop_close(FRAME_PC_HIGH);
    emit_move_to(0);
    emit_page_countdown_case(first, after);
}

// continuationのdispatch IDは1から密に割り当てるため、low byteと
// high byteの両方を比較scanなしのcountdownにできる。
void emit_dispatch_countdown(NodeId first, NodeId last) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId last_id = continuation_dispatch_id(last);
    emit_add_constant(FRAME_PC_HIGH, 0 - first_id.page);
    emit_constant(FRAME_BRANCH, 1);
    emit_page_countdown_level(first, last_id.page - first_id.page);
}

void calculate_stage5_frame_size() {
    cell maximum;
    NodeId function = first_function;
    while (!node_is_null(function)) {
        cell slots = node_value(node_c(function));
        if (slots > maximum) {
            maximum = slots;
        }
        function = node_next(function);
    }
    if (maximum > 0xef) {
        fail();
    }
    stage5_frame_cells = FRAME_DATA_BASE + maximum;
}

void emit_continuation_program() {
    calculate_stage5_frame_size();
    target_position = 0;
    NodeId main_entry = node_a(node_c(main_function));
    NodeId main_entry_id = continuation_dispatch_id(main_entry);
    emit_constant(FRAME_ACTIVE, 1);
    emit_constant(FRAME_PC_LOW, main_entry_id.slot);
    emit_constant(FRAME_PC_HIGH, main_entry_id.page);
    emit_move_to(FRAME_ACTIVE);
    compiler_output!('[');

    NodeId first = first_continuation;
    NodeId last = last_continuation;
    emit_dispatch_countdown(first, last);
    emit_transfer(FRAME_NEXT_PC_LOW, FRAME_PC_LOW, 0);
    emit_transfer(FRAME_NEXT_PC_HIGH, FRAME_PC_HIGH, 0);
    emit_move_to(FRAME_ACTIVE);
    compiler_output!(']');
}

void compile_program_stage5() {
    parse_ast_program();
    analyze_ast_program();
    lower_ast_program();
    emit_continuation_program();
}
