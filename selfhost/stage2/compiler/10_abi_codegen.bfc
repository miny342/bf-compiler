// 16-bit logical offset portalとaggregate outboxを持つ第12段階Continuation ABI backend。
// 全functionを同じframe幅にすることで、直接・相互再帰を同じcall/return
// sequenceで扱う。PCとreturn PCはarena handleとは別の16-bit dispatch ID。
// Rustの16-cell chunk ABIとは別方式で、16-cell headerに可変長dataを続ける。

const cell FRAME_ACTIVE = 0;
const cell FRAME_PC_LOW = 1;
const cell FRAME_PC_HIGH = 2;
const cell FRAME_NEXT_PC_LOW = 3;
const cell FRAME_NEXT_PC_HIGH = 4;
const cell FRAME_RETURN_PC_LOW = 5;
const cell FRAME_RETURN_PC_HIGH = 6;
const cell FRAME_VALUE = 7;
const cell FRAME_CONDITION = 8;
const cell FRAME_RESTORE = 9;
const cell FRAME_BRANCH = 10;
const cell FRAME_SCRATCH_0 = 11;
const cell FRAME_SCRATCH_1 = 12;
const cell FRAME_SCRATCH_2 = 13;
const cell FRAME_SCRATCH_3 = 14;
const cell FRAME_DATA_BASE = 16;

cell stage8_frame_cells;
cell stage8_outbox_base;
cell stage8_outbox_cells;

cell physical_frame_slot(cell slot) {
    return FRAME_DATA_BASE + slot;
}

void emit_add_constant(cell destination, cell value) {
    emit_move_to(destination);
    emit_repeat_character('+', value);
}

void emit_frame_copy(cell source, cell destination) {
    emit_clear(destination);
    emit_clear(FRAME_RESTORE);
    emit_move_to(source);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_move_to(destination);
    emit_bf_character('+');
    emit_move_to(FRAME_RESTORE);
    emit_bf_character('+');
    emit_move_to(source);
    emit_bf_character(']');
    emit_transfer(FRAME_RESTORE, source, 0);
}

void emit_logical_offset_increment(cell low, cell high) {
    emit_add_constant(low, 1);
    emit_constant(FRAME_BRANCH, 1);
    emit_frame_copy(low, FRAME_SCRATCH_1);
    emit_loop_open(FRAME_SCRATCH_1);
    emit_clear(FRAME_SCRATCH_1);
    emit_clear(FRAME_BRANCH);
    emit_loop_close(FRAME_SCRATCH_1);
    emit_loop_open(FRAME_BRANCH);
    emit_clear(FRAME_BRANCH);
    emit_add_constant(high, 1);
    emit_loop_close(FRAME_BRANCH);
}

void emit_logical_offset_steps(
    cell low,
    cell high,
    cell amount_low,
    cell amount_high
) {
    // Adding 256 to a 16-bit offset changes only its high byte.
    emit_add_constant(high, amount_high);
    while (amount_low != 0) {
        emit_logical_offset_increment(low, high);
        amount_low -= 1;
    }
}

void emit_offset_instruction(NodeId instruction) {
    cell low = physical_frame_slot(node_value(instruction));
    cell high = physical_frame_slot(
        arena_read(instruction, FIELD_NAME_PAGE)
    );
    cell amount_low = arena_read(instruction, FIELD_A_SLOT);
    cell amount_high = arena_read(instruction, FIELD_A_BANK);
    if (node_tag(instruction) == IR_OFFSET_ADD_CONSTANT) {
        emit_logical_offset_steps(low, high, amount_low, amount_high);
        return;
    }
    cell source = physical_frame_slot(
        arena_read(instruction, FIELD_A_PAGE)
    );
    emit_loop_open(source);
    emit_move_to(source);
    emit_bf_character('-');
    emit_logical_offset_steps(low, high, amount_low, amount_high);
    emit_loop_close(source);
}

void emit_frame_booleanize(cell destination) {
    emit_clear(FRAME_SCRATCH_0);
    emit_loop_open(destination);
    emit_clear(destination);
    emit_move_to(FRAME_SCRATCH_0);
    emit_bf_character('+');
    emit_loop_close(destination);
    emit_transfer(FRAME_SCRATCH_0, destination, 0);
}

void emit_frame_not(cell destination) {
    emit_constant(FRAME_SCRATCH_0, 1);
    emit_loop_open(destination);
    emit_clear(destination);
    emit_clear(FRAME_SCRATCH_0);
    emit_loop_close(destination);
    emit_transfer(FRAME_SCRATCH_0, destination, 0);
}

void emit_frame_negate(cell destination) {
    emit_clear(FRAME_SCRATCH_0);
    emit_transfer(destination, FRAME_SCRATCH_0, 1);
    emit_transfer(FRAME_SCRATCH_0, destination, 0);
}

void emit_frame_swap(cell left, cell right) {
    emit_clear(FRAME_SCRATCH_3);
    emit_transfer(left, FRAME_SCRATCH_3, 0);
    emit_transfer(right, left, 0);
    emit_transfer(FRAME_SCRATCH_3, right, 0);
}

void emit_frame_less(cell left, cell right) {
    emit_clear(FRAME_SCRATCH_1);
    emit_loop_open(right);
    emit_move_to(right);
    emit_bf_character('-');
    emit_frame_copy(left, FRAME_CONDITION);
    emit_frame_booleanize(FRAME_CONDITION);
    emit_constant(FRAME_SCRATCH_0, 1);

    emit_loop_open(FRAME_CONDITION);
    emit_clear(FRAME_CONDITION);
    emit_clear(FRAME_SCRATCH_0);
    emit_move_to(left);
    emit_bf_character('-');
    emit_loop_close(FRAME_CONDITION);

    emit_loop_open(FRAME_SCRATCH_0);
    emit_clear(FRAME_SCRATCH_0);
    emit_constant(FRAME_SCRATCH_1, 1);
    emit_clear(right);
    emit_loop_close(FRAME_SCRATCH_0);
    emit_loop_close(right);

    emit_clear(left);
    emit_transfer(FRAME_SCRATCH_1, left, 0);
}

void emit_next_context(cell frame_cells) {
    emit_move_to(0);
    emit_repeat_character('>', frame_cells);
    target_position = 0;
}

void emit_previous_context(cell frame_cells) {
    emit_move_to(0);
    emit_repeat_character('<', frame_cells);
    target_position = 0;
}

// Every allocated activation keeps FRAME_ACTIVE=1.  One zero anchor sits one
// frame stride to the left of the root, so a scan reaches static storage from
// any recursion depth without materializing a pointer in a language cell.
void emit_current_to_anchor(cell frame_cells) {
    emit_move_to(FRAME_ACTIVE);
    emit_bf_character('[');
    emit_repeat_character('<', frame_cells);
    emit_bf_character(']');
    target_position = 0;
}

void emit_anchor_to_current(cell frame_cells) {
    emit_repeat_character('>', frame_cells);
    emit_bf_character('[');
    emit_repeat_character('>', frame_cells);
    emit_bf_character(']');
    emit_repeat_character('<', frame_cells);
    target_position = 0;
}

void emit_anchor_to_global(WideValue global) {
    emit_repeat_wide('<', wide_subtract(stage7_static_cells, global));
    target_position = 0;
}

void emit_global_to_anchor(WideValue global) {
    emit_repeat_wide('>', wide_subtract(stage7_static_cells, global));
    target_position = 0;
}

void emit_current_to_global(WideValue global, cell frame_cells) {
    emit_current_to_anchor(frame_cells);
    emit_anchor_to_global(global);
}

void emit_global_to_current(WideValue global, cell frame_cells) {
    emit_global_to_anchor(global);
    emit_anchor_to_current(frame_cells);
}

void emit_global_constant(WideValue global, cell value, cell frame_cells) {
    emit_current_to_global(global, frame_cells);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_bf_character(']');
    if (value <= 128) {
        emit_repeat_character('+', value);
    } else {
        while (value != 0) {
            emit_bf_character('-');
            value += 1;
        }
    }
    emit_global_to_current(global, frame_cells);
}

void emit_global_copy(WideValue global, cell destination, cell frame_cells) {
    emit_clear(destination);
    emit_clear(FRAME_RESTORE);
    emit_current_to_global(global, frame_cells);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_global_to_current(global, frame_cells);
    emit_move_to(destination);
    emit_bf_character('+');
    emit_move_to(FRAME_RESTORE);
    emit_bf_character('+');
    emit_move_to(0);
    emit_current_to_global(global, frame_cells);
    emit_bf_character(']');
    emit_global_to_current(global, frame_cells);

    emit_move_to(FRAME_RESTORE);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_move_to(0);
    emit_current_to_global(global, frame_cells);
    emit_bf_character('+');
    emit_global_to_current(global, frame_cells);
    emit_move_to(FRAME_RESTORE);
    emit_bf_character(']');
    emit_move_to(0);
}

void emit_transfer_to_global(
    cell source,
    WideValue global,
    cell subtract,
    cell clear_first,
    cell frame_cells
) {
    if (clear_first) {
        emit_global_constant(global, 0, frame_cells);
    }
    emit_move_to(source);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_move_to(0);
    emit_current_to_global(global, frame_cells);
    if (subtract) {
        emit_bf_character('-');
    } else {
        emit_bf_character('+');
    }
    emit_global_to_current(global, frame_cells);
    emit_move_to(source);
    emit_bf_character(']');
    emit_move_to(0);
}

void emit_copy_to_next_context(
    cell source,
    cell destination,
    cell frame_cells
) {
    emit_clear(FRAME_RESTORE);
    emit_move_to(source);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_move_to(0);
    emit_repeat_character('>', frame_cells);
    target_position = 0;
    emit_move_to(destination);
    emit_bf_character('+');
    emit_move_to(0);
    emit_repeat_character('<', frame_cells);
    target_position = 0;
    emit_move_to(FRAME_RESTORE);
    emit_bf_character('+');
    emit_move_to(source);
    emit_bf_character(']');
    emit_transfer(FRAME_RESTORE, source, 0);
    emit_move_to(0);
}

void emit_transfer_to_previous_context(
    cell source,
    cell destination,
    cell frame_cells
) {
    emit_move_to(source);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_move_to(0);
    emit_repeat_character('<', frame_cells);
    target_position = 0;
    emit_move_to(destination);
    emit_bf_character('+');
    emit_move_to(0);
    emit_repeat_character('>', frame_cells);
    target_position = 0;
    emit_move_to(source);
    emit_bf_character(']');
    emit_move_to(0);
}

void emit_clear_previous_context(cell destination, cell frame_cells) {
    emit_previous_context(frame_cells);
    emit_clear(destination);
    emit_next_context(frame_cells);
}

void emit_array_case_operation(
    cell kind,
    cell data,
    WideValue base,
    WideValue element,
    cell storage,
    cell frame_cells
) {
    cell data_slot = physical_frame_slot(data);
    if (storage == RESOLVED_GLOBAL_DYNAMIC) {
        WideValue global = wide_add(base, element);
        if (kind == IR_ARRAY_LOAD) {
            emit_global_copy(global, data_slot, frame_cells);
        } else if (kind == IR_ARRAY_STORE) {
            emit_transfer_to_global(data_slot, global, 0, 1, frame_cells);
        } else if (kind == IR_ARRAY_ADD) {
            emit_transfer_to_global(data_slot, global, 0, 0, frame_cells);
        } else if (kind == IR_ARRAY_SUBTRACT) {
            emit_transfer_to_global(data_slot, global, 1, 0, frame_cells);
        } else {
            fail('H', 'N');
        }
        return;
    }

    if (base.mid != 0 || base.high != 0
        || element.mid != 0 || element.high != 0) {
        fail('H', 'O');
    }
    cell array_slot = physical_frame_slot(base.low + element.low);
    if (kind == IR_ARRAY_LOAD) {
        emit_frame_copy(array_slot, data_slot);
    } else if (kind == IR_ARRAY_STORE) {
        emit_clear(array_slot);
        emit_transfer(data_slot, array_slot, 0);
    } else if (kind == IR_ARRAY_ADD) {
        emit_transfer(data_slot, array_slot, 0);
    } else if (kind == IR_ARRAY_SUBTRACT) {
        emit_transfer(data_slot, array_slot, 1);
    } else {
        fail('H', 'P');
    }
}

void emit_array_countdown_case(
    cell kind,
    cell data,
    WideValue base,
    WideValue element,
    cell storage,
    cell branch,
    cell frame_cells
) {
    emit_loop_open(branch);
    emit_move_to(branch);
    emit_bf_character('-');
    emit_move_to(0);
    emit_array_case_operation(kind, data, base, element, storage, frame_cells);
    emit_loop_close(branch);
    emit_move_to(0);
}

void emit_array_countdown_level(
    cell kind,
    cell data,
    cell index,
    WideValue base,
    WideValue element,
    cell storage,
    cell remaining,
    cell branch,
    cell frame_cells
) {
    cell index_slot = physical_frame_slot(index);
    emit_loop_open(index_slot);
    if (remaining == 0) {
        emit_clear(index_slot);
        emit_clear(branch);
    } else {
        emit_move_to(index_slot);
        emit_bf_character('-');
        emit_move_to(0);
        emit_array_countdown_level(
            kind,
            data,
            index,
            base,
            wide_add(element, wide_from_cell(1)),
            storage,
            remaining - 1,
            branch,
            frame_cells
        );
    }
    emit_loop_close(index_slot);
    emit_move_to(0);
    emit_array_countdown_case(
        kind,
        data,
        base,
        element,
        storage,
        branch,
        frame_cells
    );
}

void emit_array_page_countdown_case(
    cell kind,
    cell data,
    cell index,
    WideValue base,
    cell page,
    cell full_pages,
    cell tail,
    cell storage,
    cell frame_cells
) {
    emit_loop_open(FRAME_SCRATCH_3);
    emit_move_to(FRAME_SCRATCH_3);
    emit_bf_character('-');
    emit_move_to(0);
    WideValue page_offset;
    page_offset.mid = page;
    cell remaining = 0xff;
    if (page == full_pages) {
        remaining = tail - 1;
    }
    emit_constant(FRAME_BRANCH, 1);
    emit_array_countdown_level(
        kind,
        data,
        index,
        wide_add(base, page_offset),
        wide_from_cell(0),
        storage,
        remaining,
        FRAME_BRANCH,
        frame_cells
    );
    emit_loop_close(FRAME_SCRATCH_3);
    emit_move_to(0);
}

void emit_array_page_countdown_level(
    cell kind,
    cell data,
    cell index_low,
    cell index_high,
    WideValue base,
    cell page,
    cell full_pages,
    cell tail,
    cell storage,
    cell remaining,
    cell frame_cells
) {
    cell high_slot = physical_frame_slot(index_high);
    emit_loop_open(high_slot);
    if (remaining == 0) {
        emit_clear(high_slot);
        emit_clear(FRAME_SCRATCH_3);
    } else {
        emit_move_to(high_slot);
        emit_bf_character('-');
        emit_move_to(0);
        emit_array_page_countdown_level(
            kind,
            data,
            index_low,
            index_high,
            base,
            page + 1,
            full_pages,
            tail,
            storage,
            remaining - 1,
            frame_cells
        );
    }
    emit_loop_close(high_slot);
    emit_move_to(0);
    emit_array_page_countdown_case(
        kind,
        data,
        index_low,
        base,
        page,
        full_pages,
        tail,
        storage,
        frame_cells
    );
}

void emit_array_instruction(NodeId instruction) {
    cell kind = node_tag(instruction);
    cell data = node_value(instruction);
    cell index = arena_read(instruction, FIELD_NAME_PAGE);
    cell offset_high = arena_read(instruction, FIELD_NAME_SLOT);
    WideValue base = instruction_address(instruction);
    WideValue length;
    length.low = arena_read(instruction, FIELD_C_PAGE);
    length.mid = arena_read(instruction, FIELD_C_SLOT);
    length.high = arena_read(instruction, FIELD_C_BANK);
    cell storage = arena_read(instruction, FIELD_B_PAGE);
    if (wide_is_zero(length) || length.high != 0) {
        fail('H', 'Q');
    }
    if (kind == IR_ARRAY_LOAD) {
        emit_clear(physical_frame_slot(data));
    }
    if (length.mid == 0) {
        // A one-page region only accepts a zero high byte.
        emit_constant(FRAME_SCRATCH_2, 1);
        cell high_slot = physical_frame_slot(offset_high);
        emit_loop_open(high_slot);
        emit_clear(high_slot);
        emit_clear(FRAME_SCRATCH_2);
        emit_loop_close(high_slot);
        emit_loop_open(FRAME_SCRATCH_2);
        emit_clear(FRAME_SCRATCH_2);
        emit_constant(FRAME_BRANCH, 1);
        emit_array_countdown_level(
            kind,
            data,
            index,
            base,
            wide_from_cell(0),
            storage,
            length.low - 1,
            FRAME_BRANCH,
            stage8_frame_cells
        );
        emit_loop_close(FRAME_SCRATCH_2);
        return;
    }

    cell pages = length.mid;
    if (length.low != 0) {
        pages += 1;
    }
    emit_constant(FRAME_SCRATCH_3, 1);
    emit_array_page_countdown_level(
        kind,
        data,
        index,
        offset_high,
        base,
        0,
        length.mid,
        length.low,
        storage,
        pages - 1,
        stage8_frame_cells
    );
}

void emit_ir_instruction(NodeId instruction) {
    cell kind = node_tag(instruction);
    cell destination = physical_frame_slot(node_value(instruction));
    cell source = physical_frame_slot(instruction_source(instruction));
    if (kind == IR_SET) {
        emit_constant(destination, instruction_source(instruction));
    } else if (kind == IR_COPY) {
        emit_frame_copy(source, destination);
    } else if (kind == IR_COPY_ABI_VALUE) {
        emit_frame_copy(FRAME_VALUE, destination);
    } else if (kind == IR_COPY_OUTBOX) {
        emit_frame_copy(
            physical_frame_slot(
                stage8_outbox_base + instruction_source(instruction)
            ),
            destination
        );
    } else if (kind == IR_INPUT) {
        emit_input(destination);
    } else if (kind == IR_OUTPUT) {
        emit_move_to(source);
        emit_bf_character('.');
    } else if (kind == IR_ADD) {
        emit_transfer(source, destination, 0);
    } else if (kind == IR_SUBTRACT) {
        emit_transfer(source, destination, 1);
    } else if (kind == IR_NEGATE) {
        emit_frame_negate(destination);
    } else if (kind == IR_SET_GLOBAL) {
        emit_global_constant(
            instruction_address(instruction),
            node_value(instruction),
            stage8_frame_cells
        );
    } else if (kind == IR_COPY_GLOBAL) {
        emit_global_copy(
            instruction_address(instruction),
            destination,
            stage8_frame_cells
        );
    } else if (kind == IR_STORE_GLOBAL || kind == IR_ADD_GLOBAL
        || kind == IR_SUBTRACT_GLOBAL) {
        emit_transfer_to_global(
            destination,
            instruction_address(instruction),
            kind == IR_SUBTRACT_GLOBAL,
            kind == IR_STORE_GLOBAL,
            stage8_frame_cells
        );
    } else if (kind == IR_ARRAY_LOAD || kind == IR_ARRAY_STORE
        || kind == IR_ARRAY_ADD || kind == IR_ARRAY_SUBTRACT) {
        emit_array_instruction(instruction);
    } else if (kind == IR_OFFSET_ADD_SCALED
        || kind == IR_OFFSET_ADD_CONSTANT) {
        emit_offset_instruction(instruction);
    } else if (kind == IR_NOT) {
        emit_frame_not(destination);
    } else if (kind == IR_BOOLEANIZE) {
        emit_frame_booleanize(destination);
    } else if (kind == IR_EQUAL || kind == IR_NOT_EQUAL) {
        emit_transfer(source, destination, 1);
        if (kind == IR_EQUAL) {
            emit_frame_not(destination);
        } else {
            emit_frame_booleanize(destination);
        }
    } else if (kind == IR_LESS || kind == IR_GREATER_EQUAL) {
        emit_frame_less(destination, source);
        if (kind == IR_GREATER_EQUAL) {
            emit_frame_not(destination);
        }
    } else if (kind == IR_GREATER || kind == IR_LESS_EQUAL) {
        emit_frame_swap(destination, source);
        emit_frame_less(destination, source);
        if (kind == IR_LESS_EQUAL) {
            emit_frame_not(destination);
        }
    } else {
        fail('H', 'R');
    }
    emit_move_to(0);
}

void emit_call_terminator(NodeId continuation) {
    NodeId callee = node_name(continuation);
    NodeId resume = node_b(continuation);
    NodeId entry = node_a(node_c(callee));
    NodeId entry_id = continuation_dispatch_id(entry);
    NodeId resume_id = continuation_dispatch_id(resume);

    cell frame_cells = stage8_frame_cells;
    emit_next_context(frame_cells);
    cell position;
    while (position < frame_cells) {
        emit_clear(position);
        position += 1;
    }
    emit_constant(FRAME_ACTIVE, 1);
    emit_constant(FRAME_NEXT_PC_LOW, entry_id.slot);
    emit_constant(FRAME_NEXT_PC_HIGH, entry_id.page);
    emit_constant(FRAME_RETURN_PC_LOW, resume_id.slot);
    emit_constant(FRAME_RETURN_PC_HIGH, resume_id.page);
    emit_previous_context(frame_cells);

    NodeId argument = node_c(continuation);
    while (!node_is_null(argument)) {
        cell source = node_value(argument);
        cell destination = arena_read(argument, FIELD_B_PAGE);
        cell cells = 1;
        if (node_tag(argument) == AST_DECLARATION_ARRAY) {
            cells = arena_read(argument, FIELD_A_PAGE);
        }
        cell index;
        while (index < cells) {
            emit_copy_to_next_context(
                physical_frame_slot(source + index),
                physical_frame_slot(destination + index),
                frame_cells
            );
            index += 1;
        }
        argument = node_next(argument);
    }
    emit_next_context(frame_cells);
}

void emit_return_terminator(NodeId continuation) {
    cell frame_cells = stage8_frame_cells;
    cell slot = node_value(continuation);
    if (node_tag(continuation) == TERM_RETURN_ARRAY) {
        cell length = arena_read(continuation, FIELD_NAME_PAGE);
        cell index;
        while (index < length) {
            emit_frame_copy(physical_frame_slot(slot + index), FRAME_VALUE);
            emit_clear_previous_context(
                physical_frame_slot(stage8_outbox_base + index),
                frame_cells
            );
            emit_transfer_to_previous_context(
                FRAME_VALUE,
                physical_frame_slot(stage8_outbox_base + index),
                frame_cells
            );
            index += 1;
        }
    } else if (slot == VOID_RETURN_SLOT) {
        emit_clear_previous_context(FRAME_VALUE, frame_cells);
    } else {
        emit_frame_copy(physical_frame_slot(slot), FRAME_VALUE);
        emit_clear_previous_context(FRAME_VALUE, frame_cells);
        emit_transfer_to_previous_context(
            FRAME_VALUE,
            FRAME_VALUE,
            frame_cells
        );
    }
    emit_transfer_to_previous_context(
        FRAME_RETURN_PC_LOW,
        FRAME_NEXT_PC_LOW,
        frame_cells
    );
    emit_transfer_to_previous_context(
        FRAME_RETURN_PC_HIGH,
        FRAME_NEXT_PC_HIGH,
        frame_cells
    );

    cell position;
    while (position < frame_cells) {
        emit_clear(position);
        position += 1;
    }
    emit_previous_context(frame_cells);
}

void emit_continuation_terminator(NodeId continuation) {
    cell kind = node_tag(continuation);
    if (kind == TERM_GOTO) {
        NodeId target = node_name(continuation);
        NodeId target_id = continuation_dispatch_id(target);
        emit_constant(FRAME_NEXT_PC_LOW, target_id.slot);
        emit_constant(FRAME_NEXT_PC_HIGH, target_id.page);
    } else if (kind == TERM_BRANCH) {
        NodeId then_target = node_name(continuation);
        NodeId else_target = node_b(continuation);
        NodeId then_id = continuation_dispatch_id(then_target);
        NodeId else_id = continuation_dispatch_id(else_target);
        emit_constant(FRAME_NEXT_PC_LOW, else_id.slot);
        emit_constant(FRAME_NEXT_PC_HIGH, else_id.page);
        cell condition = physical_frame_slot(node_value(continuation));
        emit_loop_open(condition);
        emit_clear(condition);
        emit_constant(FRAME_NEXT_PC_LOW, then_id.slot);
        emit_constant(FRAME_NEXT_PC_HIGH, then_id.page);
        emit_loop_close(condition);
    } else if (kind == TERM_CALL) {
        emit_call_terminator(continuation);
    } else if (kind == TERM_RETURN || kind == TERM_RETURN_ARRAY) {
        emit_return_terminator(continuation);
    } else if (kind == TERM_HALT) {
        emit_clear(FRAME_ACTIVE);
    } else if (kind == TERM_ABORT) {
        emit_clear(FRAME_ACTIVE);
    } else {
        fail('H', 'S');
    }
}

void emit_dispatch_body(NodeId continuation) {
    NodeId instruction = node_a(continuation);
    while (!node_is_null(instruction)) {
        emit_ir_instruction(instruction);
        instruction = node_next(instruction);
    }
    emit_continuation_terminator(continuation);
}

// PcLowを最小IDで正規化し、入れ子loopを一段進むたびに破壊的に
// decrementする。Branchは一致したcaseだけが一度消費する。
void emit_countdown_case(NodeId continuation) {
    emit_loop_open(FRAME_BRANCH);
    emit_move_to(FRAME_BRANCH);
    emit_bf_character('-');
    emit_move_to(0);
    emit_dispatch_body(continuation);
    emit_loop_close(FRAME_BRANCH);
    emit_move_to(0);
}

void emit_low_countdown_level(NodeId continuation, cell remaining) {
    emit_loop_open(FRAME_PC_LOW);
    if (remaining == 0) {
        emit_clear(FRAME_PC_LOW);
        emit_clear(FRAME_BRANCH);
    } else {
        emit_move_to(FRAME_PC_LOW);
        emit_bf_character('-');
        emit_move_to(0);
        NodeId next = node_next(continuation);
        emit_low_countdown_level(next, remaining - 1);
    }
    emit_loop_close(FRAME_PC_LOW);
    emit_move_to(0);
    emit_countdown_case(continuation);
}

void emit_dispatch_page(NodeId first, NodeId after) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId last = first;
    NodeId probe = node_next(first);
    while (!node_equals(probe, after)) {
        last = probe;
        probe = node_next(probe);
    }
    NodeId last_id = continuation_dispatch_id(last);
    emit_add_constant(FRAME_PC_LOW, 0 - first_id.slot);
    emit_constant(FRAME_BRANCH, 1);
    emit_low_countdown_level(first, last_id.slot - first_id.slot);
}

NodeId next_dispatch_page(NodeId first) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId result = node_next(first);
    while (!node_is_null(result)) {
        NodeId result_id = continuation_dispatch_id(result);
        if (result_id.page != first_id.page) {
            return result;
        }
        result = node_next(result);
    }
    return result;
}

void emit_page_countdown_case(NodeId first, NodeId after) {
    emit_loop_open(FRAME_BRANCH);
    emit_move_to(FRAME_BRANCH);
    emit_bf_character('-');
    emit_move_to(0);
    emit_dispatch_page(first, after);
    emit_loop_close(FRAME_BRANCH);
    emit_move_to(0);
}

void emit_page_countdown_level(NodeId first, cell remaining) {
    NodeId after = next_dispatch_page(first);
    emit_loop_open(FRAME_PC_HIGH);
    if (remaining == 0) {
        emit_clear(FRAME_PC_HIGH);
        emit_clear(FRAME_BRANCH);
    } else {
        emit_move_to(FRAME_PC_HIGH);
        emit_bf_character('-');
        emit_move_to(0);
        emit_page_countdown_level(after, remaining - 1);
    }
    emit_loop_close(FRAME_PC_HIGH);
    emit_move_to(0);
    emit_page_countdown_case(first, after);
}

// continuationのdispatch IDは1から密に割り当てるため、low byteと
// high byteの両方を比較scanなしのcountdownにできる。
void emit_dispatch_countdown(NodeId first, NodeId last) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId last_id = continuation_dispatch_id(last);
    emit_add_constant(FRAME_PC_HIGH, 0 - first_id.page);
    emit_constant(FRAME_BRANCH, 1);
    emit_page_countdown_level(first, last_id.page - first_id.page);
}

void calculate_stage8_frame_size() {
    cell maximum;
    stage8_outbox_cells = 0;
    NodeId function = first_function;
    while (!node_is_null(function)) {
        NodeId descriptor = node_c(function);
        cell slots = node_value(descriptor);
        if (slots > maximum) {
            maximum = slots;
        }
        if (node_tag(function) == AST_TYPE_ARRAY) {
            cell return_length = arena_read(descriptor, FIELD_B_PAGE);
            if (return_length > stage8_outbox_cells) {
                stage8_outbox_cells = return_length;
            }
        }
        function = node_next(function);
    }
    if (stage8_outbox_cells > 0xef
        || maximum > 0xef - stage8_outbox_cells) {
        fail('H', 'T');
    }
    stage8_outbox_base = maximum;
    stage8_frame_cells = FRAME_DATA_BASE + maximum + stage8_outbox_cells;
}

void emit_continuation_program() {
    reset_bf_optimizer();
    calculate_stage8_frame_size();
    // static globals | zero anchor | one frame-stride gap | root frame
    emit_repeat_wide('>', stage7_static_cells);
    emit_repeat_character('>', stage8_frame_cells);
    target_position = 0;
    NodeId main_entry = node_a(node_c(main_function));
    NodeId main_entry_id = continuation_dispatch_id(main_entry);
    emit_constant(FRAME_ACTIVE, 1);
    emit_constant(FRAME_PC_LOW, main_entry_id.slot);
    emit_constant(FRAME_PC_HIGH, main_entry_id.page);
    emit_move_to(FRAME_ACTIVE);
    emit_bf_character('[');

    NodeId first = first_continuation;
    NodeId last = last_continuation;
    emit_dispatch_countdown(first, last);
    emit_transfer(FRAME_NEXT_PC_LOW, FRAME_PC_LOW, 0);
    emit_transfer(FRAME_NEXT_PC_HIGH, FRAME_PC_HIGH, 0);
    emit_move_to(FRAME_ACTIVE);
    emit_bf_character(']');
    flush_bf_optimizer();
}

void compile_program_stage12() {
    parse_ast_program();
    expand_ast_macros();
    analyze_ast_program();
    lower_ast_program();
    emit_continuation_program();
}
