// 16-bit logical offset portalとaggregate outboxを持つ第12段階Continuation ABI backend。
// 全functionを同じframe幅にすることで、直接・相互再帰を同じcall/return
// sequenceで扱う。PCとreturn PCはarena handleとは別の16-bit dispatch ID。
// Rustの16-cell chunk ABIとは別方式で、16-cell headerに可変長dataを続ける。

const cell FRAME_ACTIVE = 0;
const cell FRAME_PC_LOW = 1;
const cell FRAME_PC_HIGH = 2;
const cell FRAME_NEXT_PC_LOW = 3;
const cell FRAME_NEXT_PC_HIGH = 4;
const cell FRAME_RETURN_PC_LOW = 5;
const cell FRAME_RETURN_PC_HIGH = 6;
const cell FRAME_VALUE = 7;
const cell FRAME_CONDITION = 8;
const cell FRAME_RESTORE = 9;
const cell FRAME_BRANCH = 10;
const cell FRAME_SCRATCH_0 = 11;
const cell FRAME_SCRATCH_1 = 12;
const cell FRAME_SCRATCH_2 = 13;
const cell FRAME_SCRATCH_3 = 14;
const cell FRAME_DATA_BASE = 16;

cell stage8_frame_cells;
cell stage8_outbox_base;
cell stage8_outbox_cells;

cell physical_frame_slot(cell slot) {
    return FRAME_DATA_BASE + slot;
}

cell emit_add_constant(cell position, cell destination, cell value) {
    position = emit_move_to(position, destination);
    if (value <= 128) {
        emit_repeat_character('+', value);
    } else {
        emit_repeat_character('-', 0 - value);
    }
    return position;
}

cell emit_frame_copy(cell position, cell source, cell destination) {
    position = emit_clear(position, destination);
    position = emit_clear(position, FRAME_RESTORE);
    position = emit_move_to(position, source);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_move_to(position, destination);
    compiler_output!('+');
    position = emit_move_to(position, FRAME_RESTORE);
    compiler_output!('+');
    position = emit_move_to(position, source);
    compiler_output!(']');
    position = emit_transfer(position, FRAME_RESTORE, source, 0);
    return position;
}

cell emit_logical_offset_increment(cell position, cell low, cell high) {
    position = emit_add_constant(position, low, 1);
    position = emit_constant(position, FRAME_BRANCH, 1);
    position = emit_frame_copy(position, low, FRAME_SCRATCH_1);
    position = emit_loop_open(position, FRAME_SCRATCH_1);
    position = emit_clear(position, FRAME_SCRATCH_1);
    position = emit_clear(position, FRAME_BRANCH);
    position = emit_loop_close(position, FRAME_SCRATCH_1);
    position = emit_loop_open(position, FRAME_BRANCH);
    position = emit_clear(position, FRAME_BRANCH);
    position = emit_add_constant(position, high, 1);
    position = emit_loop_close(position, FRAME_BRANCH);
    return position;
}

cell emit_logical_offset_steps(
    cell position,
    cell low,
    cell high,
    cell amount_low,
    cell amount_high
) {
    // Adding 256 to a 16-bit offset changes only its high byte.
    position = emit_add_constant(position, high, amount_high);
    while (amount_low != 0) {
        position = emit_logical_offset_increment(position, low, high);
        amount_low -= 1;
    }
    return position;
}

cell emit_offset_instruction(cell position, NodeId instruction) {
    cell low = physical_frame_slot(node_value(instruction));
    cell high = physical_frame_slot(
        arena_read(instruction, FIELD_NAME_PAGE)
    );
    cell amount_low = arena_read(instruction, FIELD_A_SLOT);
    cell amount_high = arena_read(instruction, FIELD_A_BANK);
    if (node_tag(instruction) == IR_OFFSET_ADD_CONSTANT) {
        return emit_logical_offset_steps(
            position, low, high, amount_low, amount_high
        );
    }
    cell source = physical_frame_slot(
        arena_read(instruction, FIELD_A_PAGE)
    );
    position = emit_loop_open(position, source);
    position = emit_move_to(position, source);
    compiler_output!('-');
    position = emit_logical_offset_steps(
        position, low, high, amount_low, amount_high
    );
    position = emit_loop_close(position, source);
    return position;
}

cell emit_frame_booleanize(cell position, cell destination) {
    position = emit_clear(position, FRAME_SCRATCH_0);
    position = emit_loop_open(position, destination);
    position = emit_clear(position, destination);
    position = emit_move_to(position, FRAME_SCRATCH_0);
    compiler_output!('+');
    position = emit_loop_close(position, destination);
    position = emit_transfer(position, FRAME_SCRATCH_0, destination, 0);
    return position;
}

cell emit_frame_not(cell position, cell destination) {
    position = emit_constant(position, FRAME_SCRATCH_0, 1);
    position = emit_loop_open(position, destination);
    position = emit_clear(position, destination);
    position = emit_clear(position, FRAME_SCRATCH_0);
    position = emit_loop_close(position, destination);
    position = emit_transfer(position, FRAME_SCRATCH_0, destination, 0);
    return position;
}

cell emit_frame_negate(cell position, cell destination) {
    position = emit_clear(position, FRAME_SCRATCH_0);
    position = emit_transfer(position, destination, FRAME_SCRATCH_0, 1);
    position = emit_transfer(position, FRAME_SCRATCH_0, destination, 0);
    return position;
}

cell emit_frame_swap(cell position, cell left, cell right) {
    position = emit_clear(position, FRAME_SCRATCH_3);
    position = emit_transfer(position, left, FRAME_SCRATCH_3, 0);
    position = emit_transfer(position, right, left, 0);
    position = emit_transfer(position, FRAME_SCRATCH_3, right, 0);
    return position;
}

cell emit_frame_less(cell position, cell left, cell right) {
    position = emit_clear(position, FRAME_SCRATCH_1);
    position = emit_loop_open(position, right);
    position = emit_move_to(position, right);
    compiler_output!('-');
    position = emit_frame_copy(position, left, FRAME_CONDITION);
    position = emit_frame_booleanize(position, FRAME_CONDITION);
    position = emit_constant(position, FRAME_SCRATCH_0, 1);

    position = emit_loop_open(position, FRAME_CONDITION);
    position = emit_clear(position, FRAME_CONDITION);
    position = emit_clear(position, FRAME_SCRATCH_0);
    position = emit_move_to(position, left);
    compiler_output!('-');
    position = emit_loop_close(position, FRAME_CONDITION);

    position = emit_loop_open(position, FRAME_SCRATCH_0);
    position = emit_clear(position, FRAME_SCRATCH_0);
    position = emit_constant(position, FRAME_SCRATCH_1, 1);
    position = emit_clear(position, right);
    position = emit_loop_close(position, FRAME_SCRATCH_0);
    position = emit_loop_close(position, right);

    position = emit_clear(position, left);
    position = emit_transfer(position, FRAME_SCRATCH_1, left, 0);
    return position;
}

cell emit_next_context(cell position, cell frame_cells) {
    position = emit_move_to(position, 0);
    emit_repeat_character('>', frame_cells);
    return 0;
}

cell emit_previous_context(cell position, cell frame_cells) {
    position = emit_move_to(position, 0);
    emit_repeat_character('<', frame_cells);
    return 0;
}

// Every allocated activation keeps FRAME_ACTIVE=1.  One zero anchor sits one
// frame stride to the left of the root, so a scan reaches static storage from
// any recursion depth without materializing a pointer in a language cell.
cell emit_current_to_anchor(cell position, cell frame_cells) {
    position = emit_move_to(position, FRAME_ACTIVE);
    compiler_output!('[');
    emit_repeat_character('<', frame_cells);
    compiler_output!(']');
    return 0;
}

cell emit_anchor_to_current(cell position, cell frame_cells) {
    emit_repeat_character('>', frame_cells);
    compiler_output!('[');
    emit_repeat_character('>', frame_cells);
    compiler_output!(']');
    emit_repeat_character('<', frame_cells);
    return 0;
}

cell emit_anchor_to_global_distance(cell position, WideValue distance) {
    emit_repeat_wide('<', distance);
    return 0;
}

cell emit_global_to_anchor_distance(cell position, WideValue distance) {
    emit_repeat_wide('>', distance);
    return 0;
}

cell emit_anchor_to_global(cell position, WideValue global) {
    return emit_anchor_to_global_distance(
        position, wide_subtract(stage7_static_cells, global)
    );
}

cell emit_global_to_anchor(cell position, WideValue global) {
    return emit_global_to_anchor_distance(
        position, wide_subtract(stage7_static_cells, global)
    );
}

cell emit_current_to_global_distance(
    cell position,
    WideValue distance,
    cell frame_cells
) {
    position = emit_current_to_anchor(position, frame_cells);
    return emit_anchor_to_global_distance(position, distance);
}

cell emit_global_to_current_distance(
    cell position,
    WideValue distance,
    cell frame_cells
) {
    position = emit_global_to_anchor_distance(position, distance);
    return emit_anchor_to_current(position, frame_cells);
}

cell emit_current_to_global(
    cell position,
    WideValue global,
    cell frame_cells
) {
    return emit_current_to_global_distance(
        position,
        wide_subtract(stage7_static_cells, global),
        frame_cells
    );
}

cell emit_global_to_current(
    cell position,
    WideValue global,
    cell frame_cells
) {
    return emit_global_to_current_distance(
        position,
        wide_subtract(stage7_static_cells, global),
        frame_cells
    );
}

cell emit_global_constant(
    cell position,
    WideValue global,
    cell value,
    cell frame_cells
) {
    WideValue distance = wide_subtract(stage7_static_cells, global);
    position = emit_current_to_global_distance(position, distance, frame_cells);
    compiler_output!('[');
    compiler_output!('-');
    compiler_output!(']');
    if (value <= 128) {
        emit_repeat_character('+', value);
    } else {
        while (value != 0) {
            compiler_output!('-');
            value += 1;
        }
    }
    position = emit_global_to_current_distance(position, distance, frame_cells);
    return position;
}

cell emit_global_copy(
    cell position,
    WideValue global,
    cell destination,
    cell frame_cells
) {
    WideValue distance = wide_subtract(stage7_static_cells, global);
    position = emit_clear(position, destination);
    position = emit_clear(position, FRAME_RESTORE);
    position = emit_current_to_global_distance(position, distance, frame_cells);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_global_to_current_distance(position, distance, frame_cells);
    position = emit_move_to(position, destination);
    compiler_output!('+');
    position = emit_move_to(position, FRAME_RESTORE);
    compiler_output!('+');
    position = emit_move_to(position, 0);
    position = emit_current_to_global_distance(position, distance, frame_cells);
    compiler_output!(']');
    position = emit_global_to_current_distance(position, distance, frame_cells);

    position = emit_move_to(position, FRAME_RESTORE);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_move_to(position, 0);
    position = emit_current_to_global_distance(position, distance, frame_cells);
    compiler_output!('+');
    position = emit_global_to_current_distance(position, distance, frame_cells);
    position = emit_move_to(position, FRAME_RESTORE);
    compiler_output!(']');
    position = emit_move_to(position, 0);
    return position;
}

cell emit_transfer_to_global(
    cell position,
    cell source,
    WideValue global,
    cell subtract,
    cell clear_first,
    cell frame_cells
) {
    WideValue distance = wide_subtract(stage7_static_cells, global);
    if (clear_first) {
        position = emit_current_to_global_distance(position, distance, frame_cells);
        compiler_output!('[');
        compiler_output!('-');
        compiler_output!(']');
        position = emit_global_to_current_distance(position, distance, frame_cells);
    }
    position = emit_move_to(position, source);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_move_to(position, 0);
    position = emit_current_to_global_distance(position, distance, frame_cells);
    if (subtract) {
        compiler_output!('-');
    } else {
        compiler_output!('+');
    }
    position = emit_global_to_current_distance(position, distance, frame_cells);
    position = emit_move_to(position, source);
    compiler_output!(']');
    position = emit_move_to(position, 0);
    return position;
}

cell emit_copy_to_next_context(
    cell position,
    cell source,
    cell destination,
    cell frame_cells
) {
    position = emit_clear(position, FRAME_RESTORE);
    position = emit_move_to(position, source);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_move_to(position, 0);
    emit_repeat_character('>', frame_cells);
    position = 0;
    position = emit_move_to(position, destination);
    compiler_output!('+');
    position = emit_move_to(position, 0);
    emit_repeat_character('<', frame_cells);
    position = 0;
    position = emit_move_to(position, FRAME_RESTORE);
    compiler_output!('+');
    position = emit_move_to(position, source);
    compiler_output!(']');
    position = emit_transfer(position, FRAME_RESTORE, source, 0);
    position = emit_move_to(position, 0);
    return position;
}

cell emit_transfer_to_previous_context(
    cell position,
    cell source,
    cell destination,
    cell frame_cells
) {
    position = emit_move_to(position, source);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_move_to(position, 0);
    emit_repeat_character('<', frame_cells);
    position = 0;
    position = emit_move_to(position, destination);
    compiler_output!('+');
    position = emit_move_to(position, 0);
    emit_repeat_character('>', frame_cells);
    position = 0;
    position = emit_move_to(position, source);
    compiler_output!(']');
    position = emit_move_to(position, 0);
    return position;
}

cell emit_clear_previous_context(
    cell position,
    cell destination,
    cell frame_cells
) {
    position = emit_previous_context(position, frame_cells);
    position = emit_clear(position, destination);
    return emit_next_context(position, frame_cells);
}

cell emit_array_case_operation(
    cell position,
    cell kind,
    cell data,
    WideValue base,
    WideValue element,
    cell storage,
    cell frame_cells
) {
    cell data_slot = physical_frame_slot(data);
    if (storage == RESOLVED_GLOBAL_DYNAMIC) {
        WideValue global = wide_add(base, element);
        if (kind == IR_ARRAY_LOAD) {
            position = emit_global_copy(
                position, global, data_slot, frame_cells
            );
        } else if (kind == IR_ARRAY_STORE) {
            position = emit_transfer_to_global(
                position, data_slot, global, 0, 1, frame_cells
            );
        } else if (kind == IR_ARRAY_ADD) {
            position = emit_transfer_to_global(
                position, data_slot, global, 0, 0, frame_cells
            );
        } else if (kind == IR_ARRAY_SUBTRACT) {
            position = emit_transfer_to_global(
                position, data_slot, global, 1, 0, frame_cells
            );
        } else {
            fail('H', 'N');
        }
        return position;
    }

    if (base.mid != 0 || base.high != 0
        || element.mid != 0 || element.high != 0) {
        fail('H', 'O');
    }
    cell array_slot = physical_frame_slot(base.low + element.low);
    if (kind == IR_ARRAY_LOAD) {
        position = emit_frame_copy(position, array_slot, data_slot);
    } else if (kind == IR_ARRAY_STORE) {
        position = emit_clear(position, array_slot);
        position = emit_transfer(position, data_slot, array_slot, 0);
    } else if (kind == IR_ARRAY_ADD) {
        position = emit_transfer(position, data_slot, array_slot, 0);
    } else if (kind == IR_ARRAY_SUBTRACT) {
        position = emit_transfer(position, data_slot, array_slot, 1);
    } else {
        fail('H', 'P');
    }
    return position;
}

cell emit_array_countdown_case(
    cell position,
    cell kind,
    cell data,
    WideValue base,
    WideValue element,
    cell storage,
    cell branch,
    cell frame_cells
) {
    position = emit_loop_open(position, branch);
    position = emit_move_to(position, branch);
    compiler_output!('-');
    position = emit_move_to(position, 0);
    position = emit_array_case_operation(
        position, kind, data, base, element, storage, frame_cells
    );
    position = emit_loop_close(position, branch);
    position = emit_move_to(position, 0);
    return position;
}

cell emit_array_countdown_level(
    cell position,
    cell kind,
    cell data,
    cell index,
    WideValue base,
    WideValue element,
    cell storage,
    cell remaining,
    cell branch,
    cell frame_cells
) {
    cell index_slot = physical_frame_slot(index);
    position = emit_loop_open(position, index_slot);
    if (remaining == 0) {
        position = emit_clear(position, index_slot);
        position = emit_clear(position, branch);
    } else {
        position = emit_move_to(position, index_slot);
        compiler_output!('-');
        position = emit_move_to(position, 0);
        position = emit_array_countdown_level(
            position,
            kind,
            data,
            index,
            base,
            wide_add(element, wide_from_cell(1)),
            storage,
            remaining - 1,
            branch,
            frame_cells
        );
    }
    position = emit_loop_close(position, index_slot);
    position = emit_move_to(position, 0);
    position = emit_array_countdown_case(
        position,
        kind,
        data,
        base,
        element,
        storage,
        branch,
        frame_cells
    );
    return position;
}

cell emit_array_page_countdown_case(
    cell position,
    cell kind,
    cell data,
    cell index,
    WideValue base,
    cell page,
    cell full_pages,
    cell tail,
    cell storage,
    cell frame_cells
) {
    position = emit_loop_open(position, FRAME_SCRATCH_3);
    position = emit_move_to(position, FRAME_SCRATCH_3);
    compiler_output!('-');
    position = emit_move_to(position, 0);
    WideValue page_offset;
    page_offset.mid = page;
    cell remaining = 0xff;
    if (page == full_pages) {
        remaining = tail - 1;
    }
    position = emit_constant(position, FRAME_BRANCH, 1);
    position = emit_array_countdown_level(
        position,
        kind,
        data,
        index,
        wide_add(base, page_offset),
        wide_from_cell(0),
        storage,
        remaining,
        FRAME_BRANCH,
        frame_cells
    );
    position = emit_loop_close(position, FRAME_SCRATCH_3);
    position = emit_move_to(position, 0);
    return position;
}

cell emit_array_page_countdown_level(
    cell position,
    cell kind,
    cell data,
    cell index_low,
    cell index_high,
    WideValue base,
    cell page,
    cell full_pages,
    cell tail,
    cell storage,
    cell remaining,
    cell frame_cells
) {
    cell high_slot = physical_frame_slot(index_high);
    position = emit_loop_open(position, high_slot);
    if (remaining == 0) {
        position = emit_clear(position, high_slot);
        position = emit_clear(position, FRAME_SCRATCH_3);
    } else {
        position = emit_move_to(position, high_slot);
        compiler_output!('-');
        position = emit_move_to(position, 0);
        position = emit_array_page_countdown_level(
            position,
            kind,
            data,
            index_low,
            index_high,
            base,
            page + 1,
            full_pages,
            tail,
            storage,
            remaining - 1,
            frame_cells
        );
    }
    position = emit_loop_close(position, high_slot);
    position = emit_move_to(position, 0);
    position = emit_array_page_countdown_case(
        position,
        kind,
        data,
        index_low,
        base,
        page,
        full_pages,
        tail,
        storage,
        frame_cells
    );
    return position;
}

cell emit_array_instruction(cell position, NodeId instruction) {
    cell kind = node_tag(instruction);
    cell data = node_value(instruction);
    cell index = arena_read(instruction, FIELD_NAME_PAGE);
    cell offset_high = arena_read(instruction, FIELD_NAME_SLOT);
    WideValue base = instruction_address(instruction);
    WideValue length;
    length.low = arena_read(instruction, FIELD_C_PAGE);
    length.mid = arena_read(instruction, FIELD_C_SLOT);
    length.high = arena_read(instruction, FIELD_C_BANK);
    cell storage = arena_read(instruction, FIELD_B_PAGE);
    if (wide_is_zero(length) || length.high != 0) {
        fail('H', 'Q');
    }
    if (kind == IR_ARRAY_LOAD) {
        position = emit_clear(position, physical_frame_slot(data));
    }
    if (length.mid == 0) {
        // A one-page region only accepts a zero high byte.
        position = emit_constant(position, FRAME_SCRATCH_2, 1);
        cell high_slot = physical_frame_slot(offset_high);
        position = emit_loop_open(position, high_slot);
        position = emit_clear(position, high_slot);
        position = emit_clear(position, FRAME_SCRATCH_2);
        position = emit_loop_close(position, high_slot);
        position = emit_loop_open(position, FRAME_SCRATCH_2);
        position = emit_clear(position, FRAME_SCRATCH_2);
        position = emit_constant(position, FRAME_BRANCH, 1);
        position = emit_array_countdown_level(
            position,
            kind,
            data,
            index,
            base,
            wide_from_cell(0),
            storage,
            length.low - 1,
            FRAME_BRANCH,
            stage8_frame_cells
        );
        position = emit_loop_close(position, FRAME_SCRATCH_2);
        return position;
    }

    cell pages = length.mid;
    if (length.low != 0) {
        pages += 1;
    }
    position = emit_constant(position, FRAME_SCRATCH_3, 1);
    position = emit_array_page_countdown_level(
        position,
        kind,
        data,
        index,
        offset_high,
        base,
        0,
        length.mid,
        length.low,
        storage,
        pages - 1,
        stage8_frame_cells
    );
    return position;
}

cell emit_ir_instruction(cell position, NodeId instruction) {
    cell kind = node_tag(instruction);
    cell destination = physical_frame_slot(node_value(instruction));
    cell source = physical_frame_slot(instruction_source(instruction));
    if (kind == IR_SET) {
        position = emit_constant(position, destination, instruction_source(instruction));
    } else if (kind == IR_COPY) {
        position = emit_frame_copy(position, source, destination);
    } else if (kind == IR_COPY_ABI_VALUE) {
        position = emit_frame_copy(position, FRAME_VALUE, destination);
    } else if (kind == IR_COPY_OUTBOX) {
        position = emit_frame_copy(
            position,
            physical_frame_slot(
                stage8_outbox_base + instruction_source(instruction)
            ),
            destination
        );
    } else if (kind == IR_INPUT) {
        position = emit_input(position, destination);
    } else if (kind == IR_OUTPUT) {
        position = emit_move_to(position, source);
        compiler_output!('.');
    } else if (kind == IR_ADD) {
        position = emit_transfer(position, source, destination, 0);
    } else if (kind == IR_SUBTRACT) {
        position = emit_transfer(position, source, destination, 1);
    } else if (kind == IR_NEGATE) {
        position = emit_frame_negate(position, destination);
    } else if (kind == IR_SET_GLOBAL) {
        position = emit_global_constant(
            position,
            instruction_address(instruction),
            node_value(instruction),
            stage8_frame_cells
        );
    } else if (kind == IR_COPY_GLOBAL) {
        position = emit_global_copy(
            position,
            instruction_address(instruction),
            destination,
            stage8_frame_cells
        );
    } else if (kind == IR_STORE_GLOBAL || kind == IR_ADD_GLOBAL
        || kind == IR_SUBTRACT_GLOBAL) {
        position = emit_transfer_to_global(
            position,
            destination,
            instruction_address(instruction),
            kind == IR_SUBTRACT_GLOBAL,
            kind == IR_STORE_GLOBAL,
            stage8_frame_cells
        );
    } else if (kind == IR_ARRAY_LOAD || kind == IR_ARRAY_STORE
        || kind == IR_ARRAY_ADD || kind == IR_ARRAY_SUBTRACT) {
        position = emit_array_instruction(position, instruction);
    } else if (kind == IR_OFFSET_ADD_SCALED
        || kind == IR_OFFSET_ADD_CONSTANT) {
        position = emit_offset_instruction(position, instruction);
    } else if (kind == IR_NOT) {
        position = emit_frame_not(position, destination);
    } else if (kind == IR_BOOLEANIZE) {
        position = emit_frame_booleanize(position, destination);
    } else if (kind == IR_EQUAL || kind == IR_NOT_EQUAL) {
        position = emit_transfer(position, source, destination, 1);
        if (kind == IR_EQUAL) {
            position = emit_frame_not(position, destination);
        } else {
            position = emit_frame_booleanize(position, destination);
        }
    } else if (kind == IR_LESS || kind == IR_GREATER_EQUAL) {
        position = emit_frame_less(position, destination, source);
        if (kind == IR_GREATER_EQUAL) {
            position = emit_frame_not(position, destination);
        }
    } else if (kind == IR_GREATER || kind == IR_LESS_EQUAL) {
        position = emit_frame_swap(position, destination, source);
        position = emit_frame_less(position, destination, source);
        if (kind == IR_LESS_EQUAL) {
            position = emit_frame_not(position, destination);
        }
    } else {
        fail('H', 'R');
    }
    position = emit_move_to(position, 0);
    return position;
}

cell emit_call_terminator(cell position, NodeId continuation) {
    NodeId callee = node_name(continuation);
    NodeId resume = node_b(continuation);
    NodeId entry = node_a(node_c(callee));
    NodeId entry_id = continuation_dispatch_id(entry);
    NodeId resume_id = continuation_dispatch_id(resume);

    cell frame_cells = stage8_frame_cells;
    position = emit_next_context(position, frame_cells);
    cell clear_index;
    while (clear_index < frame_cells) {
        position = emit_clear(position, clear_index);
        clear_index += 1;
    }
    position = emit_constant(position, FRAME_ACTIVE, 1);
    position = emit_constant(position, FRAME_NEXT_PC_LOW, entry_id.slot);
    position = emit_constant(position, FRAME_NEXT_PC_HIGH, entry_id.page);
    position = emit_constant(position, FRAME_RETURN_PC_LOW, resume_id.slot);
    position = emit_constant(position, FRAME_RETURN_PC_HIGH, resume_id.page);
    position = emit_previous_context(position, frame_cells);

    NodeId argument = node_c(continuation);
    while (!node_is_null(argument)) {
        cell source = node_value(argument);
        cell destination = arena_read(argument, FIELD_B_PAGE);
        cell cells = 1;
        if (node_tag(argument) == AST_DECLARATION_ARRAY) {
            cells = arena_read(argument, FIELD_A_PAGE);
        }
        cell index;
        while (index < cells) {
            position = emit_copy_to_next_context(
                position,
                physical_frame_slot(source + index),
                physical_frame_slot(destination + index),
                frame_cells
            );
            index += 1;
        }
        argument = node_next(argument);
    }
    position = emit_next_context(position, frame_cells);
    return position;
}

cell emit_return_terminator(cell position, NodeId continuation) {
    cell frame_cells = stage8_frame_cells;
    cell slot = node_value(continuation);
    if (node_tag(continuation) == TERM_RETURN_ARRAY) {
        cell length = arena_read(continuation, FIELD_NAME_PAGE);
        cell index;
        while (index < length) {
            position = emit_frame_copy(
                position, physical_frame_slot(slot + index), FRAME_VALUE
            );
            position = emit_clear_previous_context(
                position,
                physical_frame_slot(stage8_outbox_base + index),
                frame_cells
            );
            position = emit_transfer_to_previous_context(
                position,
                FRAME_VALUE,
                physical_frame_slot(stage8_outbox_base + index),
                frame_cells
            );
            index += 1;
        }
    } else if (slot == VOID_RETURN_SLOT) {
        position = emit_clear_previous_context(position, FRAME_VALUE, frame_cells);
    } else {
        position = emit_frame_copy(
            position, physical_frame_slot(slot), FRAME_VALUE
        );
        position = emit_clear_previous_context(position, FRAME_VALUE, frame_cells);
        position = emit_transfer_to_previous_context(
            position,
            FRAME_VALUE,
            FRAME_VALUE,
            frame_cells
        );
    }
    position = emit_transfer_to_previous_context(
        position,
        FRAME_RETURN_PC_LOW,
        FRAME_NEXT_PC_LOW,
        frame_cells
    );
    position = emit_transfer_to_previous_context(
        position,
        FRAME_RETURN_PC_HIGH,
        FRAME_NEXT_PC_HIGH,
        frame_cells
    );

    cell clear_index;
    while (clear_index < frame_cells) {
        position = emit_clear(position, clear_index);
        clear_index += 1;
    }
    position = emit_previous_context(position, frame_cells);
    return position;
}

cell emit_continuation_terminator(cell position, NodeId continuation) {
    cell kind = node_tag(continuation);
    if (kind == TERM_GOTO) {
        NodeId target = node_name(continuation);
        NodeId target_id = continuation_dispatch_id(target);
        position = emit_constant(position, FRAME_NEXT_PC_LOW, target_id.slot);
        position = emit_constant(position, FRAME_NEXT_PC_HIGH, target_id.page);
    } else if (kind == TERM_BRANCH) {
        NodeId then_target = node_name(continuation);
        NodeId else_target = node_b(continuation);
        NodeId then_id = continuation_dispatch_id(then_target);
        NodeId else_id = continuation_dispatch_id(else_target);
        position = emit_constant(position, FRAME_NEXT_PC_LOW, else_id.slot);
        position = emit_constant(position, FRAME_NEXT_PC_HIGH, else_id.page);
        cell condition = physical_frame_slot(node_value(continuation));
        position = emit_loop_open(position, condition);
        position = emit_clear(position, condition);
        position = emit_constant(position, FRAME_NEXT_PC_LOW, then_id.slot);
        position = emit_constant(position, FRAME_NEXT_PC_HIGH, then_id.page);
        position = emit_loop_close(position, condition);
    } else if (kind == TERM_CALL) {
        position = emit_call_terminator(position, continuation);
    } else if (kind == TERM_RETURN || kind == TERM_RETURN_ARRAY) {
        position = emit_return_terminator(position, continuation);
    } else if (kind == TERM_HALT) {
        position = emit_clear(position, FRAME_ACTIVE);
    } else if (kind == TERM_ABORT) {
        position = emit_clear(position, FRAME_ACTIVE);
    } else {
        fail('H', 'S');
    }
    return position;
}

cell emit_dispatch_body(cell position, NodeId continuation) {
    NodeId instruction = node_a(continuation);
    while (!node_is_null(instruction)) {
        position = emit_ir_instruction(position, instruction);
        instruction = node_next(instruction);
    }
    return emit_continuation_terminator(position, continuation);
}

// PcLowを最小IDで正規化し、入れ子loopを一段進むたびに破壊的に
// decrementする。Branchは一致したcaseだけが一度消費する。
cell emit_countdown_case(cell position, NodeId continuation) {
    position = emit_loop_open(position, FRAME_BRANCH);
    position = emit_move_to(position, FRAME_BRANCH);
    compiler_output!('-');
    position = emit_move_to(position, 0);
    position = emit_dispatch_body(position, continuation);
    position = emit_loop_close(position, FRAME_BRANCH);
    position = emit_move_to(position, 0);
    return position;
}

cell emit_low_countdown_level(
    cell position, NodeId continuation, cell remaining
) {
    position = emit_loop_open(position, FRAME_PC_LOW);
    if (remaining == 0) {
        position = emit_clear(position, FRAME_PC_LOW);
        position = emit_clear(position, FRAME_BRANCH);
    } else {
        position = emit_move_to(position, FRAME_PC_LOW);
        compiler_output!('-');
        position = emit_move_to(position, 0);
        NodeId next = node_next(continuation);
        position = emit_low_countdown_level(position, next, remaining - 1);
    }
    position = emit_loop_close(position, FRAME_PC_LOW);
    position = emit_move_to(position, 0);
    return emit_countdown_case(position, continuation);
}

cell emit_dispatch_page(cell position, NodeId first, NodeId after) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId last = first;
    NodeId probe = node_next(first);
    while (!node_equals(probe, after)) {
        last = probe;
        probe = node_next(probe);
    }
    NodeId last_id = continuation_dispatch_id(last);
    position = emit_add_constant(
        position, FRAME_PC_LOW, 0 - first_id.slot
    );
    position = emit_constant(position, FRAME_BRANCH, 1);
    position = emit_low_countdown_level(
        position, first, last_id.slot - first_id.slot
    );
    return position;
}

NodeId next_dispatch_page(NodeId first) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId result = node_next(first);
    while (!node_is_null(result)) {
        NodeId result_id = continuation_dispatch_id(result);
        if (result_id.page != first_id.page) {
            return result;
        }
        result = node_next(result);
    }
    return result;
}

cell emit_page_countdown_case(
    cell position, NodeId first, NodeId after
) {
    position = emit_loop_open(position, FRAME_BRANCH);
    position = emit_move_to(position, FRAME_BRANCH);
    compiler_output!('-');
    position = emit_move_to(position, 0);
    position = emit_dispatch_page(position, first, after);
    position = emit_loop_close(position, FRAME_BRANCH);
    position = emit_move_to(position, 0);
    return position;
}

cell emit_page_countdown_level(
    cell position, NodeId first, cell remaining
) {
    NodeId after = next_dispatch_page(first);
    position = emit_loop_open(position, FRAME_PC_HIGH);
    if (remaining == 0) {
        position = emit_clear(position, FRAME_PC_HIGH);
        position = emit_clear(position, FRAME_BRANCH);
    } else {
        position = emit_move_to(position, FRAME_PC_HIGH);
        compiler_output!('-');
        position = emit_move_to(position, 0);
        position = emit_page_countdown_level(position, after, remaining - 1);
    }
    position = emit_loop_close(position, FRAME_PC_HIGH);
    position = emit_move_to(position, 0);
    return emit_page_countdown_case(position, first, after);
}

// continuationのdispatch IDは1から密に割り当てるため、low byteと
// high byteの両方を比較scanなしのcountdownにできる。
cell emit_dispatch_countdown(cell position, NodeId first, NodeId last) {
    NodeId first_id = continuation_dispatch_id(first);
    NodeId last_id = continuation_dispatch_id(last);
    position = emit_add_constant(
        position, FRAME_PC_HIGH, 0 - first_id.page
    );
    position = emit_constant(position, FRAME_BRANCH, 1);
    position = emit_page_countdown_level(
        position, first, last_id.page - first_id.page
    );
    return position;
}

void calculate_stage8_frame_size() {
    cell maximum;
    stage8_outbox_cells = 0;
    NodeId function = first_function;
    while (!node_is_null(function)) {
        NodeId descriptor = node_c(function);
        cell slots = node_value(descriptor);
        if (slots > maximum) {
            maximum = slots;
        }
        if (node_tag(function) == AST_TYPE_ARRAY) {
            cell return_length = arena_read(descriptor, FIELD_B_PAGE);
            if (return_length > stage8_outbox_cells) {
                stage8_outbox_cells = return_length;
            }
        }
        function = node_next(function);
    }
    if (stage8_outbox_cells > 0xef
        || maximum > 0xef - stage8_outbox_cells) {
        fail('H', 'T');
    }
    stage8_outbox_base = maximum;
    stage8_frame_cells = FRAME_DATA_BASE + maximum + stage8_outbox_cells;
}

cell emit_continuation_program(cell position) {
    calculate_stage8_frame_size();
    // static globals | zero anchor | one frame-stride gap | root frame
    emit_repeat_wide('>', stage7_static_cells);
    emit_repeat_character('>', stage8_frame_cells);
    position = 0;
    NodeId main_entry = node_a(node_c(main_function));
    NodeId main_entry_id = continuation_dispatch_id(main_entry);
    position = emit_constant(position, FRAME_ACTIVE, 1);
    position = emit_constant(position, FRAME_PC_LOW, main_entry_id.slot);
    position = emit_constant(position, FRAME_PC_HIGH, main_entry_id.page);
    position = emit_move_to(position, FRAME_ACTIVE);
    compiler_output!('[');

    NodeId first = first_continuation;
    NodeId last = last_continuation;
    position = emit_dispatch_countdown(position, first, last);
    position = emit_transfer(position, FRAME_NEXT_PC_LOW, FRAME_PC_LOW, 0);
    position = emit_transfer(position, FRAME_NEXT_PC_HIGH, FRAME_PC_HIGH, 0);
    position = emit_move_to(position, FRAME_ACTIVE);
    compiler_output!(']');
    return position;
}

void compile_program_stage12() {
    parse_ast_program();
    expand_ast_macros();
    analyze_ast_program();
    lower_ast_program();
    cell position;
    position = emit_continuation_program(position);
}
