// LANGUAGE.mdの初期実装第1〜12段階を対象にするbootstrap BFC compiler。
//
// compiler自体は実装済みのversion 1 BFCで記述する。第12段階sourceをinputから
// 読み、Brainfuckを出力する。BFCのinput()仕様に従い、NULを入力終端とする。

const cell MAX_NAME = 64;

enum TokenKind {
    Eof,
    Identifier,
    Number,
    LeftParen,
    RightParen,
    LeftBrace,
    RightBrace,
    LeftBracket,
    RightBracket,
    Comma,
    Semicolon,
    Assign,
    EqualEqual,
    Plus,
    Minus,
    PlusAssign,
    MinusAssign,
    Bang,
    BangEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    AmpAmp,
    PipePipe,
    Dot,
    ColonColon,
    String
}

cell current_char;
TokenKind token_kind;
cell token_value;
// `cell`には収まらないarray length literal 256を区別する。
cell token_number_is_256;
cell token_length;
cell[MAX_NAME] token_text;
cell token_string_length;
cell token_string_is_256;
cell[256] token_string;

// Position of the data pointer in the Brainfuck program being emitted.
