// LANGUAGE.mdの初期実装第1〜7段階を対象にするbootstrap BFC compiler。
//
// compiler自体は実装済みのversion 1 BFCで記述する。第7段階sourceをinputから
// 読み、Brainfuckを出力する。BFCのinput()仕様に従い、NULを入力終端とする。

const cell MAX_NAME = 64;
const cell MAX_SYMBOLS = 16;
const cell MAX_SCOPES = 16;
const cell SCRATCH_BASE = 32;
const cell RESTORE_CELL = 63;
const cell CONTROL_BASE = 64;
const cell MAX_CONTROL_DEPTH = 31;

enum TokenKind {
    Eof,
    Identifier,
    Number,
    LeftParen,
    RightParen,
    LeftBrace,
    RightBrace,
    LeftBracket,
    RightBracket,
    Comma,
    Semicolon,
    Assign,
    EqualEqual,
    Plus,
    Minus,
    PlusAssign,
    MinusAssign,
    Bang,
    BangEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    AmpAmp,
    PipePipe
}

cell current_char;
TokenKind token_kind;
cell token_value;
// `cell`には収まらないarray length literal 256を区別する。
cell token_number_is_256;
cell token_length;
cell[MAX_NAME] token_text;

cell[MAX_SYMBOLS][MAX_NAME] symbol_text;
cell[MAX_SYMBOLS] symbol_length;
cell[MAX_SYMBOLS] symbol_cell;
cell symbol_count;
cell[MAX_SCOPES] scope_base;
cell scope_depth;
cell control_depth;

// Position of the data pointer in the Brainfuck program being emitted.
cell target_position;
