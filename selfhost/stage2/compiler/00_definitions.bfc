// LANGUAGE.mdの初期実装第1・2段階を対象にするbootstrap BFC compiler。
//
// compiler自体は実装済みのversion 1 BFCで記述する。第2段階sourceをinputから
// 読み、Brainfuckを出力する。BFCのinput()仕様に従い、NULを入力終端とする。

const cell MAX_NAME = 16;
const cell MAX_SYMBOLS = 16;
const cell MAX_SCOPES = 16;
const cell SCRATCH_BASE = 32;
const cell RESTORE_CELL = 63;

enum TokenKind {
    Eof,
    Identifier,
    Number,
    LeftParen,
    RightParen,
    LeftBrace,
    RightBrace,
    Semicolon,
    Assign,
    Plus,
    Minus,
    PlusAssign,
    MinusAssign
}

cell current_char;
TokenKind token_kind;
cell token_value;
cell token_length;
cell[MAX_NAME] token_text;

// Sixteen names of at most sixteen bytes exactly fill one addressable page.
cell[256] symbol_text;
cell[MAX_SYMBOLS] symbol_length;
cell[MAX_SYMBOLS] symbol_cell;
cell symbol_count;
cell[MAX_SCOPES] scope_base;
cell scope_depth;

// Position of the data pointer in the Brainfuck program being emitted.
cell target_position;
