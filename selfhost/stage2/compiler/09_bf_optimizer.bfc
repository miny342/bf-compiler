// A bounded suffix of BF IR, before either plain or BFCRLE serialization.
// '[' and ']' are barriers unless the retained body reduces to one odd Add.
// Evicting the oldest token only loses optimization opportunities, never code.
const cell BF_PENDING_CAPACITY = 16;
cell[16] bf_pending_kind;
WideValue[16] bf_pending_count;
cell bf_pending_head;
cell bf_pending_length;

void reset_bf_optimizer() {
    bf_pending_head = 0;
    bf_pending_length = 0;
}

cell bf_pending_index(cell offset) {
    cell index = bf_pending_head + offset;
    if (index >= BF_PENDING_CAPACITY) {
        index -= BF_PENDING_CAPACITY;
    }
    return index;
}

cell bf_wide_less(WideValue left, WideValue right) {
    return left.high < right.high || (left.high == right.high
        && (left.mid < right.mid || (left.mid == right.mid && left.low < right.low)));
}

void flush_bf_oldest() {
    cell kind = bf_pending_kind[bf_pending_head];
    WideValue count = bf_pending_count[bf_pending_head];
    if (kind == '+') {
        if (count.low <= 128) {
            write_bf_repeat_character('+', count.low);
        } else {
            write_bf_repeat_character('-', 0 - count.low);
        }
    } else if (kind == '>' || kind == '<') {
        write_bf_repeat_wide(kind, count);
    } else if (kind == 'c') {
        compiler_output!('[');
        compiler_output!('-');
        compiler_output!(']');
    } else {
        compiler_output!(kind);
    }
    bf_pending_head = bf_pending_index(1);
    bf_pending_length -= 1;
}

void flush_bf_optimizer() {
    while (bf_pending_length != 0) {
        flush_bf_oldest();
    }
}

void bf_pending_push(cell kind, WideValue count) {
    if (bf_pending_length == BF_PENDING_CAPACITY) {
        flush_bf_oldest();
    }
    cell index = bf_pending_index(bf_pending_length);
    bf_pending_kind[index] = kind;
    bf_pending_count[index] = count;
    bf_pending_length += 1;
}

// A run stays compact even for 24-bit global pointer displacements.
void emit_repeat_wide(cell character, WideValue count) {
    if (character == '+' || character == '-') {
        // Cell arithmetic wraps at 256, independently of the run's width.
        count.mid = 0;
        count.high = 0;
        if (character == '-') {
            count.low = 0 - count.low;
        }
        character = '+';
    }
    if (wide_is_zero(count)) {
        return;
    }
    if (bf_pending_length != 0) {
        cell index = bf_pending_index(bf_pending_length - 1);
        cell previous_kind = bf_pending_kind[index];
        WideValue previous = bf_pending_count[index];
        if (character == '+' && previous_kind == '+') {
            count.low += previous.low;
            bf_pending_count[index] = count;
            if (count.low == 0) {
                bf_pending_length -= 1;
            }
            return;
        }
        if ((character == '>' || character == '<')
            && (previous_kind == '>' || previous_kind == '<')) {
            if (character == previous_kind) {
                WideValue available;
                available.low = 255 - previous.low;
                available.mid = 255 - previous.mid;
                available.high = 255 - previous.high;
                if (bf_wide_less(available, count)) {
                    // Do not wrap or reject a legal stream on accumulator overflow.
                    flush_bf_optimizer();
                    bf_pending_push(character, count);
                    return;
                }
                count = wide_add(previous, count);
            } else if (bf_wide_less(previous, count)) {
                count = wide_subtract(count, previous);
            } else {
                count = wide_subtract(previous, count);
                character = previous_kind;
            }
            bf_pending_kind[index] = character;
            bf_pending_count[index] = count;
            if (wide_is_zero(count)) {
                bf_pending_length -= 1;
            }
            return;
        }
    }
    bf_pending_push(character, count);
}

void emit_repeat_character(cell character, cell count) {
    emit_repeat_wide(character, wide_from_cell(count));
}

void emit_bf_character(cell character) {
    if (character == '+' || character == '-' || character == '>' || character == '<') {
        emit_repeat_character(character, 1);
        return;
    }
    if (character == ']' && bf_pending_length >= 2) {
        cell last = bf_pending_index(bf_pending_length - 1);
        cell before = bf_pending_index(bf_pending_length - 2);
        if (bf_pending_kind[before] == '[' && bf_pending_kind[last] == '+') {
            WideValue count = bf_pending_count[last];
            // Odd additions visit every byte value and always terminate at zero.
            if (count.low >= 128) { count.low -= 128; }
            if (count.low >= 64) { count.low -= 64; }
            if (count.low >= 32) { count.low -= 32; }
            if (count.low >= 16) { count.low -= 16; }
            if (count.low >= 8) { count.low -= 8; }
            if (count.low >= 4) { count.low -= 4; }
            if (count.low >= 2) { count.low -= 2; }
            if (count.low == 1) {
                bf_pending_length -= 2;
                character = 'c';
            }
        }
    }
    if (character == 'c' || character == ',') {
        cell removing = 1;
        while (removing && bf_pending_length != 0) {
            cell last = bf_pending_index(bf_pending_length - 1);
            cell kind = bf_pending_kind[last];
            if (kind == '+' || (character == ',' && kind == 'c')) {
                bf_pending_length -= 1;
            } else if (character == 'c' && kind == 'c') {
                return;
            } else {
                removing = 0;
            }
        }
    }
    if (character == '.' || character == ',') {
        flush_bf_optimizer();
        compiler_output!(character);
        return;
    }
    bf_pending_push(character, wide_from_cell(0));
}
