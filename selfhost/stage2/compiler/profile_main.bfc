// Compressed selfhost output with lightweight continuation/ABI profile comments.
const cell COMPRESSED_BF_OUTPUT = 1;
const cell PROFILE_BF_OUTPUT = 1;

void read_character() {
    current_char = input();
}

macro compiler_output(value) {
    output(value);
}

void main() {
    output('@'); output('B'); output('F'); output('C');
    output('R'); output('L'); output('E'); output('2'); output(';');
    compile_program_stage12();
}
