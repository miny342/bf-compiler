// 第11段階surface syntaxをstreaming token列からfull AST arenaへ構築する。

const cell AST_TYPE_VOID = 0;
const cell AST_TYPE_CELL = 1;
const cell AST_TYPE_ARRAY = 2;
const cell AST_UNARY_PLUS = 0;
const cell AST_UNARY_NEGATE = 1;
const cell AST_UNARY_NOT = 2;
const cell AST_BINARY_ADD = 0;
const cell AST_BINARY_SUBTRACT = 1;
const cell AST_BINARY_LESS = 2;
const cell AST_BINARY_LESS_EQUAL = 3;
const cell AST_BINARY_GREATER = 4;
const cell AST_BINARY_GREATER_EQUAL = 5;
const cell AST_BINARY_EQUAL = 6;
const cell AST_BINARY_NOT_EQUAL = 7;
const cell AST_BINARY_LOGICAL_AND = 8;
const cell AST_BINARY_LOGICAL_OR = 9;
const cell AST_ASSIGNMENT_SET = 0;
const cell AST_ASSIGNMENT_ADD = 1;
const cell AST_ASSIGNMENT_SUBTRACT = 2;
const cell AST_DECLARATION_SCALAR = 0;
const cell AST_DECLARATION_ARRAY = 1;
const cell ARRAY_LENGTH_LITERAL = 0;
const cell ARRAY_LENGTH_256 = 1;
const cell ARRAY_LENGTH_CONSTANT = 2;

void append_ast_type(NodeId ty) {
    if (node_is_null(first_type)) {
        first_type = ty;
    } else {
        node_set_next(last_type, ty);
    }
    last_type = ty;
}

NodeId find_named_type_or_null(NodeId name) {
    NodeId ty = first_type;
    while (!node_is_null(ty)) {
        if (node_tag(ty) != TYPE_ARRAY && !node_is_null(node_name(ty))
            && node_equals(node_name(ty), name)) {
            return ty;
        }
        ty = node_next(ty);
    }
    return null_node();
}

NodeId get_or_create_named_type(NodeId name) {
    NodeId ty = find_named_type_or_null(name);
    if (!node_is_null(ty)) {
        return ty;
    }
    ty = allocate_node(NODE_TYPE);
    node_set_name(ty, name);
    append_ast_type(ty);
    return ty;
}

cell token_is_known_type() {
    NodeId ty = first_type;
    while (!node_is_null(ty)) {
        if (node_tag(ty) != TYPE_ARRAY && !node_is_null(node_name(ty))
            && token_matches_name(node_name(ty))) {
            return 1;
        }
        ty = node_next(ty);
    }
    return 0;
}

NodeId make_array_type(
    NodeId element,
    cell length,
    cell length_kind,
    NodeId length_name
) {
    NodeId existing = first_type;
    while (!node_is_null(existing)) {
        if (node_tag(existing) == TYPE_ARRAY
            && node_equals(node_a(existing), element)
            && arena_read(existing, FIELD_C_PAGE) == length
            && arena_read(existing, FIELD_C_SLOT) == length_kind
            && node_equals(node_name(existing), length_name)) {
            return existing;
        }
        existing = node_next(existing);
    }
    NodeId ty = allocate_node(NODE_TYPE);
    node_set_tag(ty, TYPE_ARRAY);
    node_set_a(ty, element);
    arena_write(ty, FIELD_C_PAGE, length);
    arena_write(ty, FIELD_C_SLOT, length_kind);
    node_set_name(ty, length_name);
    append_ast_type(ty);
    return ty;
}

NodeId parse_ast_complete_type(cell allow_void, cell allow_inferred) {
    if (token_kind != TokenKind::Identifier) {
        fail();
    }
    NodeId ty;
    if (token_is_void()) {
        if (!allow_void) {
            fail();
        }
        ty = void_type;
        next_token();
        return ty;
    }
    if (token_is_cell()) {
        ty = cell_type;
    } else {
        if (token_is_reserved()) {
            fail();
        }
        ty = get_or_create_named_type(intern_token_name());
    }
    next_token();

    cell[16] lengths;
    cell[16] length_kinds;
    NodeId[16] length_names;
    cell dimension_count;
    while (token_kind == TokenKind::LeftBracket) {
        if (dimension_count == 16) {
            fail();
        }
        next_token();
        if (token_kind == TokenKind::RightBracket) {
            if (!allow_inferred || !node_equals(ty, cell_type)
                || dimension_count != 0) {
                fail();
            }
            next_token();
            if (token_kind == TokenKind::LeftBracket) {
                fail();
            }
            return inferred_type;
        }
        if (token_kind == TokenKind::Number) {
            lengths[dimension_count] = token_value;
            if (token_number_is_256) {
                length_kinds[dimension_count] = ARRAY_LENGTH_256;
            }
        } else if (token_kind == TokenKind::Identifier
            && !token_is_reserved()) {
            length_kinds[dimension_count] = ARRAY_LENGTH_CONSTANT;
            length_names[dimension_count] = intern_token_name();
        } else {
            fail();
        }
        dimension_count += 1;
        next_token();
        consume(TokenKind::RightBracket);
    }
    while (dimension_count != 0) {
        dimension_count -= 1;
        ty = make_array_type(
            ty,
            lengths[dimension_count],
            length_kinds[dimension_count],
            length_names[dimension_count]
        );
    }
    return ty;
}

cell parser_type_class(NodeId ty) {
    if (node_equals(ty, void_type)) {
        return AST_TYPE_VOID;
    }
    if (node_equals(ty, cell_type) || node_tag(ty) == TYPE_ENUM) {
        return AST_TYPE_CELL;
    }
    return AST_TYPE_ARRAY;
}

NodeId parse_ast_expression() {
    return parse_ast_logical_or();
}

NodeId make_unary(cell operator, NodeId operand) {
    NodeId result = allocate_node(NODE_UNARY_EXPRESSION);
    node_set_tag(result, operator);
    node_set_a(result, operand);
    return result;
}

NodeId make_binary(cell operator, NodeId left, NodeId right) {
    NodeId result = allocate_node(NODE_BINARY_EXPRESSION);
    node_set_tag(result, operator);
    node_set_a(result, left);
    node_set_b(result, right);
    return result;
}

NodeId parse_ast_call(NodeId name) {
    NodeId call = allocate_node(NODE_CALL_EXPRESSION);
    node_set_name(call, name);
    consume(TokenKind::LeftParen);
    NodeId first;
    NodeId last;
    if (token_kind != TokenKind::RightParen) {
        cell more = 1;
        while (more) {
            NodeId argument = parse_ast_expression();
            if (node_is_null(first)) {
                first = argument;
            } else {
                node_set_next(last, argument);
            }
            last = argument;
            if (token_kind == TokenKind::Comma) {
                next_token();
            } else {
                more = 0;
            }
        }
    }
    consume(TokenKind::RightParen);
    node_set_a(call, first);
    return call;
}

NodeId parse_ast_primary() {
    if (token_kind == TokenKind::Number) {
        if (token_number_is_256) {
            fail();
        }
        NodeId result = allocate_node(NODE_LITERAL_EXPRESSION);
        node_set_value(result, token_value);
        next_token();
        return result;
    }
    if (token_kind == TokenKind::String) {
        NodeId result = allocate_node(NODE_STRING_EXPRESSION);
        node_set_value(result, token_string_length);
        arena_write(result, FIELD_NAME_PAGE, token_string_is_256);
        NodeId start;
        if (token_string_is_256) {
            start = allocate_cells(0xff);
            NodeId final_byte = allocate_cells(1);
        } else if (token_string_length != 0) {
            start = allocate_cells(token_string_length);
        }
        node_set_a(result, start);
        NodeId byte = start;
        cell index;
        while (index < token_string_length) {
            arena_cells[byte.page][byte.slot] = token_string[index];
            byte = arena_advance(byte, 1);
            index += 1;
        }
        if (token_string_is_256) {
            while (index != 0xff) {
                arena_cells[byte.page][byte.slot] = token_string[index];
                byte = arena_advance(byte, 1);
                index += 1;
            }
            arena_cells[byte.page][byte.slot] = token_string[0xff];
        }
        node_set_c(result, make_array_type(
            cell_type,
            token_string_length,
            token_string_is_256,
            null_node()
        ));
        next_token();
        return result;
    }
    if (token_kind == TokenKind::Identifier) {
        if (token_is_input()) {
            NodeId result = allocate_node(NODE_INPUT_EXPRESSION);
            next_token();
            consume(TokenKind::LeftParen);
            consume(TokenKind::RightParen);
            return result;
        }
        if (token_is_len()) {
            NodeId result = allocate_node(NODE_LEN_EXPRESSION);
            next_token();
            consume(TokenKind::LeftParen);
            node_set_a(result, parse_ast_expression());
            consume(TokenKind::RightParen);
            return result;
        }
        NodeId name = intern_token_name();
        next_token();
        if (token_kind == TokenKind::ColonColon) {
            next_token();
            if (token_kind != TokenKind::Identifier || token_is_reserved()) {
                fail();
            }
            NodeId result = allocate_node(NODE_ENUM_EXPRESSION);
            node_set_name(result, name);
            node_set_a(result, intern_token_name());
            next_token();
            return result;
        }
        if (token_kind == TokenKind::LeftParen) {
            return parse_ast_call(name);
        }
        NodeId result = allocate_node(NODE_NAME_EXPRESSION);
        node_set_name(result, name);
        return result;
    }
    if (token_kind == TokenKind::LeftParen) {
        next_token();
        NodeId result = parse_ast_expression();
        consume(TokenKind::RightParen);
        return result;
    }
    fail();
    return null_node();
}

NodeId parse_ast_postfix() {
    NodeId result = parse_ast_primary();
    cell more = 1;
    while (more) {
        if (token_kind == TokenKind::LeftBracket) {
            next_token();
            NodeId index = allocate_node(NODE_INDEX_EXPRESSION);
            node_set_a(index, result);
            node_set_b(index, parse_ast_expression());
            consume(TokenKind::RightBracket);
            result = index;
        } else if (token_kind == TokenKind::Dot) {
            next_token();
            if (token_kind != TokenKind::Identifier || token_is_reserved()) {
                fail();
            }
            NodeId field = allocate_node(NODE_FIELD_EXPRESSION);
            node_set_a(field, result);
            node_set_name(field, intern_token_name());
            next_token();
            result = field;
        } else {
            more = 0;
        }
    }
    return result;
}

NodeId parse_ast_unary() {
    if (token_kind == TokenKind::Bang) {
        next_token();
        return make_unary(AST_UNARY_NOT, parse_ast_unary());
    }
    if (token_kind == TokenKind::Plus) {
        next_token();
        return make_unary(AST_UNARY_PLUS, parse_ast_unary());
    }
    if (token_kind == TokenKind::Minus) {
        next_token();
        return make_unary(AST_UNARY_NEGATE, parse_ast_unary());
    }
    return parse_ast_postfix();
}

NodeId parse_ast_additive() {
    NodeId result = parse_ast_unary();
    while (token_kind == TokenKind::Plus || token_kind == TokenKind::Minus) {
        TokenKind operator = token_kind;
        next_token();
        NodeId right = parse_ast_unary();
        if (operator == TokenKind::Plus) {
            result = make_binary(AST_BINARY_ADD, result, right);
        } else {
            result = make_binary(AST_BINARY_SUBTRACT, result, right);
        }
    }
    return result;
}

NodeId parse_ast_comparison() {
    NodeId result = parse_ast_additive();
    while (token_kind == TokenKind::Less || token_kind == TokenKind::LessEqual
        || token_kind == TokenKind::Greater || token_kind == TokenKind::GreaterEqual) {
        TokenKind operator = token_kind;
        next_token();
        NodeId right = parse_ast_additive();
        cell ast_operator = AST_BINARY_LESS;
        if (operator == TokenKind::LessEqual) {
            ast_operator = AST_BINARY_LESS_EQUAL;
        } else if (operator == TokenKind::Greater) {
            ast_operator = AST_BINARY_GREATER;
        } else if (operator == TokenKind::GreaterEqual) {
            ast_operator = AST_BINARY_GREATER_EQUAL;
        }
        result = make_binary(ast_operator, result, right);
    }
    return result;
}

NodeId parse_ast_equality() {
    NodeId result = parse_ast_comparison();
    while (token_kind == TokenKind::EqualEqual || token_kind == TokenKind::BangEqual) {
        TokenKind operator = token_kind;
        next_token();
        NodeId right = parse_ast_comparison();
        if (operator == TokenKind::EqualEqual) {
            result = make_binary(AST_BINARY_EQUAL, result, right);
        } else {
            result = make_binary(AST_BINARY_NOT_EQUAL, result, right);
        }
    }
    return result;
}

NodeId parse_ast_logical_and() {
    NodeId result = parse_ast_equality();
    while (token_kind == TokenKind::AmpAmp) {
        next_token();
        result = make_binary(
            AST_BINARY_LOGICAL_AND,
            result,
            parse_ast_equality()
        );
    }
    return result;
}

NodeId parse_ast_logical_or() {
    NodeId result = parse_ast_logical_and();
    while (token_kind == TokenKind::PipePipe) {
        next_token();
        result = make_binary(
            AST_BINARY_LOGICAL_OR,
            result,
            parse_ast_logical_and()
        );
    }
    return result;
}

NodeId parse_ast_statement() {
    if (token_kind == TokenKind::Semicolon) {
        next_token();
        return allocate_node(NODE_EMPTY_STATEMENT);
    }
    if (token_kind == TokenKind::LeftBrace) {
        next_token();
        NodeId block = allocate_node(NODE_BLOCK);
        NodeId first;
        NodeId last;
        while (token_kind != TokenKind::RightBrace) {
            if (token_kind == TokenKind::Eof) {
                fail();
            }
            NodeId statement = parse_ast_statement();
            if (node_is_null(first)) {
                first = statement;
            } else {
                node_set_next(last, statement);
            }
            last = statement;
        }
        next_token();
        node_set_a(block, first);
        return block;
    }
    if (token_kind == TokenKind::Identifier
        && (token_is_cell() || token_is_known_type())) {
        NodeId declaration_type = parse_ast_complete_type(0, 1);
        if (token_kind != TokenKind::Identifier || token_is_reserved()) {
            fail();
        }
        NodeId declaration = allocate_node(NODE_DECLARATION);
        node_set_b(declaration, declaration_type);
        node_set_name(declaration, intern_token_name());
        next_token();
        if (token_kind == TokenKind::Assign) {
            next_token();
            node_set_a(declaration, parse_ast_expression());
        }
        consume(TokenKind::Semicolon);
        return declaration;
    }
    if (token_kind == TokenKind::Identifier && token_is_output()) {
        next_token();
        consume(TokenKind::LeftParen);
        NodeId statement = allocate_node(NODE_OUTPUT_STATEMENT);
        node_set_a(statement, parse_ast_expression());
        consume(TokenKind::RightParen);
        consume(TokenKind::Semicolon);
        return statement;
    }
    if (token_kind == TokenKind::Identifier && token_is_return()) {
        next_token();
        NodeId statement = allocate_node(NODE_RETURN_STATEMENT);
        if (token_kind != TokenKind::Semicolon) {
            node_set_a(statement, parse_ast_expression());
        }
        consume(TokenKind::Semicolon);
        return statement;
    }
    if (token_kind == TokenKind::Identifier && token_is_if()) {
        next_token();
        consume(TokenKind::LeftParen);
        NodeId statement = allocate_node(NODE_IF_STATEMENT);
        node_set_a(statement, parse_ast_expression());
        consume(TokenKind::RightParen);
        node_set_b(statement, parse_ast_statement());
        if (token_kind == TokenKind::Identifier && token_is_else()) {
            next_token();
            node_set_c(statement, parse_ast_statement());
        }
        return statement;
    }
    if (token_kind == TokenKind::Identifier && token_is_while()) {
        next_token();
        consume(TokenKind::LeftParen);
        NodeId statement = allocate_node(NODE_WHILE_STATEMENT);
        node_set_a(statement, parse_ast_expression());
        consume(TokenKind::RightParen);
        node_set_b(statement, parse_ast_statement());
        return statement;
    }

    NodeId left = parse_ast_expression();
    if (token_kind == TokenKind::Assign || token_kind == TokenKind::PlusAssign
        || token_kind == TokenKind::MinusAssign) {
        if (node_kind(left) != NODE_NAME_EXPRESSION
            && node_kind(left) != NODE_INDEX_EXPRESSION
            && node_kind(left) != NODE_FIELD_EXPRESSION) {
            fail();
        }
        TokenKind operator = token_kind;
        next_token();
        NodeId statement = allocate_node(NODE_ASSIGNMENT);
        node_set_a(statement, left);
        node_set_b(statement, parse_ast_expression());
        if (operator == TokenKind::PlusAssign) {
            node_set_tag(statement, AST_ASSIGNMENT_ADD);
        } else if (operator == TokenKind::MinusAssign) {
            node_set_tag(statement, AST_ASSIGNMENT_SUBTRACT);
        }
        consume(TokenKind::Semicolon);
        return statement;
    }
    if (node_kind(left) != NODE_CALL_EXPRESSION) {
        fail();
    }
    consume(TokenKind::Semicolon);
    NodeId statement = allocate_node(NODE_CALL_STATEMENT);
    node_set_a(statement, left);
    return statement;
}

NodeId parse_ast_function_after_name(
    NodeId return_type,
    NodeId name
) {
    NodeId function = allocate_node(NODE_FUNCTION);
    node_set_tag(function, parser_type_class(return_type));
    node_set_c(function, return_type);
    node_set_name(function, name);
    consume(TokenKind::LeftParen);

    NodeId first_parameter;
    NodeId last_parameter;
    if (token_kind != TokenKind::RightParen) {
        cell more = 1;
        while (more) {
            NodeId parameter_type = parse_ast_complete_type(0, 0);
            if (token_kind != TokenKind::Identifier || token_is_reserved()) {
                fail();
            }
            NodeId parameter = allocate_node(NODE_PARAMETER);
            node_set_b(parameter, parameter_type);
            node_set_name(parameter, intern_token_name());
            next_token();
            if (node_is_null(first_parameter)) {
                first_parameter = parameter;
            } else {
                node_set_next(last_parameter, parameter);
            }
            last_parameter = parameter;
            if (token_kind == TokenKind::Comma) {
                next_token();
            } else {
                more = 0;
            }
        }
    }
    consume(TokenKind::RightParen);
    node_set_a(function, first_parameter);
    node_set_b(function, parse_ast_statement());
    if (node_kind(node_b(function)) != NODE_BLOCK) {
        fail();
    }
    return function;
}

void append_ast_function(NodeId function) {
    if (node_is_null(first_function)) {
        first_function = function;
    } else {
        node_set_next(last_function, function);
    }
    last_function = function;
}

void append_ast_global(NodeId global) {
    if (node_is_null(first_global)) {
        first_global = global;
    } else {
        node_set_next(last_global, global);
    }
    last_global = global;
}

void append_ast_constant(NodeId constant) {
    if (node_is_null(first_constant)) {
        first_constant = constant;
    } else {
        node_set_next(last_constant, constant);
    }
    last_constant = constant;
}

void parse_ast_constant_definition() {
    next_token();
    if (token_kind != TokenKind::Identifier || !token_is_cell()) {
        fail();
    }
    next_token();
    if (token_kind != TokenKind::Identifier || token_is_reserved()) {
        fail();
    }
    NodeId constant = allocate_node(NODE_CONSTANT);
    node_set_name(constant, intern_token_name());
    next_token();
    consume(TokenKind::Assign);
    node_set_a(constant, parse_ast_expression());
    consume(TokenKind::Semicolon);
    append_ast_constant(constant);
}

void parse_ast_enum_definition() {
    next_token();
    if (token_kind != TokenKind::Identifier || token_is_reserved()) {
        fail();
    }
    NodeId ty = get_or_create_named_type(intern_token_name());
    if (node_tag(ty) != TYPE_UNRESOLVED) {
        fail();
    }
    node_set_tag(ty, TYPE_ENUM);
    next_token();
    consume(TokenKind::LeftBrace);
    NodeId first;
    NodeId last;
    if (token_kind == TokenKind::RightBrace) {
        fail();
    }
    cell more = 1;
    while (more) {
        if (token_kind != TokenKind::Identifier || token_is_reserved()) {
            fail();
        }
        NodeId variant = allocate_node(NODE_ENUM_VARIANT);
        node_set_name(variant, intern_token_name());
        next_token();
        if (token_kind == TokenKind::Assign) {
            next_token();
            node_set_a(variant, parse_ast_expression());
        }
        if (node_is_null(first)) {
            first = variant;
        } else {
            node_set_next(last, variant);
        }
        last = variant;
        if (token_kind == TokenKind::Comma) {
            next_token();
            if (token_kind == TokenKind::RightBrace) {
                more = 0;
            }
        } else {
            more = 0;
        }
    }
    consume(TokenKind::RightBrace);
    node_set_a(ty, first);
}

void parse_ast_struct_definition() {
    next_token();
    if (token_kind != TokenKind::Identifier || token_is_reserved()) {
        fail();
    }
    NodeId ty = get_or_create_named_type(intern_token_name());
    if (node_tag(ty) != TYPE_UNRESOLVED) {
        fail();
    }
    node_set_tag(ty, TYPE_STRUCT);
    next_token();
    consume(TokenKind::LeftBrace);
    NodeId first;
    NodeId last;
    while (token_kind != TokenKind::RightBrace) {
        if (token_kind == TokenKind::Eof) {
            fail();
        }
        NodeId field_type = parse_ast_complete_type(0, 0);
        if (token_kind != TokenKind::Identifier || token_is_reserved()) {
            fail();
        }
        NodeId field = allocate_node(NODE_STRUCT_FIELD);
        node_set_a(field, field_type);
        node_set_name(field, intern_token_name());
        next_token();
        consume(TokenKind::Semicolon);
        if (node_is_null(first)) {
            first = field;
        } else {
            node_set_next(last, field);
        }
        last = field;
    }
    next_token();
    if (node_is_null(first)) {
        fail();
    }
    node_set_a(ty, first);
}

void parse_ast_top_level_item() {
    if (token_kind == TokenKind::Identifier && token_is_const()) {
        parse_ast_constant_definition();
        return;
    }
    if (token_kind == TokenKind::Identifier && token_is_enum()) {
        parse_ast_enum_definition();
        return;
    }
    if (token_kind == TokenKind::Identifier && token_is_struct()) {
        parse_ast_struct_definition();
        return;
    }
    NodeId value_type = parse_ast_complete_type(1, 1);
    if (token_kind != TokenKind::Identifier || token_is_reserved()) {
        fail();
    }
    NodeId name = intern_token_name();
    next_token();

    if (token_kind == TokenKind::LeftParen) {
        if (node_equals(value_type, inferred_type)) {
            fail();
        }
        append_ast_function(
            parse_ast_function_after_name(value_type, name)
        );
        return;
    }

    if (node_equals(value_type, void_type)) {
        fail();
    }
    NodeId global = allocate_node(NODE_GLOBAL);
    node_set_b(global, value_type);
    node_set_name(global, name);
    if (token_kind == TokenKind::Assign) {
        next_token();
        node_set_a(global, parse_ast_expression());
    }
    consume(TokenKind::Semicolon);
    append_ast_global(global);
}

void parse_ast_program() {
    reset_ast_arena();
    read_character();
    next_token();
    while (token_kind != TokenKind::Eof) {
        parse_ast_top_level_item();
    }
}
