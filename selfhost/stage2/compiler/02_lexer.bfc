// input()から1 byteずつ読み進めるstreaming lexer。

void skip_trivia() {
    cell again = 1;
    while (again) {
        again = 0;
        while (is_space(current_char)) {
            read_character();
        }

        if (current_char == '/') {
            read_character();
            if (current_char == '/') {
                while (current_char != 0
                    && current_char != '\n'
                    && current_char != '\r') {
                    read_character();
                }
                again = 1;
            } else if (current_char == '*') {
                read_character();
                cell closed;
                while (!closed) {
                    if (current_char == 0) {
                        fail('A', 'B');
                    }
                    if (current_char == '*') {
                        read_character();
                        if (current_char == '/') {
                            read_character();
                            closed = 1;
                        }
                    } else {
                        read_character();
                    }
                }
                again = 1;
            } else {
                // Division is not part of stages 1 through 3.
                fail('A', 'C');
            }
        }
    }
}

void read_name() {
    token_length = 0;
    while (is_name_continue(current_char)) {
        if (token_length == MAX_NAME) {
            fail('A', 'D');
        }
        token_text[token_length] = current_char;
        token_length += 1;
        read_character();
    }
    token_kind = TokenKind::Identifier;
}

void read_number() {
    token_value = 0;
    token_number_is_256 = 0;
    if (current_char == '0') {
        read_character();
        if (current_char == 'x' || current_char == 'X') {
            read_character();
            if (!is_hex_digit(current_char)) {
                fail('A', 'E');
            }
            while (is_hex_digit(current_char)) {
                cell digit = hex_digit_value(current_char);
                // Tokenization preserves exactly 256 for an array length.
                if (token_number_is_256 || token_value > 16
                    || (token_value == 16 && digit != 0)) {
                    fail('A', 'F');
                }
                if (token_value == 16) {
                    token_value = 0;
                    token_number_is_256 = 1;
                } else {
                    token_value = times_sixteen(token_value) + digit;
                }
                read_character();
            }
            if (is_name_continue(current_char)) {
                fail('A', 'G');
            }
            token_kind = TokenKind::Number;
            return;
        }
    }

    while (is_digit(current_char)) {
        cell digit = current_char - '0';
        if (token_number_is_256 || token_value > 25
            || (token_value == 25 && digit > 6)) {
            fail('A', 'H');
        }
        if (token_value == 25 && digit == 6) {
            token_value = 0;
            token_number_is_256 = 1;
        } else {
            token_value = times_ten(token_value) + digit;
        }
        read_character();
    }
    if (is_name_continue(current_char)) {
        fail('A', 'I');
    }
    token_kind = TokenKind::Number;
}

cell read_escape() {
    cell value;
    if (current_char == 'n') {
        value = '\n';
    } else if (current_char == 'r') {
        value = '\r';
    } else if (current_char == 't') {
        value = '\t';
    } else if (current_char == '0') {
        value = 0;
    } else if (current_char == '\\') {
        value = '\\';
    } else if (current_char == '\'') {
        value = '\'';
    } else if (current_char == 'x') {
        read_character();
        if (!is_hex_digit(current_char)) {
            fail('A', 'J');
        }
        value = times_sixteen(hex_digit_value(current_char));
        read_character();
        if (!is_hex_digit(current_char)) {
            fail('A', 'K');
        }
        value += hex_digit_value(current_char);
        return value;
    } else {
        fail('A', 'L');
    }
    return value;
}

void read_character_literal() {
    // Consume the opening quote.
    read_character();
    if (current_char == 0 || current_char == '\n' || current_char == '\r') {
        fail('A', 'M');
    }

    if (current_char == '\\') {
        read_character();
        token_value = read_escape();
    } else {
        if (current_char < 32 || current_char > 126 || current_char == '\'') {
            fail('A', 'N');
        }
        token_value = current_char;
    }

    read_character();
    if (current_char != '\'') {
        fail('A', 'O');
    }
    read_character();
    token_kind = TokenKind::Number;
    token_number_is_256 = 0;
}

void append_string_byte(cell value) {
    if (token_string_is_256) {
        fail('A', 'P');
    }
    token_string[token_string_length] = value;
    if (token_string_length == 0xff) {
        token_string_length = 0;
        token_string_is_256 = 1;
    } else {
        token_string_length += 1;
    }
}

void read_string_literal() {
    token_string_length = 0;
    token_string_is_256 = 0;
    read_character();
    while (current_char != '"') {
        if (current_char == 0 || current_char == '\n'
            || current_char == '\r') {
            fail('A', 'Q');
        }
        cell value;
        if (current_char == '\\') {
            read_character();
            if (current_char == '"') {
                value = '"';
            } else {
                value = read_escape();
            }
        } else {
            if (current_char < 32 || current_char > 126) {
                fail('A', 'R');
            }
            value = current_char;
        }
        append_string_byte(value);
        read_character();
    }
    read_character();
    token_kind = TokenKind::String;
}

void next_token() {
    skip_trivia();
    token_length = 0;
    token_number_is_256 = 0;

    if (current_char == 0) {
        token_kind = TokenKind::Eof;
    } else if (is_name_start(current_char)) {
        read_name();
    } else if (is_digit(current_char)) {
        read_number();
    } else if (current_char == '\'') {
        read_character_literal();
    } else if (current_char == '"') {
        read_string_literal();
    } else if (current_char == '(') {
        token_kind = TokenKind::LeftParen;
        read_character();
    } else if (current_char == ')') {
        token_kind = TokenKind::RightParen;
        read_character();
    } else if (current_char == '{') {
        token_kind = TokenKind::LeftBrace;
        read_character();
    } else if (current_char == '}') {
        token_kind = TokenKind::RightBrace;
        read_character();
    } else if (current_char == '[') {
        token_kind = TokenKind::LeftBracket;
        read_character();
    } else if (current_char == ']') {
        token_kind = TokenKind::RightBracket;
        read_character();
    } else if (current_char == ',') {
        token_kind = TokenKind::Comma;
        read_character();
    } else if (current_char == ';') {
        token_kind = TokenKind::Semicolon;
        read_character();
    } else if (current_char == '=') {
        read_character();
        if (current_char == '=') {
            token_kind = TokenKind::EqualEqual;
            read_character();
        } else {
            token_kind = TokenKind::Assign;
        }
    } else if (current_char == '!') {
        read_character();
        if (current_char == '=') {
            token_kind = TokenKind::BangEqual;
            read_character();
        } else {
            token_kind = TokenKind::Bang;
        }
    } else if (current_char == '+') {
        read_character();
        if (current_char == '=') {
            token_kind = TokenKind::PlusAssign;
            read_character();
        } else {
            token_kind = TokenKind::Plus;
        }
    } else if (current_char == '-') {
        read_character();
        if (current_char == '=') {
            token_kind = TokenKind::MinusAssign;
            read_character();
        } else {
            token_kind = TokenKind::Minus;
        }
    } else if (current_char == '<') {
        read_character();
        if (current_char == '=') {
            token_kind = TokenKind::LessEqual;
            read_character();
        } else {
            token_kind = TokenKind::Less;
        }
    } else if (current_char == '>') {
        read_character();
        if (current_char == '=') {
            token_kind = TokenKind::GreaterEqual;
            read_character();
        } else {
            token_kind = TokenKind::Greater;
        }
    } else if (current_char == '&') {
        read_character();
        if (current_char != '&') {
            fail('A', 'S');
        }
        token_kind = TokenKind::AmpAmp;
        read_character();
    } else if (current_char == '|') {
        read_character();
        if (current_char != '|') {
            fail('A', 'T');
        }
        token_kind = TokenKind::PipePipe;
        read_character();
    } else if (current_char == '.') {
        token_kind = TokenKind::Dot;
        read_character();
    } else if (current_char == ':') {
        read_character();
        if (current_char != ':') {
            fail('A', 'U');
        }
        token_kind = TokenKind::ColonColon;
        read_character();
    } else {
        fail('A', 'V');
    }
}
