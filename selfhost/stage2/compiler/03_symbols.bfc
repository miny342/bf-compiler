// keyword判定と、block scopeを持つscalar symbol table。

cell token_is_cell() {
    return token_length == 4
        && token_text[0] == 'c' && token_text[1] == 'e'
        && token_text[2] == 'l' && token_text[3] == 'l';
}

cell token_is_void() {
    return token_length == 4
        && token_text[0] == 'v' && token_text[1] == 'o'
        && token_text[2] == 'i' && token_text[3] == 'd';
}

cell token_is_input() {
    return token_length == 5
        && token_text[0] == 'i' && token_text[1] == 'n'
        && token_text[2] == 'p' && token_text[3] == 'u'
        && token_text[4] == 't';
}

cell token_is_output() {
    return token_length == 6
        && token_text[0] == 'o' && token_text[1] == 'u'
        && token_text[2] == 't' && token_text[3] == 'p'
        && token_text[4] == 'u' && token_text[5] == 't';
}

cell token_is_if() {
    return token_length == 2
        && token_text[0] == 'i' && token_text[1] == 'f';
}

cell token_is_else() {
    return token_length == 4
        && token_text[0] == 'e' && token_text[1] == 'l'
        && token_text[2] == 's' && token_text[3] == 'e';
}

cell token_is_while() {
    return token_length == 5
        && token_text[0] == 'w' && token_text[1] == 'h'
        && token_text[2] == 'i' && token_text[3] == 'l'
        && token_text[4] == 'e';
}

cell token_is_return() {
    return token_length == 6
        && token_text[0] == 'r' && token_text[1] == 'e'
        && token_text[2] == 't' && token_text[3] == 'u'
        && token_text[4] == 'r' && token_text[5] == 'n';
}

cell token_is_enum() {
    return token_length == 4
        && token_text[0] == 'e' && token_text[1] == 'n'
        && token_text[2] == 'u' && token_text[3] == 'm';
}

cell token_is_struct() {
    return token_length == 6
        && token_text[0] == 's' && token_text[1] == 't'
        && token_text[2] == 'r' && token_text[3] == 'u'
        && token_text[4] == 'c' && token_text[5] == 't';
}

cell token_is_const() {
    return token_length == 5
        && token_text[0] == 'c' && token_text[1] == 'o'
        && token_text[2] == 'n' && token_text[3] == 's'
        && token_text[4] == 't';
}

cell token_is_len() {
    return token_length == 3
        && token_text[0] == 'l' && token_text[1] == 'e'
        && token_text[2] == 'n';
}

cell token_is_macro() {
    return token_length == 5
        && token_text[0] == 'm' && token_text[1] == 'a'
        && token_text[2] == 'c' && token_text[3] == 'r'
        && token_text[4] == 'o';
}

cell token_is_abort() {
    return token_length == 5
        && token_text[0] == 'a' && token_text[1] == 'b'
        && token_text[2] == 'o' && token_text[3] == 'r'
        && token_text[4] == 't';
}

cell token_is_reserved() {
    return token_is_cell() || token_is_void()
        || token_is_input() || token_is_output()
        || token_is_if() || token_is_else() || token_is_while()
        || token_is_return() || token_is_enum() || token_is_struct()
        || token_is_const() || token_is_len()
        || token_is_macro() || token_is_abort();
}

void consume(TokenKind expected) {
    if (token_kind != expected) {
        fail('A', 'Z');
    }
    next_token();
}
