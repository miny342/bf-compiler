// 内部回帰testだけで使う旧第4段階direct codegen helper。

cell emit_copy(cell position, cell source, cell destination) {
    position = emit_clear(position, destination);
    position = emit_clear(position, RESTORE_CELL);

    position = emit_move_to(position, source);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_move_to(position, destination);
    compiler_output!('+');
    position = emit_move_to(position, RESTORE_CELL);
    compiler_output!('+');
    position = emit_move_to(position, source);
    compiler_output!(']');

    position = emit_move_to(position, RESTORE_CELL);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_move_to(position, source);
    compiler_output!('+');
    position = emit_move_to(position, RESTORE_CELL);
    compiler_output!(']');
    return position;
}

void check_scratch(cell destination) {
    if (destination >= RESTORE_CELL) {
        fail('B', 'A');
    }
}

cell allocate_control_pair() {
    if (control_depth == MAX_CONTROL_DEPTH) {
        fail('B', 'B');
    }
    cell first = CONTROL_BASE + control_depth + control_depth;
    control_depth += 1;
    return first;
}

void release_control_pair() {
    control_depth -= 1;
}

cell emit_booleanize(cell position, cell destination) {
    cell temporary = destination + 1;
    check_scratch(temporary);
    position = emit_clear(position, temporary);
    position = emit_loop_open(position, destination);
    position = emit_clear(position, destination);
    position = emit_move_to(position, temporary);
    compiler_output!('+');
    position = emit_loop_close(position, destination);
    position = emit_transfer(position, temporary, destination, 0);
    return position;
}

cell emit_not(cell position, cell destination) {
    cell flag = destination + 1;
    check_scratch(flag);
    position = emit_constant(position, flag, 1);
    position = emit_loop_open(position, destination);
    position = emit_clear(position, destination);
    position = emit_clear(position, flag);
    position = emit_loop_close(position, destination);
    position = emit_transfer(position, flag, destination, 0);
    return position;
}

// `left < right`をunsigned cell比較として生成する。両operandを消費し、
// resultをleftへ置く。mod 256の減算結果だけを見る実装では0と255を
// 正しく比較できないため、rightを数え下げながらleftの枯渇を検出する。
cell emit_less(cell position, cell left, cell right) {
    cell condition = right + 1;
    cell otherwise = right + 2;
    cell result = right + 3;
    check_scratch(result);
    position = emit_clear(position, result);

    position = emit_loop_open(position, right);
    position = emit_move_to(position, right);
    compiler_output!('-');
    position = emit_copy(position, left, condition);
    position = emit_booleanize(position, condition);
    position = emit_constant(position, otherwise, 1);

    position = emit_loop_open(position, condition);
    position = emit_clear(position, condition);
    position = emit_clear(position, otherwise);
    position = emit_move_to(position, left);
    compiler_output!('-');
    position = emit_loop_close(position, condition);

    position = emit_loop_open(position, otherwise);
    position = emit_clear(position, otherwise);
    position = emit_constant(position, result, 1);
    position = emit_clear(position, right);
    position = emit_loop_close(position, otherwise);
    position = emit_loop_close(position, right);

    position = emit_clear(position, left);
    position = emit_transfer(position, result, left, 0);
    return position;
}

cell emit_swap(cell position, cell left, cell right) {
    cell temporary = right + 1;
    check_scratch(temporary);
    position = emit_clear(position, temporary);
    position = emit_transfer(position, left, temporary, 0);
    position = emit_transfer(position, right, left, 0);
    position = emit_transfer(position, temporary, right, 0);
    return position;
}
