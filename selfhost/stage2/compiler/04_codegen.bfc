// target Brainfuckのdata pointer位置を追跡しながらprimitiveを出力する。

cell target_position;

void emit_move_to(cell destination) {
    if (target_position < destination) {
        emit_repeat_character('>', destination - target_position);
    }
    if (target_position > destination) {
        emit_repeat_character('<', target_position - destination);
    }
    target_position = destination;
}

void emit_clear(cell destination) {
    emit_move_to(destination);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_bf_character(']');
}

void emit_constant(cell destination, cell value) {
    emit_clear(destination);
    emit_repeat_character('+', value);
}

void emit_input(cell destination) {
    emit_move_to(destination);
    emit_bf_character(',');
}

void emit_transfer(cell source, cell destination, cell subtract) {
    emit_move_to(source);
    emit_bf_character('[');
    emit_bf_character('-');
    emit_move_to(destination);
    if (subtract) {
        emit_bf_character('-');
    } else {
        emit_bf_character('+');
    }
    emit_move_to(source);
    emit_bf_character(']');
}

void emit_loop_open(cell condition) {
    emit_move_to(condition);
    emit_bf_character('[');
}

void emit_loop_close(cell condition) {
    emit_move_to(condition);
    emit_bf_character(']');
}
