// target Brainfuckのdata pointer位置を追跡しながらprimitiveを出力する。

cell emit_move_to(cell position, cell destination) {
    cell tmp = position;
    if (tmp < destination) {
        emit_repeat_character('>', destination - tmp);
    } else if (tmp > destination) {
        emit_repeat_character('<', tmp - destination);
    }
    return destination;
}

cell emit_clear(cell position, cell destination) {
    position = emit_move_to(position, destination);
    compiler_output!('[');
    compiler_output!('-');
    compiler_output!(']');
    return position;
}

cell emit_constant(cell position, cell destination, cell value) {
    position = emit_clear(position, destination);
    if (value <= 128) {
        emit_repeat_character('+', value);
    } else {
        emit_repeat_character('-', 0 - value);
    }
    return position;
}

cell emit_input(cell position, cell destination) {
    position = emit_move_to(position, destination);
    compiler_output!(',');
    return position;
}

cell emit_transfer(
    cell position,
    cell source,
    cell destination,
    cell subtract
) {
    position = emit_move_to(position, source);
    compiler_output!('[');
    compiler_output!('-');
    position = emit_move_to(position, destination);
    if (subtract) {
        compiler_output!('-');
    } else {
        compiler_output!('+');
    }
    position = emit_move_to(position, source);
    compiler_output!(']');
    return position;
}

cell emit_loop_open(cell position, cell condition) {
    position = emit_move_to(position, condition);
    compiler_output!('[');
    return position;
}

cell emit_loop_close(cell position, cell condition) {
    position = emit_move_to(position, condition);
    compiler_output!(']');
    return position;
}
