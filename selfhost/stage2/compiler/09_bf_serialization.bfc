// Emit BF runs immediately, without a peephole buffer or cross-call state.
// BFCRLE2 serialization uses lowercase hexadecimal run counts.

macro emit_hex_digit(value) {
    if (value < 10) {
        compiler_output!('0' + value);
    } else {
        compiler_output!('a' + value - 10);
    }
}

macro emit_hex_byte(value, fixed_width) {
    cell high_nibble = 0;
    if (value >= 128) {
        value -= 128;
        high_nibble += 8;
    }
    if (value >= 64) {
        value -= 64;
        high_nibble += 4;
    }
    if (value >= 32) {
        value -= 32;
        high_nibble += 2;
    }
    if (value >= 16) {
        value -= 16;
        high_nibble += 1;
    }
    if (fixed_width || high_nibble != 0) {
        emit_hex_digit!(high_nibble);
    }
    emit_hex_digit!(value);
}

// Repetition helpers are for the BF run commands +, -, < and > only.
void emit_repeat_character(cell character, cell count) {
    if (COMPRESSED_BF_OUTPUT) {
        if (count != 0) {
            compiler_output!(character);
            if (count != 1) {
                emit_hex_byte!(count, 0);
            }
        }
        return;
    }
    while (count != 0) {
        compiler_output!(character);
        count -= 1;
    }
}

void emit_repeat_256(cell character) {
    if (COMPRESSED_BF_OUTPUT) {
        compiler_output!(character);
        compiler_output!('1'); compiler_output!('0'); compiler_output!('0');
        return;
    }
    cell count;
    compiler_output!(character);
    count = 1;
    while (count != 0) {
        compiler_output!(character);
        count += 1;
    }
}

void emit_repeat_65536(cell character) {
    if (COMPRESSED_BF_OUTPUT) {
        compiler_output!(character);
        compiler_output!('1'); compiler_output!('0'); compiler_output!('0');
        compiler_output!('0'); compiler_output!('0');
        return;
    }
    cell count;
    emit_repeat_256(character);
    count = 1;
    while (count != 0) {
        emit_repeat_256(character);
        count += 1;
    }
}

void emit_repeat_wide(cell character, WideValue count) {
    if (COMPRESSED_BF_OUTPUT) {
        if (count.high == 0 && count.mid == 0) {
            emit_repeat_character(character, count.low);
            return;
        }
        compiler_output!(character);
        emit_hex_byte!(count.high, 1);
        emit_hex_byte!(count.mid, 1);
        emit_hex_byte!(count.low, 1);
        return;
    }
    while (count.high != 0) {
        emit_repeat_65536(character);
        count.high -= 1;
    }
    while (count.mid != 0) {
        emit_repeat_256(character);
        count.mid -= 1;
    }
    emit_repeat_character(character, count.low);
}
