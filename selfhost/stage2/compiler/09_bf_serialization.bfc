// Emit BF runs immediately, without a peephole buffer or cross-call state.
// BFCRLE serialization matches the simple output path before 4f3a2b9.

// Repetition helpers are for the BF run commands +, -, < and > only.
void emit_repeat_character(cell character, cell count) {
    if (COMPRESSED_BF_OUTPUT) {
        if (count != 0) {
            compiler_output!(character);
            if (count != 1) {
                cell hundreds;
                cell tens;
                while (count >= 100) {
                    count -= 100;
                    hundreds += 1;
                }
                while (count >= 10) {
                    count -= 10;
                    tens += 1;
                }
                if (hundreds != 0) {
                    compiler_output!('0' + hundreds);
                }
                if (hundreds != 0 || tens != 0) {
                    compiler_output!('0' + tens);
                }
                compiler_output!('0' + count);
            }
        }
        return;
    }
    while (count != 0) {
        compiler_output!(character);
        count -= 1;
    }
}

void emit_repeat_256(cell character) {
    if (COMPRESSED_BF_OUTPUT) {
        compiler_output!(character);
        compiler_output!('2'); compiler_output!('5'); compiler_output!('6');
        return;
    }
    cell count;
    compiler_output!(character);
    count = 1;
    while (count != 0) {
        compiler_output!(character);
        count += 1;
    }
}

void emit_repeat_65536(cell character) {
    if (COMPRESSED_BF_OUTPUT) {
        compiler_output!(character);
        compiler_output!('6'); compiler_output!('5'); compiler_output!('5');
        compiler_output!('3'); compiler_output!('6');
        return;
    }
    cell count;
    emit_repeat_256(character);
    count = 1;
    while (count != 0) {
        emit_repeat_256(character);
        count += 1;
    }
}

// Emit one fixed-width decimal digit and return the remainder. Leading zeros
// are legal in BFCRLE; fixed width avoids a mutable cross-call output state.
WideValue emit_repeat_decimal_digit(WideValue count, cell low, cell mid, cell high) {
    WideValue place;
    place.low = low;
    place.mid = mid;
    place.high = high;
    cell digit = '0';
    while (count.high > high || (count.high == high &&
        (count.mid > mid || (count.mid == mid && count.low >= low)))) {
        count = wide_subtract(count, place);
        digit += 1;
    }
    compiler_output!(digit);
    return count;
}

void emit_repeat_wide(cell character, WideValue count) {
    if (COMPRESSED_BF_OUTPUT) {
        if (count.high == 0 && count.mid == 0) {
            emit_repeat_character(character, count.low);
            return;
        }
        compiler_output!(character);
        // Little-endian base-256 digits of 10^7, 10^6, ..., 10^0.
        count = emit_repeat_decimal_digit(count, 128, 150, 152);
        count = emit_repeat_decimal_digit(count, 64, 66, 15);
        count = emit_repeat_decimal_digit(count, 160, 134, 1);
        count = emit_repeat_decimal_digit(count, 16, 39, 0);
        count = emit_repeat_decimal_digit(count, 232, 3, 0);
        count = emit_repeat_decimal_digit(count, 100, 0, 0);
        count = emit_repeat_decimal_digit(count, 10, 0, 0);
        count = emit_repeat_decimal_digit(count, 1, 0, 0);
        return;
    }
    while (count.high != 0) {
        emit_repeat_65536(character);
        count.high -= 1;
    }
    while (count.mid != 0) {
        emit_repeat_256(character);
        count.mid -= 1;
    }
    emit_repeat_character(character, count.low);
}
