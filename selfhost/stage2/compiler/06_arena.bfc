// ASTと後続IRで共有する16-bit handleとpacked arena。
// 一つのcell[256][256] regionへnode recordとidentifier byteを置く。
// fieldごとに巨大なglobal regionを作ると、absolute pointer移動を埋め込む
// backendでは生成BF自体が数GBになるため、regionを一つに保つ。

const cell NODE_CELLS = 13;
const cell ARENA_LAST_PAGE = 15;
const cell FIELD_KIND = 0;
const cell FIELD_TAG = 1;
const cell FIELD_VALUE = 2;
const cell FIELD_NAME_PAGE = 3;
const cell FIELD_NAME_SLOT = 4;
const cell FIELD_A_PAGE = 5;
const cell FIELD_A_SLOT = 6;
const cell FIELD_B_PAGE = 7;
const cell FIELD_B_SLOT = 8;
const cell FIELD_C_PAGE = 9;
const cell FIELD_C_SLOT = 10;
const cell FIELD_NEXT_PAGE = 11;
const cell FIELD_NEXT_SLOT = 12;
const cell FIELD_DISPATCH_LOW = 13;
const cell FIELD_DISPATCH_HIGH = 14;

struct NodeId {
    cell page;
    cell slot;
}

const cell NODE_NULL = 0;
const cell NODE_NAME_RECORD = 1;
const cell NODE_FUNCTION = 2;
const cell NODE_PARAMETER = 3;
const cell NODE_BLOCK = 4;
const cell NODE_EMPTY_STATEMENT = 5;
const cell NODE_DECLARATION = 6;
const cell NODE_OUTPUT_STATEMENT = 7;
const cell NODE_ASSIGNMENT = 8;
const cell NODE_IF_STATEMENT = 9;
const cell NODE_WHILE_STATEMENT = 10;
const cell NODE_RETURN_STATEMENT = 11;
const cell NODE_CALL_STATEMENT = 12;
const cell NODE_LITERAL_EXPRESSION = 13;
const cell NODE_NAME_EXPRESSION = 14;
const cell NODE_INPUT_EXPRESSION = 15;
const cell NODE_CALL_EXPRESSION = 16;
const cell NODE_UNARY_EXPRESSION = 17;
const cell NODE_BINARY_EXPRESSION = 18;
const cell NODE_FUNCTION_DESCRIPTOR = 19;
const cell NODE_CONTINUATION = 20;
const cell NODE_INSTRUCTION = 21;
const cell NODE_CALL_ARGUMENT = 22;
const cell NODE_INDEX_EXPRESSION = 23;
const cell NODE_GLOBAL = 24;
const cell NODE_TYPE = 25;
const cell NODE_ENUM_VARIANT = 26;
const cell NODE_STRUCT_FIELD = 27;
const cell NODE_FIELD_EXPRESSION = 28;
const cell NODE_ENUM_EXPRESSION = 29;
const cell NODE_STRING_EXPRESSION = 30;
const cell NODE_LEN_EXPRESSION = 31;
const cell NODE_CONSTANT = 32;

const cell TYPE_UNRESOLVED = 0;
const cell TYPE_CELL = 1;
const cell TYPE_VOID = 2;
const cell TYPE_ENUM = 3;
const cell TYPE_STRUCT = 4;
const cell TYPE_ARRAY = 5;
const cell TYPE_INFERRED = 6;

cell[16][256] arena_cells;
NodeId arena_next;
cell arena_exhausted;
NodeId first_name;
NodeId last_name;
NodeId first_function;
NodeId last_function;
NodeId first_global;
NodeId last_global;
NodeId first_type;
NodeId last_type;
NodeId cell_type;
NodeId void_type;
NodeId inferred_type;
NodeId first_constant;
NodeId last_constant;

NodeId null_node() {
    NodeId result;
    return result;
}

cell node_is_null(NodeId id) {
    return id.page == 0 && id.slot == 0;
}

cell node_equals(NodeId left, NodeId right) {
    return left.page == right.page && left.slot == right.slot;
}

NodeId arena_advance(NodeId position, cell amount) {
    while (amount != 0) {
        if (position.page == ARENA_LAST_PAGE && position.slot == 0xff) {
            fail();
        }
        if (position.slot == 0xff) {
            position.slot = 0;
            position.page += 1;
        } else {
            position.slot += 1;
        }
        amount -= 1;
    }
    return position;
}

NodeId node_field(NodeId id, cell field) {
    return arena_advance(id, field);
}

cell arena_read(NodeId id, cell field) {
    NodeId position = node_field(id, field);
    return arena_cells[position.page][position.slot];
}

void arena_write(NodeId id, cell field, cell value) {
    NodeId position = node_field(id, field);
    arena_cells[position.page][position.slot] = value;
}

void reset_ast_arena() {
    arena_next.page = 0;
    arena_next.slot = 1;
    arena_exhausted = 0;
    first_name = null_node();
    last_name = null_node();
    first_function = null_node();
    last_function = null_node();
    first_global = null_node();
    last_global = null_node();
    first_type = null_node();
    last_type = null_node();

    cell_type = allocate_node(NODE_TYPE);
    node_set_tag(cell_type, TYPE_CELL);
    node_set_value(cell_type, 1);
    first_type = cell_type;
    last_type = cell_type;

    void_type = allocate_node(NODE_TYPE);
    node_set_tag(void_type, TYPE_VOID);
    node_set_next(last_type, void_type);
    last_type = void_type;

    inferred_type = allocate_node(NODE_TYPE);
    node_set_tag(inferred_type, TYPE_INFERRED);
    first_constant = null_node();
    last_constant = null_node();
}

NodeId allocate_cells(cell count) {
    if (arena_exhausted || count == 0) {
        fail();
    }
    NodeId position = arena_next;
    NodeId result = position;
    while (count != 0) {
        arena_cells[position.page][position.slot] = 0;
        if (position.page == ARENA_LAST_PAGE && position.slot == 0xff) {
            arena_exhausted = 1;
            count -= 1;
            if (count != 0) {
                fail();
            }
        } else {
            position = arena_advance(position, 1);
            count -= 1;
        }
    }
    arena_next = position;
    return result;
}

NodeId allocate_node(cell kind) {
    NodeId result = allocate_cells(NODE_CELLS);
    arena_write(result, FIELD_KIND, kind);
    return result;
}

cell node_kind(NodeId id) {
    return arena_read(id, FIELD_KIND);
}

cell node_tag(NodeId id) {
    return arena_read(id, FIELD_TAG);
}

void node_set_tag(NodeId id, cell value) {
    arena_write(id, FIELD_TAG, value);
}

cell node_value(NodeId id) {
    return arena_read(id, FIELD_VALUE);
}

void node_set_value(NodeId id, cell value) {
    arena_write(id, FIELD_VALUE, value);
}

NodeId node_name(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_NAME_PAGE);
    result.slot = arena_read(id, FIELD_NAME_SLOT);
    return result;
}

void node_set_name(NodeId id, NodeId value) {
    arena_write(id, FIELD_NAME_PAGE, value.page);
    arena_write(id, FIELD_NAME_SLOT, value.slot);
}

NodeId node_a(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_A_PAGE);
    result.slot = arena_read(id, FIELD_A_SLOT);
    return result;
}

void node_set_a(NodeId id, NodeId value) {
    arena_write(id, FIELD_A_PAGE, value.page);
    arena_write(id, FIELD_A_SLOT, value.slot);
}

NodeId node_b(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_B_PAGE);
    result.slot = arena_read(id, FIELD_B_SLOT);
    return result;
}

void node_set_b(NodeId id, NodeId value) {
    arena_write(id, FIELD_B_PAGE, value.page);
    arena_write(id, FIELD_B_SLOT, value.slot);
}

NodeId node_c(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_C_PAGE);
    result.slot = arena_read(id, FIELD_C_SLOT);
    return result;
}

void node_set_c(NodeId id, NodeId value) {
    arena_write(id, FIELD_C_PAGE, value.page);
    arena_write(id, FIELD_C_SLOT, value.slot);
}

NodeId node_next(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_NEXT_PAGE);
    result.slot = arena_read(id, FIELD_NEXT_SLOT);
    return result;
}

void node_set_next(NodeId id, NodeId value) {
    arena_write(id, FIELD_NEXT_PAGE, value.page);
    arena_write(id, FIELD_NEXT_SLOT, value.slot);
}

cell token_matches_name(NodeId name) {
    if (node_value(name) != token_length) {
        return 0;
    }
    NodeId byte = node_a(name);
    cell index;
    while (index < token_length) {
        if (arena_cells[byte.page][byte.slot] != token_text[index]) {
            return 0;
        }
        byte = arena_advance(byte, 1);
        index += 1;
    }
    return 1;
}

NodeId intern_token_name() {
    NodeId probe = first_name;
    while (!node_is_null(probe)) {
        if (token_matches_name(probe)) {
            return probe;
        }
        probe = node_next(probe);
    }

    NodeId name = allocate_node(NODE_NAME_RECORD);
    node_set_value(name, token_length);
    NodeId start = allocate_cells(token_length);
    node_set_a(name, start);
    NodeId byte = start;
    cell index;
    while (index < token_length) {
        arena_cells[byte.page][byte.slot] = token_text[index];
        if (index + 1 < token_length) {
            byte = arena_advance(byte, 1);
        }
        index += 1;
    }

    if (node_is_null(first_name)) {
        first_name = name;
    } else {
        node_set_next(last_name, name);
    }
    last_name = name;
    return name;
}
