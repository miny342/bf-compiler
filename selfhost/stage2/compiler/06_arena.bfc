// ASTと後続IRで共有するbank/page/slot handleとpacked arena。
// 16個のcell[255][256] regionへnode recordとidentifier byteを置く。
// fieldごとに巨大なglobal regionを作ると、absolute pointer移動を埋め込む
// binary CIR経路では各regionをRust ABI backendのsegmentへ写す。
// nextと頻出fieldを前方へ置き、kindごとに最後に使うfieldまでだけを確保する。

const cell ARENA_LAST_BANK = 15;
const cell ARENA_LAST_PAGE = 254;
const cell FIELD_KIND = 0;
const cell FIELD_NEXT_PAGE = 1;
const cell FIELD_NEXT_SLOT = 2;
const cell FIELD_NEXT_BANK = 3;
const cell FIELD_A_PAGE = 4;
const cell FIELD_A_SLOT = 5;
const cell FIELD_A_BANK = 6;
const cell FIELD_TAG = 7;
const cell FIELD_VALUE = 8;
const cell FIELD_B_PAGE = 9;
const cell FIELD_B_SLOT = 10;
const cell FIELD_B_BANK = 11;
const cell FIELD_NAME_PAGE = 12;
const cell FIELD_NAME_SLOT = 13;
const cell FIELD_NAME_BANK = 14;
const cell FIELD_C_PAGE = 15;
const cell FIELD_C_SLOT = 16;
const cell FIELD_C_BANK = 17;
const cell FIELD_DISPATCH_LOW = 18;
const cell FIELD_DISPATCH_HIGH = 19;

struct NodeId {
    cell bank;
    cell page;
    cell slot;
}

struct WideValue {
    cell low;
    cell mid;
    cell high;
}

WideValue wide_from_cell(cell value) {
    WideValue result;
    result.low = value;
    return result;
}

cell wide_is_zero(WideValue value) {
    return value.low == 0 && value.mid == 0 && value.high == 0;
}

WideValue wide_add(WideValue left, WideValue right) {
    WideValue result;
    result.low = left.low + right.low;
    cell carry = result.low < left.low;
    result.mid = left.mid + right.mid;
    cell next_carry = result.mid < left.mid;
    cell before_carry = result.mid;
    result.mid += carry;
    if (result.mid < before_carry) {
        next_carry = 1;
    }
    result.high = left.high + right.high;
    if (result.high < left.high) {
        fail('B', 'L');
    }
    before_carry = result.high;
    result.high += next_carry;
    if (result.high < before_carry) {
        fail('B', 'M');
    }
    return result;
}

WideValue wide_subtract(WideValue left, WideValue right) {
    WideValue result;
    cell borrow = left.low < right.low;
    result.low = left.low - right.low;
    cell next_borrow = left.mid < right.mid;
    result.mid = left.mid - right.mid;
    if (borrow) {
        if (result.mid == 0) {
            next_borrow = 1;
        }
        result.mid -= 1;
    }
    if (left.high < right.high) {
        fail('B', 'N');
    }
    result.high = left.high - right.high;
    if (next_borrow) {
        if (result.high == 0) {
            fail('B', 'O');
        }
        result.high -= 1;
    }
    return result;
}

WideValue wide_multiply_length(
    WideValue value,
    cell length,
    cell length_is_256
) {
    WideValue result;
    cell index;
    if (length_is_256) {
        if (value.high != 0) {
            fail('I', 'B');
        }
        result.mid = value.low;
        result.high = value.mid;
    } else {
        while (index < length) {
            result = wide_add(result, value);
            index += 1;
        }
    }
    return result;
}

const cell NODE_NAME_RECORD = 1;
const cell NODE_FUNCTION = 2;
const cell NODE_PARAMETER = 3;
const cell NODE_BLOCK = 4;
const cell NODE_EMPTY_STATEMENT = 5;
const cell NODE_DECLARATION = 6;
const cell NODE_OUTPUT_STATEMENT = 7;
const cell NODE_ASSIGNMENT = 8;
const cell NODE_IF_STATEMENT = 9;
const cell NODE_WHILE_STATEMENT = 10;
const cell NODE_RETURN_STATEMENT = 11;
const cell NODE_CALL_STATEMENT = 12;
const cell NODE_LITERAL_EXPRESSION = 13;
const cell NODE_NAME_EXPRESSION = 14;
const cell NODE_INPUT_EXPRESSION = 15;
const cell NODE_CALL_EXPRESSION = 16;
const cell NODE_UNARY_EXPRESSION = 17;
const cell NODE_BINARY_EXPRESSION = 18;
const cell NODE_FUNCTION_DESCRIPTOR = 19;
const cell NODE_CONTINUATION = 20;
const cell NODE_INSTRUCTION = 21;
const cell NODE_CALL_ARGUMENT = 22;
const cell NODE_INDEX_EXPRESSION = 23;
const cell NODE_GLOBAL = 24;
const cell NODE_TYPE = 25;
const cell NODE_ENUM_VARIANT = 26;
const cell NODE_STRUCT_FIELD = 27;
const cell NODE_FIELD_EXPRESSION = 28;
const cell NODE_ENUM_EXPRESSION = 29;
const cell NODE_STRING_EXPRESSION = 30;
const cell NODE_LEN_EXPRESSION = 31;
const cell NODE_CONSTANT = 32;
const cell NODE_ABORT_STATEMENT = 33;
const cell NODE_MACRO_DEFINITION = 34;
const cell NODE_MACRO_PARAMETER = 35;
const cell NODE_MACRO_INVOCATION = 36;

const cell TYPE_UNRESOLVED = 0;
const cell TYPE_CELL = 1;
const cell TYPE_VOID = 2;
const cell TYPE_ENUM = 3;
const cell TYPE_STRUCT = 4;
const cell TYPE_ARRAY = 5;
const cell TYPE_INFERRED = 6;

cell[255][256] arena_cells_0;
cell[255][256] arena_cells_1;
cell[255][256] arena_cells_2;
cell[255][256] arena_cells_3;
cell[255][256] arena_cells_4;
cell[255][256] arena_cells_5;
cell[255][256] arena_cells_6;
cell[255][256] arena_cells_7;
cell[255][256] arena_cells_8;
cell[255][256] arena_cells_9;
cell[255][256] arena_cells_10;
cell[255][256] arena_cells_11;
cell[255][256] arena_cells_12;
cell[255][256] arena_cells_13;
cell[255][256] arena_cells_14;
cell[255][256] arena_cells_15;
NodeId arena_next;
cell arena_exhausted;
NodeId first_name;
NodeId last_name;
NodeId first_function;
NodeId last_function;
NodeId first_global;
NodeId last_global;
NodeId first_type;
NodeId last_type;
NodeId cell_type;
NodeId void_type;
NodeId inferred_type;
NodeId first_constant;
NodeId last_constant;
NodeId first_macro;
NodeId last_macro;

NodeId null_node() {
    NodeId result;
    return result;
}

cell node_is_null(NodeId id) {
    return id.bank == 0 && id.page == 0 && id.slot == 0;
}

cell node_equals(NodeId left, NodeId right) {
    return left.bank == right.bank
        && left.page == right.page && left.slot == right.slot;
}

NodeId arena_advance(NodeId position, cell amount) {
    // A byte-sized advance can cross at most one page boundary.
    cell slot = position.slot + amount;
    // Overflow makes the sum smaller than either operand. Compare against
    // amount to keep the BF countdown short for small field offsets.
    if (slot < amount) {
        if (position.page == ARENA_LAST_PAGE) {
            if (position.bank == ARENA_LAST_BANK) {
                fail('B', 'P');
            }
            position.page = 0;
            position.bank += 1;
        } else {
            position.page += 1;
        }
    }
    position.slot = slot;
    return position;
}

cell arena_read(NodeId id, cell field) {
    NodeId position = arena_advance(id, field);
    return arena_cell_read(position);
}

void arena_write(NodeId id, cell field, cell value) {
    NodeId position = arena_advance(id, field);
    arena_cell_write(position, value);
}

cell arena_cell_read(NodeId position) {
    if (position.bank == 0) {
        return arena_cells_0[position.page][position.slot];
    }
    if (position.bank == 1) {
        return arena_cells_1[position.page][position.slot];
    }
    if (position.bank == 2) {
        return arena_cells_2[position.page][position.slot];
    }
    if (position.bank == 3) {
        return arena_cells_3[position.page][position.slot];
    }
    if (position.bank == 4) {
        return arena_cells_4[position.page][position.slot];
    }
    if (position.bank == 5) {
        return arena_cells_5[position.page][position.slot];
    }
    if (position.bank == 6) {
        return arena_cells_6[position.page][position.slot];
    }
    if (position.bank == 7) {
        return arena_cells_7[position.page][position.slot];
    }
    if (position.bank == 8) {
        return arena_cells_8[position.page][position.slot];
    }
    if (position.bank == 9) {
        return arena_cells_9[position.page][position.slot];
    }
    if (position.bank == 10) {
        return arena_cells_10[position.page][position.slot];
    }
    if (position.bank == 11) {
        return arena_cells_11[position.page][position.slot];
    }
    if (position.bank == 12) {
        return arena_cells_12[position.page][position.slot];
    }
    if (position.bank == 13) {
        return arena_cells_13[position.page][position.slot];
    }
    if (position.bank == 14) {
        return arena_cells_14[position.page][position.slot];
    }
    if (position.bank == 15) {
        return arena_cells_15[position.page][position.slot];
    }
    fail('B', 'Q');
    return 0;
}

void arena_cell_write(NodeId position, cell value) {
    if (position.bank == 0) {
        arena_cells_0[position.page][position.slot] = value;
    } else if (position.bank == 1) {
        arena_cells_1[position.page][position.slot] = value;
    } else if (position.bank == 2) {
        arena_cells_2[position.page][position.slot] = value;
    } else if (position.bank == 3) {
        arena_cells_3[position.page][position.slot] = value;
    } else if (position.bank == 4) {
        arena_cells_4[position.page][position.slot] = value;
    } else if (position.bank == 5) {
        arena_cells_5[position.page][position.slot] = value;
    } else if (position.bank == 6) {
        arena_cells_6[position.page][position.slot] = value;
    } else if (position.bank == 7) {
        arena_cells_7[position.page][position.slot] = value;
    } else if (position.bank == 8) {
        arena_cells_8[position.page][position.slot] = value;
    } else if (position.bank == 9) {
        arena_cells_9[position.page][position.slot] = value;
    } else if (position.bank == 10) {
        arena_cells_10[position.page][position.slot] = value;
    } else if (position.bank == 11) {
        arena_cells_11[position.page][position.slot] = value;
    } else if (position.bank == 12) {
        arena_cells_12[position.page][position.slot] = value;
    } else if (position.bank == 13) {
        arena_cells_13[position.page][position.slot] = value;
    } else if (position.bank == 14) {
        arena_cells_14[position.page][position.slot] = value;
    } else if (position.bank == 15) {
        arena_cells_15[position.page][position.slot] = value;
    } else {
        fail('B', 'R');
    }
}

void reset_ast_arena() {
    arena_next.bank = 0;
    arena_next.page = 0;
    arena_next.slot = 1;
    arena_exhausted = 0;
    first_name = null_node();
    last_name = null_node();
    first_function = null_node();
    last_function = null_node();
    first_global = null_node();
    last_global = null_node();
    first_type = null_node();
    last_type = null_node();

    cell_type = allocate_node(NODE_TYPE);
    node_set_tag(cell_type, TYPE_CELL);
    node_set_value(cell_type, 1);
    first_type = cell_type;
    last_type = cell_type;

    void_type = allocate_node(NODE_TYPE);
    node_set_tag(void_type, TYPE_VOID);
    node_set_next(last_type, void_type);
    last_type = void_type;

    inferred_type = allocate_node(NODE_TYPE);
    node_set_tag(inferred_type, TYPE_INFERRED);
    first_constant = null_node();
    last_constant = null_node();
    first_macro = null_node();
    last_macro = null_node();
}

NodeId allocate_cells(cell count) {
    if (arena_exhausted || count == 0) {
        fail('B', 'S');
    }
    NodeId position = arena_next;
    NodeId result = position;
    while (count != 0) {
        arena_cell_write(position, 0);
        if (position.bank == ARENA_LAST_BANK
            && position.page == ARENA_LAST_PAGE && position.slot == 0xff) {
            arena_exhausted = 1;
            count -= 1;
            if (count != 0) {
                fail('B', 'T');
            }
        } else {
            position = arena_advance(position, 1);
            count -= 1;
        }
    }
    arena_next = position;
    return result;
}

cell node_cell_count(cell kind) {
    if (kind == NODE_EMPTY_STATEMENT || kind == NODE_INPUT_EXPRESSION
        || kind == NODE_ABORT_STATEMENT) {
        return 4;
    }
    if (kind == NODE_BLOCK || kind == NODE_OUTPUT_STATEMENT
        || kind == NODE_RETURN_STATEMENT || kind == NODE_CALL_STATEMENT) {
        return 7;
    }
    if (kind == NODE_UNARY_EXPRESSION) {
        return 8;
    }
    if (kind == NODE_LITERAL_EXPRESSION) {
        return 5;
    }
    if (kind == NODE_NAME_RECORD || kind == NODE_LEN_EXPRESSION) {
        return 9;
    }
    if (kind == NODE_CALL_ARGUMENT) {
        return 10;
    }
    if (kind == NODE_ASSIGNMENT || kind == NODE_WHILE_STATEMENT
        || kind == NODE_BINARY_EXPRESSION) {
        return 12;
    }
    if (kind == NODE_INSTRUCTION) {
        return 18;
    }
    if (kind == NODE_CALL_EXPRESSION
        || kind == NODE_FUNCTION_DESCRIPTOR || kind == NODE_ENUM_VARIANT
        || kind == NODE_STRUCT_FIELD || kind == NODE_ENUM_EXPRESSION
        || kind == NODE_STRING_EXPRESSION || kind == NODE_CONSTANT
        || kind == NODE_MACRO_DEFINITION || kind == NODE_MACRO_PARAMETER
        || kind == NODE_MACRO_INVOCATION) {
        return 15;
    }
    if (kind == NODE_PARAMETER || kind == NODE_DECLARATION) {
        return 16;
    }
    if (kind == NODE_FUNCTION || kind == NODE_IF_STATEMENT
        || kind == NODE_TYPE) {
        return 18;
    }
    if (kind == NODE_CONTINUATION || kind == NODE_GLOBAL
        || kind == NODE_NAME_EXPRESSION || kind == NODE_INDEX_EXPRESSION
        || kind == NODE_FIELD_EXPRESSION) {
        return 20;
    }
    fail('B', 'U');
    return 0;
}

cell release_last_node(NodeId id) {
    cell kind = node_kind(id);
    NodeId after = arena_advance(id, node_cell_count(kind));
    if (!node_equals(after, arena_next)) {
        return 0;
    }
    arena_next = id;
    arena_exhausted = 0;
    return 1;
}

NodeId allocate_node(cell kind) {
    NodeId result = allocate_cells(node_cell_count(kind));
    arena_write(result, FIELD_KIND, kind);
    return result;
}

cell node_kind(NodeId id) {
    return arena_read(id, FIELD_KIND);
}

cell node_tag(NodeId id) {
    return arena_read(id, FIELD_TAG);
}

void node_set_tag(NodeId id, cell value) {
    arena_write(id, FIELD_TAG, value);
}

cell node_value(NodeId id) {
    return arena_read(id, FIELD_VALUE);
}

cell literal_value(NodeId id) {
    return arena_read(id, FIELD_A_PAGE);
}

void set_literal_value(NodeId id, cell value) {
    arena_write(id, FIELD_A_PAGE, value);
}

void node_set_value(NodeId id, cell value) {
    arena_write(id, FIELD_VALUE, value);
}

NodeId node_name(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_NAME_PAGE);
    result.slot = arena_read(id, FIELD_NAME_SLOT);
    result.bank = arena_read(id, FIELD_NAME_BANK);
    return result;
}

void node_set_name(NodeId id, NodeId value) {
    arena_write(id, FIELD_NAME_PAGE, value.page);
    arena_write(id, FIELD_NAME_SLOT, value.slot);
    arena_write(id, FIELD_NAME_BANK, value.bank);
}

NodeId node_a(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_A_PAGE);
    result.slot = arena_read(id, FIELD_A_SLOT);
    result.bank = arena_read(id, FIELD_A_BANK);
    return result;
}

void node_set_a(NodeId id, NodeId value) {
    arena_write(id, FIELD_A_PAGE, value.page);
    arena_write(id, FIELD_A_SLOT, value.slot);
    arena_write(id, FIELD_A_BANK, value.bank);
}

NodeId node_b(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_B_PAGE);
    result.slot = arena_read(id, FIELD_B_SLOT);
    result.bank = arena_read(id, FIELD_B_BANK);
    return result;
}

void node_set_b(NodeId id, NodeId value) {
    arena_write(id, FIELD_B_PAGE, value.page);
    arena_write(id, FIELD_B_SLOT, value.slot);
    arena_write(id, FIELD_B_BANK, value.bank);
}

NodeId node_c(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_C_PAGE);
    result.slot = arena_read(id, FIELD_C_SLOT);
    result.bank = arena_read(id, FIELD_C_BANK);
    return result;
}

void node_set_c(NodeId id, NodeId value) {
    arena_write(id, FIELD_C_PAGE, value.page);
    arena_write(id, FIELD_C_SLOT, value.slot);
    arena_write(id, FIELD_C_BANK, value.bank);
}

NodeId node_next(NodeId id) {
    NodeId result;
    result.page = arena_read(id, FIELD_NEXT_PAGE);
    result.slot = arena_read(id, FIELD_NEXT_SLOT);
    result.bank = arena_read(id, FIELD_NEXT_BANK);
    return result;
}

void node_set_next(NodeId id, NodeId value) {
    arena_write(id, FIELD_NEXT_PAGE, value.page);
    arena_write(id, FIELD_NEXT_SLOT, value.slot);
    arena_write(id, FIELD_NEXT_BANK, value.bank);
}

cell token_matches_name(NodeId name) {
    if (node_value(name) != token_length) {
        return 0;
    }
    NodeId byte = node_a(name);
    cell index;
    while (index < token_length) {
        if (arena_cell_read(byte) != token_text[index]) {
            return 0;
        }
        byte = arena_advance(byte, 1);
        index += 1;
    }
    return 1;
}

NodeId intern_token_name() {
    NodeId probe = first_name;
    while (!node_is_null(probe)) {
        if (token_matches_name(probe)) {
            return probe;
        }
        probe = node_next(probe);
    }

    NodeId name = allocate_node(NODE_NAME_RECORD);
    node_set_value(name, token_length);
    NodeId start = allocate_cells(token_length);
    node_set_a(name, start);
    NodeId byte = start;
    cell index;
    while (index < token_length) {
        arena_cell_write(byte, token_text[index]);
        if (index + 1 < token_length) {
            byte = arena_advance(byte, 1);
        }
        index += 1;
    }

    if (node_is_null(first_name)) {
        first_name = name;
    } else {
        node_set_next(last_name, name);
    }
    last_name = name;
    return name;
}
