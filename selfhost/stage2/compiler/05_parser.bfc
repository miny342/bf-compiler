// 第1〜4段階の式、宣言、代入、制御構文を解析しながらBFを生成する。

cell parse_primary(cell position, cell destination) {
    check_scratch(destination);
    if (token_kind == TokenKind::Number) {
        position = emit_constant(position, destination, token_value);
        next_token();
    } else if (token_kind == TokenKind::Identifier) {
        if (token_is_input()) {
            next_token();
            consume(TokenKind::LeftParen);
            consume(TokenKind::RightParen);
            position = emit_input(position, destination);
        } else {
            cell source = find_symbol();
            next_token();
            position = emit_copy(position, source, destination);
        }
    } else if (token_kind == TokenKind::LeftParen) {
        next_token();
        position = parse_expression(position, destination);
        consume(TokenKind::RightParen);
    } else {
        fail('B', 'C');
    }
    return position;
}

cell parse_unary(cell position, cell destination) {
    check_scratch(destination);
    if (token_kind == TokenKind::Bang) {
        next_token();
        position = parse_unary(position, destination);
        position = emit_not(position, destination);
    } else if (token_kind == TokenKind::Plus) {
        next_token();
        position = parse_unary(position, destination);
    } else if (token_kind == TokenKind::Minus) {
        next_token();
        position = emit_clear(position, destination);
        position = parse_unary(position, destination + 1);
        position = emit_transfer(position, destination + 1, destination, 1);
    } else {
        position = parse_primary(position, destination);
    }
    return position;
}

cell parse_additive(cell position, cell destination) {
    position = parse_unary(position, destination);
    while (token_kind == TokenKind::Plus || token_kind == TokenKind::Minus) {
        TokenKind operator = token_kind;
        next_token();
        position = parse_unary(position, destination + 1);
        position = emit_transfer(
            position,
            destination + 1,
            destination,
            operator == TokenKind::Minus
        );
    }
    return position;
}

cell parse_comparison(cell position, cell destination) {
    position = parse_additive(position, destination);
    while (token_kind == TokenKind::Less
        || token_kind == TokenKind::LessEqual
        || token_kind == TokenKind::Greater
        || token_kind == TokenKind::GreaterEqual) {
        TokenKind operator = token_kind;
        next_token();
        position = parse_additive(position, destination + 1);
        if (operator == TokenKind::Less || operator == TokenKind::GreaterEqual) {
            position = emit_less(position, destination, destination + 1);
        } else {
            position = emit_swap(position, destination, destination + 1);
            position = emit_less(position, destination, destination + 1);
        }
        if (operator == TokenKind::LessEqual
            || operator == TokenKind::GreaterEqual) {
            position = emit_not(position, destination);
        }
    }
    return position;
}

cell parse_equality(cell position, cell destination) {
    position = parse_comparison(position, destination);
    while (token_kind == TokenKind::EqualEqual
        || token_kind == TokenKind::BangEqual) {
        TokenKind operator = token_kind;
        next_token();
        position = parse_comparison(position, destination + 1);
        position = emit_transfer(position, destination + 1, destination, 1);
        if (operator == TokenKind::EqualEqual) {
            position = emit_not(position, destination);
        } else {
            position = emit_booleanize(position, destination);
        }
    }
    return position;
}

cell parse_logical_and(cell position, cell destination) {
    position = parse_equality(position, destination);
    while (token_kind == TokenKind::AmpAmp) {
        next_token();
        position = emit_booleanize(position, destination);
        cell guard = allocate_control_pair();
        position = emit_clear(position, guard);
        position = emit_transfer(position, destination, guard, 0);
        position = emit_loop_open(position, guard);
        position = emit_clear(position, guard);
        position = parse_equality(position, destination);
        position = emit_booleanize(position, destination);
        position = emit_loop_close(position, guard);
        release_control_pair();
    }
    return position;
}

cell parse_expression(cell position, cell destination) {
    position = parse_logical_and(position, destination);
    while (token_kind == TokenKind::PipePipe) {
        next_token();
        position = emit_booleanize(position, destination);
        cell guard = allocate_control_pair();
        cell otherwise = guard + 1;
        position = emit_copy(position, destination, guard);
        position = emit_constant(position, otherwise, 1);
        position = emit_loop_open(position, guard);
        position = emit_clear(position, guard);
        position = emit_clear(position, otherwise);
        position = emit_loop_close(position, guard);
        position = emit_loop_open(position, otherwise);
        position = emit_clear(position, otherwise);
        position = parse_logical_and(position, destination);
        position = emit_booleanize(position, destination);
        position = emit_loop_close(position, otherwise);
        release_control_pair();
    }
    return position;
}

cell parse_declaration(cell position) {
    // The current token is "cell".
    next_token();
    if (token_kind != TokenKind::Identifier) {
        fail('B', 'D');
    }
    cell destination = add_symbol();
    next_token();

    // A declaration executes zero initialization even when its tape cell was
    // previously used by a local from a completed nested block.
    position = emit_clear(position, destination);
    if (token_kind == TokenKind::Assign) {
        next_token();
        position = parse_expression(position, SCRATCH_BASE);
        position = emit_clear(position, destination);
        position = emit_transfer(position, SCRATCH_BASE, destination, 0);
    }
    consume(TokenKind::Semicolon);
    return position;
}

cell parse_output_statement(cell position) {
    next_token();
    consume(TokenKind::LeftParen);
    position = parse_expression(position, SCRATCH_BASE);
    consume(TokenKind::RightParen);
    consume(TokenKind::Semicolon);
    position = emit_move_to(position, SCRATCH_BASE);
    compiler_output!('.');
    return position;
}

cell parse_assignment(cell position) {
    cell destination = find_symbol();
    next_token();
    TokenKind operator = token_kind;
    if (operator != TokenKind::Assign
        && operator != TokenKind::PlusAssign
        && operator != TokenKind::MinusAssign) {
        fail('B', 'E');
    }
    next_token();
    position = parse_expression(position, SCRATCH_BASE);
    consume(TokenKind::Semicolon);

    if (operator == TokenKind::Assign) {
        position = emit_clear(position, destination);
        position = emit_transfer(position, SCRATCH_BASE, destination, 0);
    } else {
        position = emit_transfer(
            position,
            SCRATCH_BASE,
            destination,
            operator == TokenKind::MinusAssign
        );
    }
    return position;
}

cell parse_if_statement(cell position) {
    next_token();
    consume(TokenKind::LeftParen);
    position = parse_expression(position, SCRATCH_BASE);
    consume(TokenKind::RightParen);

    position = emit_booleanize(position, SCRATCH_BASE);
    cell condition = allocate_control_pair();
    cell otherwise = condition + 1;
    position = emit_clear(position, condition);
    position = emit_transfer(position, SCRATCH_BASE, condition, 0);
    position = emit_constant(position, otherwise, 1);

    position = emit_loop_open(position, condition);
    position = emit_clear(position, condition);
    position = emit_clear(position, otherwise);
    position = parse_statement(position);
    position = emit_loop_close(position, condition);

    position = emit_loop_open(position, otherwise);
    position = emit_clear(position, otherwise);
    if (token_kind == TokenKind::Identifier && token_is_else()) {
        next_token();
        position = parse_statement(position);
    }
    position = emit_loop_close(position, otherwise);
    release_control_pair();
    return position;
}

cell parse_while_statement(cell position) {
    next_token();
    consume(TokenKind::LeftParen);

    cell running = allocate_control_pair();
    cell condition = running + 1;
    position = emit_constant(position, running, 1);
    position = emit_loop_open(position, running);
    position = emit_clear(position, running);

    position = parse_expression(position, SCRATCH_BASE);
    consume(TokenKind::RightParen);
    position = emit_booleanize(position, SCRATCH_BASE);
    position = emit_clear(position, condition);
    position = emit_transfer(position, SCRATCH_BASE, condition, 0);

    position = emit_loop_open(position, condition);
    position = emit_clear(position, condition);
    position = emit_constant(position, running, 1);
    position = parse_statement(position);
    position = emit_loop_close(position, condition);
    position = emit_loop_close(position, running);
    release_control_pair();
    return position;
}

cell parse_block(cell position) {
    consume(TokenKind::LeftBrace);
    if (scope_depth == MAX_SCOPES) {
        fail('B', 'F');
    }
    scope_base[scope_depth] = symbol_count;
    scope_depth += 1;

    while (token_kind != TokenKind::RightBrace) {
        if (token_kind == TokenKind::Eof) {
            fail('B', 'G');
        }
        if (token_kind == TokenKind::Identifier && token_is_cell()) {
            position = parse_declaration(position);
        } else {
            position = parse_statement(position);
        }
    }

    consume(TokenKind::RightBrace);
    scope_depth -= 1;
    symbol_count = scope_base[scope_depth];
    return position;
}

cell parse_statement(cell position) {
    if (token_kind == TokenKind::Semicolon) {
        next_token();
    } else if (token_kind == TokenKind::LeftBrace) {
        position = parse_block(position);
    } else if (token_kind == TokenKind::Identifier) {
        if (token_is_output()) {
            position = parse_output_statement(position);
        } else if (token_is_if()) {
            position = parse_if_statement(position);
        } else if (token_is_while()) {
            position = parse_while_statement(position);
        } else {
            position = parse_assignment(position);
        }
    } else {
        fail('B', 'H');
    }
    return position;
}

cell compile_program_stage4(cell position) {
    control_depth = 0;
    read_character();
    next_token();

    if (token_kind != TokenKind::Identifier || !token_is_void()) {
        fail('B', 'I');
    }
    next_token();
    if (token_kind != TokenKind::Identifier || !token_is_main()) {
        fail('B', 'J');
    }
    next_token();
    consume(TokenKind::LeftParen);
    consume(TokenKind::RightParen);
    position = parse_block(position);

    if (token_kind != TokenKind::Eof) {
        fail('B', 'K');
    }
    return position;
}
