// 第1〜4段階の式、宣言、代入、制御構文を解析しながらBFを生成する。

void parse_primary(cell destination) {
    check_scratch(destination);
    if (token_kind == TokenKind::Number) {
        emit_constant(destination, token_value);
        next_token();
    } else if (token_kind == TokenKind::Identifier) {
        if (token_is_input()) {
            next_token();
            consume(TokenKind::LeftParen);
            consume(TokenKind::RightParen);
            emit_input(destination);
        } else {
            cell source = find_symbol();
            next_token();
            emit_copy(source, destination);
        }
    } else if (token_kind == TokenKind::LeftParen) {
        next_token();
        parse_expression(destination);
        consume(TokenKind::RightParen);
    } else {
        fail();
    }
}

void parse_unary(cell destination) {
    check_scratch(destination);
    if (token_kind == TokenKind::Bang) {
        next_token();
        parse_unary(destination);
        emit_not(destination);
    } else if (token_kind == TokenKind::Plus) {
        next_token();
        parse_unary(destination);
    } else if (token_kind == TokenKind::Minus) {
        next_token();
        emit_clear(destination);
        parse_unary(destination + 1);
        emit_transfer(destination + 1, destination, 1);
    } else {
        parse_primary(destination);
    }
}

void parse_additive(cell destination) {
    parse_unary(destination);
    while (token_kind == TokenKind::Plus || token_kind == TokenKind::Minus) {
        TokenKind operator = token_kind;
        next_token();
        parse_unary(destination + 1);
        emit_transfer(
            destination + 1,
            destination,
            operator == TokenKind::Minus
        );
    }
}

void parse_comparison(cell destination) {
    parse_additive(destination);
    while (token_kind == TokenKind::Less
        || token_kind == TokenKind::LessEqual
        || token_kind == TokenKind::Greater
        || token_kind == TokenKind::GreaterEqual) {
        TokenKind operator = token_kind;
        next_token();
        parse_additive(destination + 1);
        if (operator == TokenKind::Less || operator == TokenKind::GreaterEqual) {
            emit_less(destination, destination + 1);
        } else {
            emit_swap(destination, destination + 1);
            emit_less(destination, destination + 1);
        }
        if (operator == TokenKind::LessEqual
            || operator == TokenKind::GreaterEqual) {
            emit_not(destination);
        }
    }
}

void parse_equality(cell destination) {
    parse_comparison(destination);
    while (token_kind == TokenKind::EqualEqual
        || token_kind == TokenKind::BangEqual) {
        TokenKind operator = token_kind;
        next_token();
        parse_comparison(destination + 1);
        emit_transfer(destination + 1, destination, 1);
        if (operator == TokenKind::EqualEqual) {
            emit_not(destination);
        } else {
            emit_booleanize(destination);
        }
    }
}

void parse_logical_and(cell destination) {
    parse_equality(destination);
    while (token_kind == TokenKind::AmpAmp) {
        next_token();
        emit_booleanize(destination);
        cell guard = allocate_control_pair();
        emit_clear(guard);
        emit_transfer(destination, guard, 0);
        emit_loop_open(guard);
        emit_clear(guard);
        parse_equality(destination);
        emit_booleanize(destination);
        emit_loop_close(guard);
        release_control_pair();
    }
}

void parse_expression(cell destination) {
    parse_logical_and(destination);
    while (token_kind == TokenKind::PipePipe) {
        next_token();
        emit_booleanize(destination);
        cell guard = allocate_control_pair();
        cell otherwise = guard + 1;
        emit_copy(destination, guard);
        emit_constant(otherwise, 1);
        emit_loop_open(guard);
        emit_clear(guard);
        emit_clear(otherwise);
        emit_loop_close(guard);
        emit_loop_open(otherwise);
        emit_clear(otherwise);
        parse_logical_and(destination);
        emit_booleanize(destination);
        emit_loop_close(otherwise);
        release_control_pair();
    }
}

void parse_declaration() {
    // The current token is "cell".
    next_token();
    if (token_kind != TokenKind::Identifier) {
        fail();
    }
    cell destination = add_symbol();
    next_token();

    // A declaration executes zero initialization even when its tape cell was
    // previously used by a local from a completed nested block.
    emit_clear(destination);
    if (token_kind == TokenKind::Assign) {
        next_token();
        parse_expression(SCRATCH_BASE);
        emit_clear(destination);
        emit_transfer(SCRATCH_BASE, destination, 0);
    }
    consume(TokenKind::Semicolon);
}

void parse_output_statement() {
    next_token();
    consume(TokenKind::LeftParen);
    parse_expression(SCRATCH_BASE);
    consume(TokenKind::RightParen);
    consume(TokenKind::Semicolon);
    emit_move_to(SCRATCH_BASE);
    compiler_output!('.');
}

void parse_assignment() {
    cell destination = find_symbol();
    next_token();
    TokenKind operator = token_kind;
    if (operator != TokenKind::Assign
        && operator != TokenKind::PlusAssign
        && operator != TokenKind::MinusAssign) {
        fail();
    }
    next_token();
    parse_expression(SCRATCH_BASE);
    consume(TokenKind::Semicolon);

    if (operator == TokenKind::Assign) {
        emit_clear(destination);
        emit_transfer(SCRATCH_BASE, destination, 0);
    } else {
        emit_transfer(
            SCRATCH_BASE,
            destination,
            operator == TokenKind::MinusAssign
        );
    }
}

void parse_if_statement() {
    next_token();
    consume(TokenKind::LeftParen);
    parse_expression(SCRATCH_BASE);
    consume(TokenKind::RightParen);

    emit_booleanize(SCRATCH_BASE);
    cell condition = allocate_control_pair();
    cell otherwise = condition + 1;
    emit_clear(condition);
    emit_transfer(SCRATCH_BASE, condition, 0);
    emit_constant(otherwise, 1);

    emit_loop_open(condition);
    emit_clear(condition);
    emit_clear(otherwise);
    parse_statement();
    emit_loop_close(condition);

    emit_loop_open(otherwise);
    emit_clear(otherwise);
    if (token_kind == TokenKind::Identifier && token_is_else()) {
        next_token();
        parse_statement();
    }
    emit_loop_close(otherwise);
    release_control_pair();
}

void parse_while_statement() {
    next_token();
    consume(TokenKind::LeftParen);

    cell running = allocate_control_pair();
    cell condition = running + 1;
    emit_constant(running, 1);
    emit_loop_open(running);
    emit_clear(running);

    parse_expression(SCRATCH_BASE);
    consume(TokenKind::RightParen);
    emit_booleanize(SCRATCH_BASE);
    emit_clear(condition);
    emit_transfer(SCRATCH_BASE, condition, 0);

    emit_loop_open(condition);
    emit_clear(condition);
    emit_constant(running, 1);
    parse_statement();
    emit_loop_close(condition);
    emit_loop_close(running);
    release_control_pair();
}

void parse_block() {
    consume(TokenKind::LeftBrace);
    if (scope_depth == MAX_SCOPES) {
        fail();
    }
    scope_base[scope_depth] = symbol_count;
    scope_depth += 1;

    while (token_kind != TokenKind::RightBrace) {
        if (token_kind == TokenKind::Eof) {
            fail();
        }
        if (token_kind == TokenKind::Identifier && token_is_cell()) {
            parse_declaration();
        } else {
            parse_statement();
        }
    }

    consume(TokenKind::RightBrace);
    scope_depth -= 1;
    symbol_count = scope_base[scope_depth];
}

void parse_statement() {
    if (token_kind == TokenKind::Semicolon) {
        next_token();
    } else if (token_kind == TokenKind::LeftBrace) {
        parse_block();
    } else if (token_kind == TokenKind::Identifier) {
        if (token_is_output()) {
            parse_output_statement();
        } else if (token_is_if()) {
            parse_if_statement();
        } else if (token_is_while()) {
            parse_while_statement();
        } else {
            parse_assignment();
        }
    } else {
        fail();
    }
}

void compile_program_stage4() {
    control_depth = 0;
    read_character();
    next_token();

    if (token_kind != TokenKind::Identifier || !token_is_void()) {
        fail();
    }
    next_token();
    if (token_kind != TokenKind::Identifier || !token_is_main()) {
        fail();
    }
    next_token();
    consume(TokenKind::LeftParen);
    consume(TokenKind::RightParen);
    parse_block();

    if (token_kind != TokenKind::Eof) {
        fail();
    }
}
