// typed ASTから第12段階Continuation IRを構築する。

const cell TERM_NONE = 0;
const cell TERM_GOTO = 1;
const cell TERM_BRANCH = 2;
const cell TERM_CALL = 3;
const cell TERM_RETURN = 4;
const cell TERM_HALT = 5;
const cell TERM_RETURN_ARRAY = 6;
const cell TERM_ABORT = 7;

const cell IR_SET = 1;
const cell IR_COPY = 2;
const cell IR_COPY_ABI_VALUE = 3;
const cell IR_INPUT = 4;
const cell IR_OUTPUT = 5;
const cell IR_ADD = 6;
const cell IR_SUBTRACT = 7;
const cell IR_NEGATE = 8;
const cell IR_NOT = 9;
const cell IR_BOOLEANIZE = 10;
const cell IR_LESS = 11;
const cell IR_LESS_EQUAL = 12;
const cell IR_GREATER = 13;
const cell IR_GREATER_EQUAL = 14;
const cell IR_EQUAL = 15;
const cell IR_NOT_EQUAL = 16;
const cell IR_SET_GLOBAL = 17;
const cell IR_COPY_GLOBAL = 18;
const cell IR_STORE_GLOBAL = 19;
const cell IR_ADD_GLOBAL = 20;
const cell IR_SUBTRACT_GLOBAL = 21;
const cell IR_ARRAY_LOAD = 22;
const cell IR_ARRAY_STORE = 23;
const cell IR_ARRAY_ADD = 24;
const cell IR_ARRAY_SUBTRACT = 25;
const cell IR_COPY_OUTBOX = 26;
const cell IR_OFFSET_ADD_SCALED = 27;
const cell IR_OFFSET_ADD_CONSTANT = 28;

const cell VOID_RETURN_SLOT = 0xff;
// Continuation records use every common field plus a dense dispatch ID.
const cell CONTINUATION_CELLS = 20;

NodeId first_continuation;
NodeId last_continuation;
NodeId lowering_current_continuation;
NodeId lowering_instruction_tail;
NodeId lowering_current_function;
cell lowering_temp_next;
cell lowering_temp_max;

NodeId continuation_dispatch_id(NodeId continuation) {
    NodeId result;
    result.slot = arena_read(continuation, FIELD_DISPATCH_LOW);
    result.page = arena_read(continuation, FIELD_DISPATCH_HIGH);
    return result;
}

void set_continuation_dispatch_id(NodeId continuation, NodeId id) {
    arena_write(continuation, FIELD_DISPATCH_LOW, id.slot);
    arena_write(continuation, FIELD_DISPATCH_HIGH, id.page);
}

NodeId next_continuation_dispatch_id(NodeId previous) {
    NodeId result = previous;
    if (result.slot == 0xff) {
        result.slot = 0;
        result.page += 1;
    } else {
        result.slot += 1;
    }
    return result;
}

NodeId new_continuation() {
    NodeId result = allocate_cells(CONTINUATION_CELLS);
    arena_write(result, FIELD_KIND, NODE_CONTINUATION);
    NodeId previous = last_continuation;
    NodeId dispatch_id;
    if (node_is_null(previous)) {
        // 0 is reserved for a context which has not reached the cycle-end PC move.
        dispatch_id.slot = 1;
        first_continuation = result;
    } else {
        dispatch_id = next_continuation_dispatch_id(
            continuation_dispatch_id(previous)
        );
        node_set_next(previous, result);
    }
    set_continuation_dispatch_id(result, dispatch_id);
    last_continuation = result;
    return result;
}

void select_continuation(NodeId continuation) {
    lowering_current_continuation = continuation;
    NodeId instruction = node_a(continuation);
    lowering_instruction_tail = instruction;
    while (!node_is_null(lowering_instruction_tail)
        && !node_is_null(node_next(lowering_instruction_tail))) {
        lowering_instruction_tail = node_next(lowering_instruction_tail);
    }
}

void append_ir_instruction(cell kind, cell destination, cell source) {
    NodeId instruction = allocate_node(NODE_INSTRUCTION);
    node_set_tag(instruction, kind);
    node_set_value(instruction, destination);
    arena_write(instruction, FIELD_NAME_PAGE, source);
    if (node_is_null(node_a(lowering_current_continuation))) {
        node_set_a(lowering_current_continuation, instruction);
    } else {
        node_set_next(lowering_instruction_tail, instruction);
    }
    lowering_instruction_tail = instruction;
}

cell instruction_source(NodeId instruction) {
    return arena_read(instruction, FIELD_NAME_PAGE);
}

void append_array_ir_instruction(
    cell kind,
    cell data,
    cell offset_low,
    cell offset_high,
    cell base,
    cell cells,
    cell storage
) {
    NodeId instruction = allocate_node(NODE_INSTRUCTION);
    node_set_tag(instruction, kind);
    node_set_value(instruction, data);
    arena_write(instruction, FIELD_NAME_PAGE, offset_low);
    arena_write(instruction, FIELD_A_PAGE, base);
    arena_write(instruction, FIELD_A_SLOT, cells);
    arena_write(instruction, FIELD_B_PAGE, storage);
    arena_write(instruction, FIELD_B_SLOT, offset_high);
    if (node_is_null(node_a(lowering_current_continuation))) {
        node_set_a(lowering_current_continuation, instruction);
    } else {
        node_set_next(lowering_instruction_tail, instruction);
    }
    lowering_instruction_tail = instruction;
}

void append_offset_ir_instruction(
    cell kind,
    cell low,
    cell high,
    cell source,
    cell amount
) {
    NodeId instruction = allocate_node(NODE_INSTRUCTION);
    node_set_tag(instruction, kind);
    node_set_value(instruction, low);
    arena_write(instruction, FIELD_NAME_PAGE, high);
    arena_write(instruction, FIELD_A_PAGE, source);
    arena_write(instruction, FIELD_A_SLOT, amount);
    if (node_is_null(node_a(lowering_current_continuation))) {
        node_set_a(lowering_current_continuation, instruction);
    } else {
        node_set_next(lowering_instruction_tail, instruction);
    }
    lowering_instruction_tail = instruction;
}

cell allocate_lowering_temp() {
    if (lowering_temp_next == 0xef) {
        fail();
    }
    cell result = lowering_temp_next;
    lowering_temp_next += 1;
    if (lowering_temp_next > lowering_temp_max) {
        lowering_temp_max = lowering_temp_next;
    }
    return result;
}

cell allocate_lowering_cells(cell count) {
    if (count > 0xef || lowering_temp_next > 0xef - count) {
        fail();
    }
    cell result = lowering_temp_next;
    lowering_temp_next += count;
    if (lowering_temp_next > lowering_temp_max) {
        lowering_temp_max = lowering_temp_next;
    }
    return result;
}

void release_lowering_temp(cell slot) {
    lowering_temp_next = slot;
}

void finish_goto(NodeId target) {
    node_set_tag(lowering_current_continuation, TERM_GOTO);
    node_set_name(lowering_current_continuation, target);
}

void finish_branch(cell condition, NodeId then_target, NodeId else_target) {
    node_set_tag(lowering_current_continuation, TERM_BRANCH);
    node_set_value(lowering_current_continuation, condition);
    node_set_name(lowering_current_continuation, then_target);
    node_set_b(lowering_current_continuation, else_target);
}

void finish_return(cell slot) {
    if (node_equals(lowering_current_function, main_function)) {
        node_set_tag(lowering_current_continuation, TERM_HALT);
    } else {
        node_set_tag(lowering_current_continuation, TERM_RETURN);
    }
    node_set_value(lowering_current_continuation, slot);
}

void finish_array_return(cell slot, cell length) {
    node_set_tag(lowering_current_continuation, TERM_RETURN_ARRAY);
    node_set_value(lowering_current_continuation, slot);
    arena_write(lowering_current_continuation, FIELD_NAME_PAGE, length);
}

void finish_abort() {
    node_set_tag(lowering_current_continuation, TERM_ABORT);
}

void lower_ast_call(NodeId expression) {
    cell temporary_base = lowering_temp_next;
    NodeId first_argument;
    NodeId last_argument;
    NodeId argument = node_a(expression);
    NodeId function = node_b(expression);
    NodeId parameter = node_a(function);
    while (!node_is_null(argument)) {
        NodeId ir_argument = allocate_node(NODE_CALL_ARGUMENT);
        cell destination = arena_read(parameter, FIELD_C_PAGE);
        arena_write(ir_argument, FIELD_B_PAGE, destination);
        if (node_tag(parameter) == AST_DECLARATION_ARRAY) {
            cell length = node_value(parameter);
            cell slot = allocate_lowering_cells(length);
            lower_aggregate_expression(argument, slot, length);
            node_set_tag(ir_argument, AST_DECLARATION_ARRAY);
            node_set_value(ir_argument, slot);
            arena_write(ir_argument, FIELD_A_PAGE, length);
        } else {
            cell slot = allocate_lowering_temp();
            lower_ast_expression(argument, slot);
            node_set_tag(ir_argument, AST_DECLARATION_SCALAR);
            node_set_value(ir_argument, slot);
        }
        if (node_is_null(first_argument)) {
            first_argument = ir_argument;
        } else {
            node_set_next(last_argument, ir_argument);
        }
        last_argument = ir_argument;
        argument = node_next(argument);
        parameter = node_next(parameter);
    }

    NodeId resume = new_continuation();
    node_set_tag(lowering_current_continuation, TERM_CALL);
    node_set_name(lowering_current_continuation, function);
    node_set_b(lowering_current_continuation, resume);
    node_set_c(lowering_current_continuation, first_argument);
    select_continuation(resume);
    lowering_temp_next = temporary_base;
}

cell dynamic_region_cells(NodeId expression) {
    NodeId base = node_a(expression);
    while (expression_is_dynamic_place(base)) {
        base = node_a(base);
    }
    return node_value(expression_type(base));
}

void lower_dynamic_offset(NodeId expression, cell low, cell high) {
    NodeId base = node_a(expression);
    if (expression_is_dynamic_place(base)) {
        lower_dynamic_offset(base, low, high);
    } else {
        append_ir_instruction(IR_SET, low, 0);
        append_ir_instruction(IR_SET, high, 0);
    }
    cell projection_kind = arena_read(expression, FIELD_C_SLOT);
    cell amount = arena_read(expression, FIELD_C_PAGE);
    if (projection_kind == DYNAMIC_PROJECTION_INDEX) {
        cell index = allocate_lowering_temp();
        lower_ast_expression(node_b(expression), index);
        append_offset_ir_instruction(
            IR_OFFSET_ADD_SCALED,
            low,
            high,
            index,
            amount
        );
        release_lowering_temp(index);
    } else if (projection_kind == DYNAMIC_PROJECTION_CONSTANT) {
        append_offset_ir_instruction(
            IR_OFFSET_ADD_CONSTANT,
            low,
            high,
            0,
            amount
        );
    } else {
        fail();
    }
}

void append_dynamic_portal(
    cell kind,
    cell data,
    NodeId expression,
    cell low,
    cell high
) {
    append_array_ir_instruction(
        kind,
        data,
        low,
        high,
        node_value(expression),
        dynamic_region_cells(expression),
        node_tag(expression)
    );
}

void lower_dynamic_aggregate(
    NodeId expression,
    cell destination,
    cell cells
) {
    cell offset_low = allocate_lowering_temp();
    cell offset_high = allocate_lowering_temp();
    lower_dynamic_offset(expression, offset_low, offset_high);
    cell index;
    while (index < cells) {
        cell portal_low = allocate_lowering_temp();
        cell portal_high = allocate_lowering_temp();
        append_ir_instruction(IR_COPY, portal_low, offset_low);
        append_ir_instruction(IR_COPY, portal_high, offset_high);
        append_dynamic_portal(
            IR_ARRAY_LOAD,
            destination + index,
            expression,
            portal_low,
            portal_high
        );
        release_lowering_temp(portal_low);
        index += 1;
        if (index < cells) {
            append_offset_ir_instruction(
                IR_OFFSET_ADD_CONSTANT,
                offset_low,
                offset_high,
                0,
                1
            );
        }
    }
    release_lowering_temp(offset_low);
}

void lower_aggregate_expression(NodeId expression, cell destination, cell length) {
    cell kind = node_kind(expression);
    if (kind == NODE_STRING_EXPRESSION) {
        NodeId byte = node_a(expression);
        cell index;
        while (index < length) {
            append_ir_instruction(
                IR_SET,
                destination + index,
                arena_cell_read(byte)
            );
            byte = arena_advance(byte, 1);
            index += 1;
        }
        return;
    }
    if ((kind == NODE_INDEX_EXPRESSION || kind == NODE_FIELD_EXPRESSION)
        && expression_is_dynamic_place(expression)) {
        lower_dynamic_aggregate(expression, destination, length);
        return;
    }
    if ((kind == NODE_NAME_EXPRESSION || kind == NODE_INDEX_EXPRESSION
        || kind == NODE_FIELD_EXPRESSION)
        && (node_tag(expression) == RESOLVED_LOCAL
            || node_tag(expression) == RESOLVED_GLOBAL)) {
        cell source = node_value(expression);
        cell index;
        while (index < length) {
            if (node_tag(expression) == RESOLVED_GLOBAL) {
                append_ir_instruction(
                    IR_COPY_GLOBAL,
                    destination + index,
                    source + index
                );
            } else {
                append_ir_instruction(
                    IR_COPY,
                    destination + index,
                    source + index
                );
            }
            index += 1;
        }
        return;
    }
    if (kind == NODE_CALL_EXPRESSION) {
        lower_ast_call(expression);
        cell index;
        while (index < length) {
            append_ir_instruction(IR_COPY_OUTBOX, destination + index, index);
            index += 1;
        }
        return;
    }
    if ((kind == NODE_INDEX_EXPRESSION || kind == NODE_FIELD_EXPRESSION)
        && node_tag(expression) == RESOLVED_VALUE_PROJECT) {
        NodeId base = node_a(expression);
        cell base_cells = node_value(expression_type(base));
        cell temporary = allocate_lowering_cells(base_cells);
        lower_aggregate_expression(base, temporary, base_cells);
        cell index;
        while (index < length) {
            append_ir_instruction(
                IR_COPY,
                destination + index,
                temporary + node_value(expression) + index
            );
            index += 1;
        }
        release_lowering_temp(temporary);
        return;
    }
    fail();
}

void lower_ast_expression(NodeId expression, cell destination) {
    cell kind = node_kind(expression);
    if (kind == NODE_LITERAL_EXPRESSION) {
        append_ir_instruction(IR_SET, destination, literal_value(expression));
        return;
    }
    if (kind == NODE_ENUM_EXPRESSION || kind == NODE_LEN_EXPRESSION) {
        append_ir_instruction(IR_SET, destination, node_value(expression));
        return;
    }
    if (kind == NODE_NAME_EXPRESSION
        || ((kind == NODE_INDEX_EXPRESSION || kind == NODE_FIELD_EXPRESSION)
            && (node_tag(expression) == RESOLVED_LOCAL
                || node_tag(expression) == RESOLVED_GLOBAL))) {
        if (node_tag(expression) == RESOLVED_CONSTANT) {
            append_ir_instruction(IR_SET, destination, node_value(expression));
        } else if (node_tag(expression) == RESOLVED_GLOBAL) {
            append_ir_instruction(IR_COPY_GLOBAL, destination, node_value(expression));
        } else {
            append_ir_instruction(IR_COPY, destination, node_value(expression));
        }
        return;
    }
    if ((kind == NODE_INDEX_EXPRESSION || kind == NODE_FIELD_EXPRESSION)
        && expression_is_dynamic_place(expression)) {
        cell offset_low = allocate_lowering_temp();
        cell offset_high = allocate_lowering_temp();
        lower_dynamic_offset(expression, offset_low, offset_high);
        append_dynamic_portal(
            IR_ARRAY_LOAD,
            destination,
            expression,
            offset_low,
            offset_high
        );
        release_lowering_temp(offset_low);
        return;
    }
    if (kind == NODE_INDEX_EXPRESSION) {
        cell storage = node_tag(expression);
        if (storage == RESOLVED_VALUE_PROJECT) {
            NodeId base = node_a(expression);
            cell base_cells = node_value(expression_type(base));
            cell temporary = allocate_lowering_cells(base_cells);
            lower_aggregate_expression(base, temporary, base_cells);
            append_ir_instruction(
                IR_COPY,
                destination,
                temporary + node_value(expression)
            );
            release_lowering_temp(temporary);
            return;
        }
        fail();
    }
    if (kind == NODE_FIELD_EXPRESSION
        && node_tag(expression) == RESOLVED_VALUE_PROJECT) {
        NodeId base = node_a(expression);
        cell base_cells = node_value(expression_type(base));
        cell temporary = allocate_lowering_cells(base_cells);
        lower_aggregate_expression(base, temporary, base_cells);
        append_ir_instruction(
            IR_COPY,
            destination,
            temporary + node_value(expression)
        );
        release_lowering_temp(temporary);
        return;
    }
    if (kind == NODE_INPUT_EXPRESSION) {
        append_ir_instruction(IR_INPUT, destination, 0);
        return;
    }
    if (kind == NODE_CALL_EXPRESSION) {
        lower_ast_call(expression);
        append_ir_instruction(IR_COPY_ABI_VALUE, destination, 0);
        return;
    }
    if (kind == NODE_UNARY_EXPRESSION) {
        lower_ast_expression(node_a(expression), destination);
        cell operator = node_tag(expression);
        if (operator == AST_UNARY_NEGATE) {
            append_ir_instruction(IR_NEGATE, destination, 0);
        } else if (operator == AST_UNARY_NOT) {
            append_ir_instruction(IR_NOT, destination, 0);
        }
        return;
    }
    if (kind == NODE_BINARY_EXPRESSION) {
        cell operator = node_tag(expression);
        if (operator == AST_BINARY_LOGICAL_AND
            || operator == AST_BINARY_LOGICAL_OR) {
            lower_ast_expression(node_a(expression), destination);
            append_ir_instruction(IR_BOOLEANIZE, destination, 0);
            cell branch_condition = allocate_lowering_temp();
            append_ir_instruction(IR_COPY, branch_condition, destination);
            NodeId right = new_continuation();
            NodeId join = new_continuation();
            if (operator == AST_BINARY_LOGICAL_AND) {
                finish_branch(branch_condition, right, join);
            } else {
                finish_branch(branch_condition, join, right);
            }
            release_lowering_temp(branch_condition);
            select_continuation(right);
            if (binary_has_immediate(expression)) {
                append_ir_instruction(
                    IR_SET,
                    destination,
                    binary_immediate(expression)
                );
            } else {
                lower_ast_expression(node_b(expression), destination);
            }
            append_ir_instruction(IR_BOOLEANIZE, destination, 0);
            finish_goto(join);
            select_continuation(join);
            return;
        }

        lower_ast_expression(node_a(expression), destination);
        cell right_slot = allocate_lowering_temp();
        if (binary_has_immediate(expression)) {
            append_ir_instruction(
                IR_SET,
                right_slot,
                binary_immediate(expression)
            );
        } else {
            lower_ast_expression(node_b(expression), right_slot);
        }
        cell instruction = IR_ADD;
        if (operator == AST_BINARY_SUBTRACT) {
            instruction = IR_SUBTRACT;
        } else if (operator == AST_BINARY_LESS) {
            instruction = IR_LESS;
        } else if (operator == AST_BINARY_LESS_EQUAL) {
            instruction = IR_LESS_EQUAL;
        } else if (operator == AST_BINARY_GREATER) {
            instruction = IR_GREATER;
        } else if (operator == AST_BINARY_GREATER_EQUAL) {
            instruction = IR_GREATER_EQUAL;
        } else if (operator == AST_BINARY_EQUAL) {
            instruction = IR_EQUAL;
        } else if (operator == AST_BINARY_NOT_EQUAL) {
            instruction = IR_NOT_EQUAL;
        }
        append_ir_instruction(instruction, destination, right_slot);
        release_lowering_temp(right_slot);
        return;
    }
    fail();
}

void lower_ast_statement(NodeId statement) {
    if (node_is_null(lowering_current_continuation)) {
        return;
    }
    cell kind = node_kind(statement);
    if (kind == NODE_EMPTY_STATEMENT) {
        return;
    }
    if (kind == NODE_ABORT_STATEMENT) {
        finish_abort();
        lowering_current_continuation = null_node();
        return;
    }
    if (kind == NODE_BLOCK) {
        NodeId child = node_a(statement);
        while (!node_is_null(child)) {
            lower_ast_statement(child);
            child = node_next(child);
        }
        return;
    }
    if (kind == NODE_DECLARATION) {
        cell slot = arena_read(statement, FIELD_C_PAGE);
        cell cells = 1;
        if (node_tag(statement) == AST_DECLARATION_ARRAY) {
            cells = node_value(statement);
        }
        cell index;
        while (index < cells) {
            append_ir_instruction(IR_SET, slot + index, 0);
            index += 1;
        }
        if (!node_is_null(node_a(statement))) {
            if (node_tag(statement) == AST_DECLARATION_ARRAY) {
                lower_aggregate_expression(node_a(statement), slot, cells);
            } else {
                lower_ast_expression(node_a(statement), slot);
            }
        }
        return;
    }
    if (kind == NODE_OUTPUT_STATEMENT) {
        cell slot = allocate_lowering_temp();
        lower_ast_expression(node_a(statement), slot);
        append_ir_instruction(IR_OUTPUT, 0, slot);
        release_lowering_temp(slot);
        return;
    }
    if (kind == NODE_ASSIGNMENT) {
        NodeId left = node_a(statement);
        cell aggregate_cells = node_value(expression_type(left));
        if (type_is_aggregate(expression_type(left))) {
            cell snapshot = allocate_lowering_cells(aggregate_cells);
            lower_aggregate_expression(node_b(statement), snapshot, aggregate_cells);
            cell index;
            if (expression_is_dynamic_place(left)) {
                cell offset_low = allocate_lowering_temp();
                cell offset_high = allocate_lowering_temp();
                lower_dynamic_offset(left, offset_low, offset_high);
                while (index < aggregate_cells) {
                    cell portal_low = allocate_lowering_temp();
                    cell portal_high = allocate_lowering_temp();
                    append_ir_instruction(IR_COPY, portal_low, offset_low);
                    append_ir_instruction(IR_COPY, portal_high, offset_high);
                    append_dynamic_portal(
                        IR_ARRAY_STORE,
                        snapshot + index,
                        left,
                        portal_low,
                        portal_high
                    );
                    release_lowering_temp(portal_low);
                    index += 1;
                    if (index < aggregate_cells) {
                        append_offset_ir_instruction(
                            IR_OFFSET_ADD_CONSTANT,
                            offset_low,
                            offset_high,
                            0,
                            1
                        );
                    }
                }
                release_lowering_temp(offset_low);
                release_lowering_temp(snapshot);
                return;
            }
            while (index < aggregate_cells) {
                if (node_tag(left) == RESOLVED_GLOBAL) {
                    append_ir_instruction(
                        IR_STORE_GLOBAL,
                        node_value(left) + index,
                        snapshot + index
                    );
                } else {
                    append_ir_instruction(
                        IR_COPY,
                        node_value(left) + index,
                        snapshot + index
                    );
                }
                index += 1;
            }
            release_lowering_temp(snapshot);
            return;
        }
        cell source = allocate_lowering_temp();
        lower_ast_expression(node_b(statement), source);
        cell operator = node_tag(statement);
        cell storage = node_tag(left);
        if (storage == RESOLVED_LOCAL_DYNAMIC
            || storage == RESOLVED_GLOBAL_DYNAMIC) {
            cell offset_low = allocate_lowering_temp();
            cell offset_high = allocate_lowering_temp();
            lower_dynamic_offset(left, offset_low, offset_high);
            cell instruction = IR_ARRAY_STORE;
            if (operator == AST_ASSIGNMENT_ADD) {
                instruction = IR_ARRAY_ADD;
            } else if (operator == AST_ASSIGNMENT_SUBTRACT) {
                instruction = IR_ARRAY_SUBTRACT;
            }
            append_dynamic_portal(
                instruction,
                source,
                left,
                offset_low,
                offset_high
            );
            release_lowering_temp(offset_low);
        } else if (storage == RESOLVED_GLOBAL) {
            cell instruction = IR_STORE_GLOBAL;
            if (operator == AST_ASSIGNMENT_ADD) {
                instruction = IR_ADD_GLOBAL;
            } else if (operator == AST_ASSIGNMENT_SUBTRACT) {
                instruction = IR_SUBTRACT_GLOBAL;
            }
            append_ir_instruction(instruction, node_value(left), source);
        } else {
            cell destination = node_value(left);
            if (operator == AST_ASSIGNMENT_ADD) {
                append_ir_instruction(IR_ADD, destination, source);
            } else if (operator == AST_ASSIGNMENT_SUBTRACT) {
                append_ir_instruction(IR_SUBTRACT, destination, source);
            } else {
                append_ir_instruction(IR_COPY, destination, source);
            }
        }
        release_lowering_temp(source);
        return;
    }
    if (kind == NODE_CALL_STATEMENT) {
        cell discarded = allocate_lowering_temp();
        lower_ast_expression(node_a(statement), discarded);
        release_lowering_temp(discarded);
        return;
    }
    if (kind == NODE_RETURN_STATEMENT) {
        if (node_is_null(node_a(statement))) {
            finish_return(VOID_RETURN_SLOT);
        } else if (node_tag(lowering_current_function) == AST_TYPE_ARRAY) {
            cell length = arena_read(
                node_c(lowering_current_function),
                FIELD_B_PAGE
            );
            cell slot = allocate_lowering_cells(length);
            lower_aggregate_expression(node_a(statement), slot, length);
            finish_array_return(slot, length);
        } else {
            cell slot = allocate_lowering_temp();
            lower_ast_expression(node_a(statement), slot);
            finish_return(slot);
        }
        lowering_current_continuation = null_node();
        return;
    }
    if (kind == NODE_IF_STATEMENT) {
        cell condition = allocate_lowering_temp();
        lower_ast_expression(node_a(statement), condition);
        append_ir_instruction(IR_BOOLEANIZE, condition, 0);
        NodeId then_continuation = new_continuation();
        NodeId else_continuation = new_continuation();
        finish_branch(condition, then_continuation, else_continuation);
        release_lowering_temp(condition);

        select_continuation(then_continuation);
        lower_ast_statement(node_b(statement));
        NodeId then_end = lowering_current_continuation;

        select_continuation(else_continuation);
        if (!node_is_null(node_c(statement))) {
            lower_ast_statement(node_c(statement));
        }
        NodeId else_end = lowering_current_continuation;

        if (node_is_null(then_end) && node_is_null(else_end)) {
            lowering_current_continuation = null_node();
        } else {
            NodeId join = new_continuation();
            if (!node_is_null(then_end)) {
                select_continuation(then_end);
                finish_goto(join);
            }
            if (!node_is_null(else_end)) {
                select_continuation(else_end);
                finish_goto(join);
            }
            select_continuation(join);
        }
        return;
    }
    if (kind == NODE_WHILE_STATEMENT) {
        NodeId condition_continuation = new_continuation();
        NodeId body_continuation = new_continuation();
        NodeId exit_continuation = new_continuation();
        finish_goto(condition_continuation);

        select_continuation(condition_continuation);
        cell condition = allocate_lowering_temp();
        lower_ast_expression(node_a(statement), condition);
        append_ir_instruction(IR_BOOLEANIZE, condition, 0);
        finish_branch(condition, body_continuation, exit_continuation);
        release_lowering_temp(condition);

        select_continuation(body_continuation);
        lower_ast_statement(node_b(statement));
        if (!node_is_null(lowering_current_continuation)) {
            finish_goto(condition_continuation);
        }
        select_continuation(exit_continuation);
        return;
    }
    fail();
}

void lower_global_initializers() {
    NodeId global = first_global;
    while (!node_is_null(global)) {
        cell base = arena_read(global, FIELD_C_PAGE);
        cell cells = 1;
        if (node_tag(global) == AST_DECLARATION_ARRAY) {
            cells = node_value(global);
        }
        cell index;
        while (index < cells) {
            append_ir_instruction(IR_SET_GLOBAL, base + index, 0);
            index += 1;
        }
        if (!node_is_null(node_a(global))) {
            if (node_tag(global) == AST_DECLARATION_ARRAY) {
                cell source = allocate_lowering_cells(cells);
                lower_aggregate_expression(node_a(global), source, cells);
                index = 0;
                while (index < cells) {
                    append_ir_instruction(
                        IR_STORE_GLOBAL,
                        base + index,
                        source + index
                    );
                    index += 1;
                }
                release_lowering_temp(source);
            } else {
                cell source = allocate_lowering_temp();
                lower_ast_expression(node_a(global), source);
                append_ir_instruction(IR_STORE_GLOBAL, base, source);
                release_lowering_temp(source);
            }
        }
        global = node_next(global);
    }
}

void lower_ast_program() {
    first_continuation = null_node();
    last_continuation = null_node();
    NodeId function = first_function;
    while (!node_is_null(function)) {
        lowering_current_function = function;
        NodeId descriptor = node_c(function);
        lowering_temp_next = node_value(descriptor);
        lowering_temp_max = lowering_temp_next;
        NodeId entry = new_continuation();
        node_set_a(descriptor, entry);
        select_continuation(entry);
        if (node_equals(function, main_function)) {
            lower_global_initializers();
        }
        lower_ast_statement(node_b(function));
        if (!node_is_null(lowering_current_continuation)) {
            if (node_tag(function) == AST_TYPE_VOID) {
                finish_return(VOID_RETURN_SLOT);
            } else {
                fail();
            }
        }
        node_set_value(descriptor, lowering_temp_max);
        function = node_next(function);
    }
}
