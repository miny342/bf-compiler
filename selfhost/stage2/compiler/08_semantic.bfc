// 第12段階programのfile-scope収集、型/定数解決、名前解決、型検査。

NodeId[256] semantic_local_names;
cell[256] semantic_local_slots;
NodeId[256] semantic_local_types;
cell semantic_local_count;
cell semantic_next_slot;
cell semantic_max_local_count;
cell semantic_scope_depth;
cell[16] semantic_scope_base;
cell[16] semantic_scope_slot_base;
NodeId semantic_current_function;
NodeId main_function;
cell function_count;
cell stage7_static_cells;

const cell RESOLVED_LOCAL = 0;
const cell RESOLVED_GLOBAL = 1;
const cell RESOLVED_LOCAL_DYNAMIC = 2;
const cell RESOLVED_GLOBAL_DYNAMIC = 3;
const cell RESOLVED_VALUE_PROJECT = 4;
const cell RESOLVED_CONSTANT = 5;

const cell DYNAMIC_PROJECTION_INDEX = 1;
const cell DYNAMIC_PROJECTION_CONSTANT = 2;

const cell TYPE_STATE_UNVISITED = 0;
const cell TYPE_STATE_VISITING = 1;
const cell TYPE_STATE_DONE = 2;

const cell CONSTANT_STATE_UNVISITED = 0;
const cell CONSTANT_STATE_VISITING = 1;
const cell CONSTANT_STATE_DONE = 2;

struct ConstantValue {
    cell known;
    cell value;
}

NodeId expression_type(NodeId expression) {
    cell kind = node_kind(expression);
    if (kind == NODE_LITERAL_EXPRESSION || kind == NODE_INPUT_EXPRESSION
        || kind == NODE_LEN_EXPRESSION || kind == NODE_UNARY_EXPRESSION
        || kind == NODE_BINARY_EXPRESSION) {
        return cell_type;
    }
    if (kind == NODE_CALL_EXPRESSION) {
        NodeId function = node_b(expression);
        if (node_is_null(function)) {
            fail();
        }
        return node_name(node_c(function));
    }
    return node_name(expression);
}

void set_expression_type(NodeId expression, NodeId ty) {
    cell kind = node_kind(expression);
    if (kind == NODE_LITERAL_EXPRESSION || kind == NODE_INPUT_EXPRESSION
        || kind == NODE_UNARY_EXPRESSION || kind == NODE_BINARY_EXPRESSION) {
        if (!node_equals(ty, cell_type)) {
            fail();
        }
        return;
    }
    if (kind == NODE_LEN_EXPRESSION) {
        if (!node_equals(ty, cell_type)) {
            fail();
        }
        node_set_tag(expression, 1);
        return;
    }
    if (kind == NODE_CALL_EXPRESSION) {
        return;
    }
    node_set_name(expression, ty);
}

cell type_is_aggregate(NodeId ty) {
    return node_tag(ty) == TYPE_STRUCT || node_tag(ty) == TYPE_ARRAY;
}

cell types_equal(NodeId left, NodeId right) {
    if (node_equals(left, right)) {
        return 1;
    }
    if (node_tag(left) != TYPE_ARRAY || node_tag(right) != TYPE_ARRAY) {
        return 0;
    }
    return arena_read(left, FIELD_C_PAGE) == arena_read(right, FIELD_C_PAGE)
        && arena_read(left, FIELD_C_SLOT) == arena_read(right, FIELD_C_SLOT)
        && types_equal(node_a(left), node_a(right));
}

NodeId find_function_by_name(NodeId name) {
    NodeId function = first_function;
    while (!node_is_null(function)) {
        if (node_equals(node_name(function), name)) {
            return function;
        }
        function = node_next(function);
    }
    fail();
    return null_node();
}

cell find_local_binding_or_zero(NodeId name) {
    cell index = semantic_local_count;
    while (index != 0) {
        index -= 1;
        if (node_equals(semantic_local_names[index], name)) {
            return index + 1;
        }
    }
    return 0;
}

NodeId find_global_by_name_or_null(NodeId name) {
    NodeId global = first_global;
    while (!node_is_null(global)) {
        if (node_equals(node_name(global), name)) {
            return global;
        }
        global = node_next(global);
    }
    return null_node();
}

NodeId find_constant_by_name_or_null(NodeId name) {
    NodeId constant = first_constant;
    while (!node_is_null(constant)) {
        if (node_equals(node_name(constant), name)) {
            return constant;
        }
        constant = node_next(constant);
    }
    return null_node();
}

cell resolve_constant(NodeId constant) {
    if (node_tag(constant) == CONSTANT_STATE_DONE) {
        return node_value(constant);
    }
    if (node_tag(constant) == CONSTANT_STATE_VISITING) {
        fail();
    }
    node_set_tag(constant, CONSTANT_STATE_VISITING);
    ConstantValue result = evaluate_constant_expression(node_a(constant));
    if (!result.known) {
        fail();
    }
    node_set_value(constant, result.value);
    node_set_tag(constant, CONSTANT_STATE_DONE);
    return result.value;
}

cell add_semantic_local(NodeId name, NodeId ty) {
    if (semantic_local_count == 0xff) {
        fail();
    }
    cell first = semantic_scope_base[semantic_scope_depth - 1];
    cell probe = first;
    while (probe < semantic_local_count) {
        if (node_equals(semantic_local_names[probe], name)) {
            fail();
        }
        probe += 1;
    }
    cell cells = node_value(ty);
    if (cells > 0xef || semantic_next_slot > 0xef - cells) {
        fail();
    }
    cell slot = semantic_next_slot;
    semantic_local_names[semantic_local_count] = name;
    semantic_local_slots[semantic_local_count] = slot;
    semantic_local_types[semantic_local_count] = ty;
    semantic_local_count += 1;
    semantic_next_slot += cells;
    if (semantic_next_slot > semantic_max_local_count) {
        semantic_max_local_count = semantic_next_slot;
    }
    return slot;
}

void enter_semantic_scope() {
    if (semantic_scope_depth == 16) {
        fail();
    }
    semantic_scope_base[semantic_scope_depth] = semantic_local_count;
    semantic_scope_slot_base[semantic_scope_depth] = semantic_next_slot;
    semantic_scope_depth += 1;
}

void leave_semantic_scope() {
    semantic_scope_depth -= 1;
    semantic_local_count = semantic_scope_base[semantic_scope_depth];
    semantic_next_slot = semantic_scope_slot_base[semantic_scope_depth];
}

NodeId unevaluated_expression_type(NodeId expression) {
    cell kind = node_kind(expression);
    if (kind == NODE_STRING_EXPRESSION) {
        return expression_type(expression);
    }
    if (kind == NODE_NAME_EXPRESSION) {
        NodeId global = find_global_by_name_or_null(node_name(expression));
        if (!node_is_null(global)) {
            return node_b(global);
        }
        if (!node_is_null(find_constant_by_name_or_null(node_name(expression)))) {
            return cell_type;
        }
        fail();
    }
    if (kind == NODE_CALL_EXPRESSION) {
        NodeId function = find_function_by_name(node_name(expression));
        NodeId return_handle = node_c(function);
        if (node_kind(return_handle) == NODE_FUNCTION_DESCRIPTOR) {
            return node_name(return_handle);
        }
        return return_handle;
    }
    if (kind == NODE_INDEX_EXPRESSION) {
        NodeId base = unevaluated_expression_type(node_a(expression));
        if (node_tag(base) != TYPE_ARRAY) {
            fail();
        }
        return node_a(base);
    }
    if (kind == NODE_FIELD_EXPRESSION) {
        NodeId base = unevaluated_expression_type(node_a(expression));
        if (node_tag(base) != TYPE_STRUCT) {
            fail();
        }
        return node_a(find_struct_field(base, node_name(expression)));
    }
    if (kind == NODE_ENUM_EXPRESSION) {
        NodeId ty = find_named_type_or_null(node_name(expression));
        if (node_is_null(ty) || node_tag(ty) != TYPE_ENUM) {
            fail();
        }
        return ty;
    }
    if (kind == NODE_LEN_EXPRESSION || kind == NODE_LITERAL_EXPRESSION
        || kind == NODE_INPUT_EXPRESSION || kind == NODE_UNARY_EXPRESSION
        || kind == NODE_BINARY_EXPRESSION) {
        return cell_type;
    }
    fail();
    return void_type;
}

ConstantValue evaluate_constant_expression(NodeId expression) {
    ConstantValue result;
    cell kind = node_kind(expression);
    if (kind == NODE_LITERAL_EXPRESSION) {
        result.known = 1;
        result.value = literal_value(expression);
        return result;
    }
    if (kind == NODE_NAME_EXPRESSION) {
        if (node_tag(expression) == RESOLVED_CONSTANT) {
            result.known = 1;
            result.value = node_value(expression);
            return result;
        }
        NodeId constant = find_constant_by_name_or_null(node_name(expression));
        if (!node_is_null(constant)) {
            result.known = 1;
            result.value = resolve_constant(constant);
        }
        return result;
    }
    if (kind == NODE_LEN_EXPRESSION) {
        if (node_tag(expression) != 0) {
            result.known = 1;
            result.value = node_value(expression);
            return result;
        }
        NodeId operand_type = unevaluated_expression_type(node_a(expression));
        if (node_tag(operand_type) != TYPE_ARRAY) {
            fail();
        }
        resolve_type_layout(operand_type);
        if (arena_read(operand_type, FIELD_C_SLOT) == ARRAY_LENGTH_256) {
            fail();
        }
        result.known = 1;
        result.value = arena_read(operand_type, FIELD_C_PAGE);
        return result;
    }
    if (kind == NODE_UNARY_EXPRESSION) {
        result = evaluate_constant_expression(node_a(expression));
        if (!result.known) {
            return result;
        }
        cell operator = node_tag(expression);
        if (operator == AST_UNARY_NEGATE) {
            result.value = 0 - result.value;
        } else if (operator == AST_UNARY_NOT) {
            result.value = result.value == 0;
        }
        return result;
    }
    if (kind == NODE_BINARY_EXPRESSION) {
        ConstantValue left = evaluate_constant_expression(node_a(expression));
        if (!left.known) {
            return result;
        }
        cell operator = node_tag(expression);
        if (operator == AST_BINARY_LOGICAL_AND && left.value == 0) {
            result.known = 1;
            return result;
        }
        if (operator == AST_BINARY_LOGICAL_OR && left.value != 0) {
            result.known = 1;
            result.value = 1;
            return result;
        }
        ConstantValue right;
        if (binary_has_immediate(expression)) {
            right.known = 1;
            right.value = binary_immediate(expression);
        } else {
            right = evaluate_constant_expression(node_b(expression));
        }
        if (!right.known) {
            return result;
        }
        result.known = 1;
        if (operator == AST_BINARY_ADD) {
            result.value = left.value + right.value;
        } else if (operator == AST_BINARY_SUBTRACT) {
            result.value = left.value - right.value;
        } else if (operator == AST_BINARY_LESS) {
            result.value = left.value < right.value;
        } else if (operator == AST_BINARY_LESS_EQUAL) {
            result.value = left.value <= right.value;
        } else if (operator == AST_BINARY_GREATER) {
            result.value = left.value > right.value;
        } else if (operator == AST_BINARY_GREATER_EQUAL) {
            result.value = left.value >= right.value;
        } else if (operator == AST_BINARY_EQUAL) {
            result.value = left.value == right.value;
        } else if (operator == AST_BINARY_NOT_EQUAL) {
            result.value = left.value != right.value;
        } else if (operator == AST_BINARY_LOGICAL_AND
            || operator == AST_BINARY_LOGICAL_OR) {
            result.value = right.value != 0;
        } else {
            fail();
        }
        return result;
    }
    return result;
}

void resolve_type_layout(NodeId ty) {
    cell state = arena_read(ty, FIELD_B_PAGE);
    if (state == TYPE_STATE_DONE) {
        return;
    }
    if (state == TYPE_STATE_VISITING) {
        fail();
    }
    cell kind = node_tag(ty);
    if (kind == TYPE_UNRESOLVED) {
        fail();
    }
    arena_write(ty, FIELD_B_PAGE, TYPE_STATE_VISITING);
    if (kind == TYPE_CELL) {
        node_set_value(ty, 1);
    } else if (kind == TYPE_VOID) {
        node_set_value(ty, 0);
    } else if (kind == TYPE_ENUM) {
        NodeId variant = node_a(ty);
        if (node_is_null(variant)) {
            fail();
        }
        cell have_previous;
        cell previous;
        cell zero_count;
        while (!node_is_null(variant)) {
            NodeId earlier = node_a(ty);
            while (!node_equals(earlier, variant)) {
                if (node_equals(node_name(earlier), node_name(variant))) {
                    fail();
                }
                earlier = node_next(earlier);
            }
            cell value;
            if (!node_is_null(node_a(variant))) {
                ConstantValue constant = evaluate_constant_expression(node_a(variant));
                if (!constant.known) {
                    fail();
                }
                value = constant.value;
            } else if (!have_previous) {
                value = 0;
            } else {
                if (previous == 0xff) {
                    fail();
                }
                value = previous + 1;
            }
            earlier = node_a(ty);
            while (!node_equals(earlier, variant)) {
                if (node_value(earlier) == value) {
                    fail();
                }
                earlier = node_next(earlier);
            }
            node_set_value(variant, value);
            if (value == 0) {
                zero_count += 1;
            }
            previous = value;
            have_previous = 1;
            variant = node_next(variant);
        }
        if (zero_count != 1) {
            fail();
        }
        node_set_value(ty, 1);
    } else if (kind == TYPE_STRUCT) {
        NodeId field = node_a(ty);
        if (node_is_null(field)) {
            fail();
        }
        cell cells;
        while (!node_is_null(field)) {
            NodeId earlier = node_a(ty);
            while (!node_equals(earlier, field)) {
                if (node_equals(node_name(earlier), node_name(field))) {
                    fail();
                }
                earlier = node_next(earlier);
            }
            NodeId field_type = node_a(field);
            resolve_type_layout(field_type);
            node_set_value(field, cells);
            if (cells > 0xff - node_value(field_type)) {
                fail();
            }
            cells += node_value(field_type);
            field = node_next(field);
        }
        node_set_value(ty, cells);
    } else if (kind == TYPE_ARRAY) {
        NodeId element = node_a(ty);
        resolve_type_layout(element);
        cell element_cells = node_value(element);
        cell length = arena_read(ty, FIELD_C_PAGE);
        cell length_kind = arena_read(ty, FIELD_C_SLOT);
        if (length_kind == ARRAY_LENGTH_CONSTANT) {
            NodeId constant = find_constant_by_name_or_null(node_name(ty));
            if (node_is_null(constant)) {
                fail();
            }
            length = resolve_constant(constant);
            arena_write(ty, FIELD_C_PAGE, length);
            arena_write(ty, FIELD_C_SLOT, ARRAY_LENGTH_LITERAL);
            length_kind = ARRAY_LENGTH_LITERAL;
        }
        if (length_kind == ARRAY_LENGTH_256) {
            if (element_cells != 0) {
                fail();
            }
            node_set_value(ty, 0);
        } else {
            cell cells;
            cell index;
            while (index < length) {
                if (cells > 0xff - element_cells) {
                    fail();
                }
                cells += element_cells;
                index += 1;
            }
            node_set_value(ty, cells);
        }
    } else {
        fail();
    }
    arena_write(ty, FIELD_B_PAGE, TYPE_STATE_DONE);
}

cell expression_is_static_place(NodeId expression) {
    cell kind = node_kind(expression);
    return (kind == NODE_NAME_EXPRESSION || kind == NODE_INDEX_EXPRESSION
        || kind == NODE_FIELD_EXPRESSION)
        && (node_tag(expression) == RESOLVED_LOCAL
            || node_tag(expression) == RESOLVED_GLOBAL);
}

cell expression_is_dynamic_place(NodeId expression) {
    cell kind = node_kind(expression);
    return (kind == NODE_INDEX_EXPRESSION || kind == NODE_FIELD_EXPRESSION)
        && (node_tag(expression) == RESOLVED_LOCAL_DYNAMIC
            || node_tag(expression) == RESOLVED_GLOBAL_DYNAMIC);
}

NodeId find_struct_field(NodeId ty, NodeId name) {
    NodeId field = node_a(ty);
    while (!node_is_null(field)) {
        if (node_equals(node_name(field), name)) {
            return field;
        }
        field = node_next(field);
    }
    fail();
    return null_node();
}

NodeId analyze_ast_expression(NodeId expression) {
    cell kind = node_kind(expression);
    if (kind == NODE_LITERAL_EXPRESSION || kind == NODE_INPUT_EXPRESSION) {
        set_expression_type(expression, cell_type);
        return cell_type;
    }
    if (kind == NODE_STRING_EXPRESSION) {
        return expression_type(expression);
    }
    if (kind == NODE_LEN_EXPRESSION) {
        NodeId operand_type = analyze_ast_expression(node_a(expression));
        if (node_tag(operand_type) != TYPE_ARRAY
            || arena_read(operand_type, FIELD_C_SLOT) == ARRAY_LENGTH_256) {
            fail();
        }
        node_set_value(expression, arena_read(operand_type, FIELD_C_PAGE));
        set_expression_type(expression, cell_type);
        return cell_type;
    }
    if (kind == NODE_ENUM_EXPRESSION) {
        NodeId ty = find_named_type_or_null(node_name(expression));
        if (node_is_null(ty) || node_tag(ty) != TYPE_ENUM) {
            fail();
        }
        NodeId variant = node_a(ty);
        while (!node_is_null(variant)
            && !node_equals(node_name(variant), node_a(expression))) {
            variant = node_next(variant);
        }
        if (node_is_null(variant)) {
            fail();
        }
        node_set_value(expression, node_value(variant));
        set_expression_type(expression, ty);
        return ty;
    }
    if (kind == NODE_NAME_EXPRESSION) {
        NodeId ty;
        cell encoded_binding;
        if (node_tag(expression) != MACRO_DEFINITION_SITE_NAME) {
            encoded_binding = find_local_binding_or_zero(node_name(expression));
        }
        if (encoded_binding != 0) {
            cell binding = encoded_binding - 1;
            node_set_tag(expression, RESOLVED_LOCAL);
            node_set_value(expression, semantic_local_slots[binding]);
            ty = semantic_local_types[binding];
        } else {
            NodeId constant = find_constant_by_name_or_null(node_name(expression));
            if (!node_is_null(constant)) {
                node_set_tag(expression, RESOLVED_CONSTANT);
                node_set_value(expression, resolve_constant(constant));
                set_expression_type(expression, cell_type);
                return cell_type;
            }
            NodeId global = find_global_by_name_or_null(node_name(expression));
            if (node_is_null(global)) {
                fail();
            }
            node_set_tag(expression, RESOLVED_GLOBAL);
            node_set_value(expression, arena_read(global, FIELD_C_PAGE));
            ty = node_b(global);
        }
        set_expression_type(expression, ty);
        return ty;
    }
    if (kind == NODE_INDEX_EXPRESSION) {
        NodeId base_expression = node_a(expression);
        NodeId base_type = analyze_ast_expression(base_expression);
        if (node_tag(base_type) != TYPE_ARRAY) {
            fail();
        }
        NodeId index = node_b(expression);
        if (!types_equal(analyze_ast_expression(index), cell_type)) {
            fail();
        }
        cell length = arena_read(base_type, FIELD_C_PAGE);
        cell is_256 = arena_read(base_type, FIELD_C_SLOT);
        NodeId element_type = node_a(base_type);
        cell element_cells = node_value(element_type);
        ConstantValue constant = evaluate_constant_expression(index);
        if (constant.known && !is_256 && constant.value >= length) {
            fail();
        }
        if (constant.known) {
            cell offset;
            cell count = constant.value;
            while (count != 0) {
                if (offset > 0xff - element_cells) {
                    fail();
                }
                offset += element_cells;
                count -= 1;
            }
            if (expression_is_static_place(base_expression)) {
                node_set_tag(expression, node_tag(base_expression));
                if (node_value(base_expression) > 0xff - offset) {
                    fail();
                }
                node_set_value(expression, node_value(base_expression) + offset);
            } else if (expression_is_dynamic_place(base_expression)) {
                node_set_tag(expression, node_tag(base_expression));
                node_set_value(expression, node_value(base_expression));
                arena_write(expression, FIELD_C_PAGE, offset);
                arena_write(expression, FIELD_C_SLOT,
                    DYNAMIC_PROJECTION_CONSTANT);
            } else {
                node_set_tag(expression, RESOLVED_VALUE_PROJECT);
                node_set_value(expression, offset);
            }
        } else {
            if (is_256 || element_cells == 0) {
                fail();
            }
            cell storage = node_tag(base_expression);
            if (expression_is_static_place(base_expression)
                && storage == RESOLVED_LOCAL) {
                node_set_tag(expression, RESOLVED_LOCAL_DYNAMIC);
            } else if (expression_is_static_place(base_expression)
                && storage == RESOLVED_GLOBAL) {
                node_set_tag(expression, RESOLVED_GLOBAL_DYNAMIC);
            } else if (expression_is_dynamic_place(base_expression)) {
                node_set_tag(expression, storage);
            } else {
                fail();
            }
            node_set_value(expression, node_value(base_expression));
            arena_write(expression, FIELD_C_PAGE, element_cells);
            arena_write(expression, FIELD_C_SLOT, DYNAMIC_PROJECTION_INDEX);
        }
        set_expression_type(expression, element_type);
        return element_type;
    }
    if (kind == NODE_FIELD_EXPRESSION) {
        NodeId base_expression = node_a(expression);
        NodeId base_type = analyze_ast_expression(base_expression);
        if (node_tag(base_type) != TYPE_STRUCT) {
            fail();
        }
        NodeId field = find_struct_field(base_type, node_name(expression));
        cell offset = node_value(field);
        if (expression_is_static_place(base_expression)) {
            node_set_tag(expression, node_tag(base_expression));
            if (node_value(base_expression) > 0xff - offset) {
                fail();
            }
            node_set_value(expression, node_value(base_expression) + offset);
        } else if (expression_is_dynamic_place(base_expression)) {
            node_set_tag(expression, node_tag(base_expression));
            node_set_value(expression, node_value(base_expression));
            arena_write(expression, FIELD_C_PAGE, offset);
            arena_write(expression, FIELD_C_SLOT,
                DYNAMIC_PROJECTION_CONSTANT);
        } else {
            node_set_tag(expression, RESOLVED_VALUE_PROJECT);
            node_set_value(expression, offset);
        }
        NodeId ty = node_a(field);
        set_expression_type(expression, ty);
        return ty;
    }
    if (kind == NODE_UNARY_EXPRESSION) {
        if (!types_equal(analyze_ast_expression(node_a(expression)), cell_type)) {
            fail();
        }
        set_expression_type(expression, cell_type);
        return cell_type;
    }
    if (kind == NODE_BINARY_EXPRESSION) {
        NodeId left = analyze_ast_expression(node_a(expression));
        NodeId right = cell_type;
        if (!binary_has_immediate(expression)) {
            right = analyze_ast_expression(node_b(expression));
        }
        cell operator = node_tag(expression);
        if (operator == AST_BINARY_EQUAL || operator == AST_BINARY_NOT_EQUAL) {
            if (!types_equal(left, right)
                || (!types_equal(left, cell_type) && node_tag(left) != TYPE_ENUM)) {
                fail();
            }
        } else if (!types_equal(left, cell_type)
            || !types_equal(right, cell_type)) {
            fail();
        }
        set_expression_type(expression, cell_type);
        return cell_type;
    }
    if (kind == NODE_CALL_EXPRESSION) {
        NodeId function = find_function_by_name(node_name(expression));
        if (node_equals(function, main_function)) {
            fail();
        }
        node_set_b(expression, function);
        NodeId argument = node_a(expression);
        NodeId parameter = node_a(function);
        while (!node_is_null(argument) && !node_is_null(parameter)) {
            if (!types_equal(analyze_ast_expression(argument), node_b(parameter))) {
                fail();
            }
            argument = node_next(argument);
            parameter = node_next(parameter);
        }
        if (!node_is_null(argument) || !node_is_null(parameter)) {
            fail();
        }
        NodeId ty = node_name(node_c(function));
        set_expression_type(expression, ty);
        return ty;
    }
    fail();
    return void_type;
}

cell analyze_ast_statement(NodeId statement) {
    cell kind = node_kind(statement);
    if (kind == NODE_EMPTY_STATEMENT) {
        return 0;
    }
    if (kind == NODE_ABORT_STATEMENT) {
        return 1;
    }
    if (kind == NODE_BLOCK) {
        enter_semantic_scope();
        cell guaranteed;
        NodeId child = node_a(statement);
        while (!node_is_null(child)) {
            if (analyze_ast_statement(child)) {
                guaranteed = 1;
            }
            child = node_next(child);
        }
        leave_semantic_scope();
        return guaranteed;
    }
    if (kind == NODE_DECLARATION) {
        NodeId ty = node_b(statement);
        NodeId initializer = node_a(statement);
        if (node_equals(ty, inferred_type)) {
            if (node_is_null(initializer)
                || node_kind(initializer) != NODE_STRING_EXPRESSION) {
                fail();
            }
            ty = expression_type(initializer);
            node_set_b(statement, ty);
        }
        if (!node_is_null(initializer)
            && !types_equal(analyze_ast_expression(initializer), ty)) {
            fail();
        }
        node_set_tag(statement, type_is_aggregate(ty));
        node_set_value(statement, node_value(ty));
        arena_write(statement, FIELD_C_PAGE,
            add_semantic_local(node_name(statement), ty));
        return 0;
    }
    if (kind == NODE_OUTPUT_STATEMENT) {
        if (!types_equal(analyze_ast_expression(node_a(statement)), cell_type)) {
            fail();
        }
        return 0;
    }
    if (kind == NODE_ASSIGNMENT) {
        NodeId value_type = analyze_ast_expression(node_b(statement));
        NodeId target_type = analyze_ast_expression(node_a(statement));
        if (node_tag(node_a(statement)) == RESOLVED_VALUE_PROJECT
            || node_tag(node_a(statement)) == RESOLVED_CONSTANT) {
            fail();
        }
        if (!types_equal(value_type, target_type)) {
            fail();
        }
        if ((type_is_aggregate(target_type) || node_tag(target_type) == TYPE_ENUM)
            && node_tag(statement) != AST_ASSIGNMENT_SET) {
            fail();
        }
        return 0;
    }
    if (kind == NODE_CALL_STATEMENT) {
        if (!types_equal(analyze_ast_expression(node_a(statement)), void_type)) {
            fail();
        }
        return 0;
    }
    if (kind == NODE_RETURN_STATEMENT) {
        NodeId expected = node_name(node_c(semantic_current_function));
        NodeId value = node_a(statement);
        if (types_equal(expected, void_type)) {
            if (!node_is_null(value)) {
                fail();
            }
        } else if (node_is_null(value)
            || !types_equal(analyze_ast_expression(value), expected)) {
            fail();
        }
        return 1;
    }
    if (kind == NODE_IF_STATEMENT) {
        if (!types_equal(analyze_ast_expression(node_a(statement)), cell_type)) {
            fail();
        }
        cell then_returns = analyze_ast_statement(node_b(statement));
        NodeId otherwise = node_c(statement);
        if (node_is_null(otherwise)) {
            return 0;
        }
        return then_returns && analyze_ast_statement(otherwise);
    }
    if (kind == NODE_WHILE_STATEMENT) {
        if (!types_equal(analyze_ast_expression(node_a(statement)), cell_type)) {
            fail();
        }
        cell body_returns = analyze_ast_statement(node_b(statement));
        return 0;
    }
    fail();
    return 0;
}

void collect_file_declarations() {
    NodeId global = first_global;
    while (!node_is_null(global)) {
        if (node_equals(node_b(global), inferred_type)) {
            if (node_is_null(node_a(global))
                || node_kind(node_a(global)) != NODE_STRING_EXPRESSION) {
                fail();
            }
            node_set_b(global, expression_type(node_a(global)));
        }
        global = node_next(global);
    }

    NodeId constant = first_constant;
    while (!node_is_null(constant)) {
        NodeId earlier_constant = first_constant;
        while (!node_equals(earlier_constant, constant)) {
            if (node_equals(node_name(earlier_constant), node_name(constant))) {
                fail();
            }
            earlier_constant = node_next(earlier_constant);
        }
        NodeId conflict_type = first_type;
        while (!node_is_null(conflict_type)) {
            if (node_tag(conflict_type) != TYPE_ARRAY
                && !node_is_null(node_name(conflict_type))
                && node_equals(node_name(conflict_type), node_name(constant))) {
                fail();
            }
            conflict_type = node_next(conflict_type);
        }
        global = first_global;
        while (!node_is_null(global)) {
            if (node_equals(node_name(global), node_name(constant))) {
                fail();
            }
            global = node_next(global);
        }
        NodeId conflict_function = first_function;
        while (!node_is_null(conflict_function)) {
            if (node_equals(node_name(conflict_function), node_name(constant))) {
                fail();
            }
            conflict_function = node_next(conflict_function);
        }
        cell constant_value = resolve_constant(constant);
        constant = node_next(constant);
    }

    NodeId ty = first_type;
    while (!node_is_null(ty)) {
        resolve_type_layout(ty);
        ty = node_next(ty);
    }

    stage7_static_cells = 0;
    global = first_global;
    while (!node_is_null(global)) {
        NodeId earlier_global = first_global;
        while (!node_equals(earlier_global, global)) {
            if (node_equals(node_name(earlier_global), node_name(global))) {
                fail();
            }
            earlier_global = node_next(earlier_global);
        }
        ty = node_b(global);
        NodeId named_type = first_type;
        while (!node_is_null(named_type)) {
            if (node_tag(named_type) != TYPE_ARRAY
                && !node_is_null(node_name(named_type))
                && node_equals(node_name(named_type), node_name(global))) {
                fail();
            }
            named_type = node_next(named_type);
        }
        cell cells = node_value(ty);
        if (stage7_static_cells > 0xff - cells) {
            fail();
        }
        node_set_tag(global, type_is_aggregate(ty));
        node_set_value(global, cells);
        arena_write(global, FIELD_C_PAGE, stage7_static_cells);
        stage7_static_cells += cells;
        global = node_next(global);
    }

    function_count = 0;
    main_function = null_node();
    NodeId function = first_function;
    while (!node_is_null(function)) {
        global = first_global;
        while (!node_is_null(global)) {
            if (node_equals(node_name(global), node_name(function))) {
                fail();
            }
            global = node_next(global);
        }
        NodeId earlier = first_function;
        while (!node_equals(earlier, function)) {
            if (node_equals(node_name(earlier), node_name(function))) {
                fail();
            }
            earlier = node_next(earlier);
        }
        ty = first_type;
        while (!node_is_null(ty)) {
            if (node_tag(ty) != TYPE_ARRAY && !node_is_null(node_name(ty))
                && node_equals(node_name(ty), node_name(function))) {
                fail();
            }
            ty = node_next(ty);
        }
        if (function_count == 0xff) {
            fail();
        }
        node_set_value(function, function_count);
        function_count += 1;

        NodeId return_type = node_c(function);
        node_set_tag(function, parser_type_class(return_type));
        NodeId descriptor = allocate_node(NODE_FUNCTION_DESCRIPTOR);
        node_set_name(descriptor, return_type);
        node_set_c(function, descriptor);
        arena_write(descriptor, FIELD_B_PAGE, node_value(return_type));
        NodeId parameter = node_a(function);
        cell parameter_count;
        while (!node_is_null(parameter)) {
            NodeId parameter_type = node_b(parameter);
            node_set_tag(parameter, type_is_aggregate(parameter_type));
            node_set_value(parameter, node_value(parameter_type));
            parameter_count += 1;
            parameter = node_next(parameter);
        }
        node_set_tag(descriptor, parameter_count);

        NodeId name = node_name(function);
        if (node_value(name) == 4) {
            NodeId byte = node_a(name);
            if (arena_cell_read(byte) == 'm') {
                byte = arena_advance(byte, 1);
                if (arena_cell_read(byte) == 'a') {
                    byte = arena_advance(byte, 1);
                    if (arena_cell_read(byte) == 'i') {
                        byte = arena_advance(byte, 1);
                        if (arena_cell_read(byte) == 'n') {
                            if (!node_is_null(main_function)) {
                                fail();
                            }
                            main_function = function;
                        }
                    }
                }
            }
        }
        function = node_next(function);
    }
    if (node_is_null(main_function)
        || !types_equal(node_name(node_c(main_function)), void_type)
        || node_tag(node_c(main_function)) != 0) {
        fail();
    }
}

void analyze_ast_program() {
    collect_file_declarations();
    semantic_local_count = 0;
    semantic_next_slot = 0;
    semantic_scope_depth = 0;
    semantic_current_function = main_function;
    NodeId global = first_global;
    while (!node_is_null(global)) {
        if (!node_is_null(node_a(global))
            && !types_equal(analyze_ast_expression(node_a(global)), node_b(global))) {
            fail();
        }
        global = node_next(global);
    }
    NodeId function = first_function;
    while (!node_is_null(function)) {
        semantic_current_function = function;
        semantic_local_count = 0;
        semantic_next_slot = 0;
        semantic_max_local_count = 0;
        semantic_scope_depth = 0;
        enter_semantic_scope();
        NodeId parameter = node_a(function);
        while (!node_is_null(parameter)) {
            arena_write(parameter, FIELD_C_PAGE,
                add_semantic_local(node_name(parameter), node_b(parameter)));
            parameter = node_next(parameter);
        }
        cell returns = analyze_ast_statement(node_b(function));
        if (!types_equal(node_name(node_c(function)), void_type) && !returns) {
            fail();
        }
        node_set_value(node_c(function), semantic_max_local_count);
        leave_semantic_scope();
        function = node_next(function);
    }
}
