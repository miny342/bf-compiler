cell helper(cell value, cell mod) {
    cell tmp;
    cell value_tmp = value;
    while (value_tmp > 0) {
        tmp = mod;
        while (tmp > 0 && value_tmp > 0) {
            tmp -= 1;
            value_tmp -= 1;
        }
        if (value_tmp == 0 && tmp == 0) {
            return 1;
        }
    }
    return 0;
}

void output_to_num(cell value) {
    cell cnt;
    while (value >= 100) {
        value -= 100;
        cnt += 1;
    }
    if (cnt > 0) {
        output(cnt + '0');
    }
    cnt = 0;
    while (value >= 10) {
        value -= 10;
        cnt += 1;
    }
    if (cnt > 0) {
        output(cnt + '0');
    }
    output(value + '0');
}

void main() {
cell f = 'f';
cell i = 'i';
cell z = 'z';
cell b = 'b';
cell u = 'u';
cell nn = '\n';

cell max_counter = 100;
cell now = 0;

while (max_counter != 0) {
    max_counter -= 1;
    now += 1;

    // 3で割った余りを計算
    cell mod_3_is_0 = helper(now, 3);

    // 5で割った余りを計算
    cell mod_5_is_0 = helper(now, 5);

    if (mod_3_is_0 != 0) {
        if (mod_5_is_0 != 0) {
            output(f);
            output(i);
            output(z);
            output(z);
            output(b);
            output(u);
            output(z);
            output(z);
        } else {
            output(f);
            output(i);
            output(z);
            output(z);
        }
    } else {
        if (mod_5_is_0 != 0) {
            output(b);
            output(u);
            output(z);
            output(z);
        } else {
            output_to_num(now);
        }
    }

    output(nn);
}
}
